                "badge_text": "BPA | PHTHALATES",
                "title": "Silicone",
                "text": "While high-end silicone spatulas are heat-resistant, most found on Amazon or in regular stores degrade over time and release toxic chemicals. Cheaper silicone spatulas often contain dangerous fillers like BPA and phthalates, becoming toxic when heated."
              },
              "blocks": {}
            },
            "material_card_Wk9Vt8": {
              "type": "_material-card",
              "settings": {

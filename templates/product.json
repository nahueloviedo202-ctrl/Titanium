                "badge_text": "BACTERIA | MOLD",
                "title": "Wood",
                "text": "Not hygienic. It lets bacteria grow in grooves and cracks, even if invisible, which can contaminate your food over time. They also absorb odors, stain easily."
              },
              "blocks": {}
            },
            "material_card_jq48Aq": {
              "type": "_material-card",
              "settings": {
                "image": "shopify://shop_images/steel_spatula-min.webp",
                "badge_text": "HEAVY METALS",

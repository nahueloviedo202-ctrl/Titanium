              "blocks": {
                "text_IwcPTZ": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Stone and granite cubes don't dilute drinks but are porous, hard to clean thoroughly, and can chip over time.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",

              "block_order": [
                "text_0b2HrG"
              ]
            },
            "accordion_row_8guSjr": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Is Titanium Hypoallergenic?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_7EEhSV": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes. Titanium is one of the most hypoallergenic metals available, which is why it's used in medical implants and jewelry for people with sensitive skin or metal allergies.</p>",

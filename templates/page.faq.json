        "faq_category_1vRWug": {
          "type": "_faq-category",
          "settings": {
            "heading": "Regular Drinkware",
            "heading_color": "#bca588",
            "icon": "plus",
            "dividers": true,
            "type_preset": "h6"
          },
          "blocks": {
            "accordion_row_E7vCIj": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Downsides Of Plastic Water Bottles",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_DEbDRj": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Plastic bottles can leach microplastics and chemicals, especially when exposed to heat or sunlight, and tend to retain odors and flavors.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_DEbDRj"
              ]
            },
            "accordion_row_xbkQkS": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Downsides Of Steel Water Bottles",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_aegQNf": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Standard steel bottles can develop a metallic taste over time and are prone to denting.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",

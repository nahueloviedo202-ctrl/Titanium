                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_R66rma": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Rather than relying on a chemical coating, our cookware uses titanium's naturally smooth, non-porous surface, which resists sticking without needing PTFE or similar coatings.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",

                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_0b2HrG": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes. The pure titanium used in our products meets food-contact safety standards, confirming it's safe for direct and repeated contact with food.</p>",

            "accordion_row_zpZACC": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Is Titanium Environmentally Friendly?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_VgLuqY": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Titanium is fully recyclable and, because it lasts a lifetime, it reduces the cycle of replacing worn-out coated pans, cracked boards and single-use plastics.</p>",

              "block_order": [
                "text_pFWT45"
              ]
            },
            "accordion_row_7qUPVG": {
              "type": "_accordion-row",
              "settings": {
                "heading": "How Does Titanium Compare To Regular Cookware?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_lt9YD3": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Titanium cookware combines the durability of stainless steel with a naturally smooth cooking surface, without coatings that wear off or metals that react with food.</p>",

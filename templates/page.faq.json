                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_aegQNf"
              ]
            },
            "accordion_row_9mRkkK": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Downsides Of Aluminum Water Bottles",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_CtMRhE": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Aluminum is lightweight but reactive, so bottles typically require an internal liner that can wear down and expose the metal underneath.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",

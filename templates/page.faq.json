                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_CtMRhE"
              ]
            },
            "accordion_row_6NWl8u": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Downsides Of Glass Water Bottles",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_s1AIFo": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Glass doesn't affect taste but is heavy and breaks easily if dropped.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_s1AIFo"
              ]
            },
            "accordion_row_FWI9Et": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Downsides Of Plastic Ice Cubes",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_nlrsmT": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Reusable plastic ice cubes can absorb odors and, over time, may leach microplastics into your drink.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_nlrsmT"
              ]
            },
            "accordion_row_cGhDXM": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Downsides Of Steel Ice Cubes",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_KkH04d": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Steel ice cubes are durable but conduct heat quickly, so they warm up and stop chilling drinks faster than denser materials.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_KkH04d"
              ]
            },
            "accordion_row_9ebx8l": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Downsides Of Regular Ice Cubes",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_yOVZEu": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Regular ice melts quickly, dilutes your drink, and can carry impurities depending on your water source.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",

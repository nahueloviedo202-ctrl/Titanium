    "faq_page_4rgigc": {
      "type": "faq-page",
      "blocks": {
        "faq_category_kg4ruq": {
          "type": "_faq-category",
          "settings": {
            "heading": "About Us",
            "heading_color": "#bca588",
            "icon": "plus",
            "dividers": true,
            "type_preset": "h6"
          },
          "blocks": {
            "accordion_row_gJDOR9": {
              "type": "_accordion-row",
              "settings": {
                "heading": "What Makes Titanium Products Different?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_spWPG3": {
                  "type": "text",
                  "settings": {
                    "text": "<p>We don't sell traditional cookware. Every piece we make is crafted from certified pure titanium — the same material trusted in surgery, aerospace and dentistry — instead of coatings, plastics or alloys that wear out or leach into food.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_spWPG3"
              ]
            },
            "accordion_row_00bR0C": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Where Does The Titanium Name Come From?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_v7xHUo": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Our name is a direct nod to the material at the heart of everything we make. We chose titanium because it's the safest, most durable metal available for kitchenware, and we wanted our name to say exactly what's inside every product.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_v7xHUo"
              ]
            },
            "accordion_row_DQfvQg": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Where Are Titanium Products Made?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_Ajior0": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Our products are manufactured in specialized facilities that work exclusively with pure titanium, under strict quality control at every stage — from raw material sourcing to final polishing.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_Ajior0"
              ]
            },
            "accordion_row_yOza4I": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Do Titanium Products Come With A Warranty?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_0RBeBJ": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes. Every item comes with a warranty against manufacturing defects. If something isn't right, our support team will make it right.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_0RBeBJ"
              ]
            },
            "accordion_row_6OUmtk": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Why Do Customers Love Titanium?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_ylmFQE": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Customers switch to titanium once and rarely go back — it's non-toxic, virtually indestructible, and performs better than the pans, boards and bottles it replaces.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_ylmFQE"
              ]
            },
            "accordion_row_38OyNa": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Is All Titanium The Same?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_EBJWh9": {
                  "type": "text",
                  "settings": {
                    "text": "<p>No. Titanium comes in different grades and purities, and some \"titanium\" products on the market are only coated or plated. We use certified pure, food-grade titanium in every product, not a thin surface layer.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_EBJWh9"
              ]
            },
            "accordion_row_aXWnZB": {
              "type": "_accordion-row",
              "settings": {
                "heading": "What Impact Does My Purchase Have?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_uazKqg": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Choosing pure titanium means fewer disposable, coated or plastic products ending up in landfill — titanium kitchenware is built to last a lifetime, not to be replaced every year.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_uazKqg"
              ]
            }
          },
          "block_order": [
            "accordion_row_gJDOR9",
            "accordion_row_00bR0C",
            "accordion_row_DQfvQg",
            "accordion_row_yOza4I",
            "accordion_row_6OUmtk",
            "accordion_row_38OyNa",
            "accordion_row_aXWnZB"
          ]
        },
        "faq_category_vmeZOA": {
          "type": "_faq-category",
          "settings": {
            "heading": "About Pure Titanium",
            "heading_color": "#bca588",
            "icon": "plus",
            "dividers": true,
            "type_preset": "h6"
          },
          "blocks": {
            "accordion_row_UhR9zk": {
              "type": "_accordion-row",
              "settings": {
                "heading": "What Is Titanium & Why Does It Matter For My Safety?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_G7kkHF": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Titanium is a naturally occurring metal known for being completely biocompatible — meaning your body doesn't react to it. It's the same material used in surgical implants, which is why it's considered one of the safest materials to cook and eat from.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_G7kkHF"
              ]
            },
            "accordion_row_zpcwn1": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Why Titanium Instead Of Wood, Plastic Or Non-Stick?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_UHcE4V": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Wood and plastic absorb bacteria and odors over time, and non-stick coatings can degrade and release particles when scratched or overheated. Titanium does none of that — it's non-porous, scratch-resistant and stable at high heat.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_UHcE4V"
              ]
            },
            "accordion_row_rfEFhb": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Is Titanium Safe For Food Contact?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_6B66lm": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes. Pure titanium is inert, meaning it doesn't react with food, acids or heat. It won't leach metals or chemicals into what you cook or store.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_6B66lm"
              ]
            },
            "accordion_row_gcgONF": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Is Titanium Completely Toxin-Free?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_U9nOrR": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Titanium doesn't contain PFAS, PTFE, lead, cadmium or the coatings found in traditional non-stick and plastic products, making it one of the few truly toxin-free materials for the kitchen.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_U9nOrR"
              ]
            },
            "accordion_row_r2PDhv": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Titanium Antibacterial Properties Explained",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_nOv6KB": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Titanium's non-porous surface gives bacteria nowhere to embed and grow, unlike wood or plastic, which develop microscopic grooves over time that trap moisture and bacteria.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_nOv6KB"
              ]
            },
            "accordion_row_PLbOvQ": {
              "type": "_accordion-row",
              "settings": {
                "heading": "What Does \"Biocompatible\" Mean?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_DMVCyA": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Biocompatible means a material can be in direct, prolonged contact with the human body without causing a reaction. It's the standard used for surgical implants — and it's why titanium is considered so safe in the kitchen.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_DMVCyA"
              ]
            },
            "accordion_row_2ErMwT": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Does It Have Heavy Metals? Does It Corrode?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_Xiaqsp": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Pure titanium contains no lead, cadmium or other heavy metals, and it forms a natural oxide layer that makes it highly resistant to corrosion and rust, even after years of daily use.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_Xiaqsp"
              ]
            },
            "accordion_row_ZTlx4Y": {
              "type": "_accordion-row",
              "settings": {
                "heading": "How Long Do Pure Titanium Products Last?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_DE3ij3": {
                  "type": "text",
                  "settings": {
                    "text": "<p>With proper care, pure titanium products can last a lifetime. Titanium doesn't rust, warp, corrode or degrade the way most kitchen materials eventually do.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_DE3ij3"
              ]
            },
            "accordion_row_zz1DYY": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Are Titanium Products Dishwasher Safe?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_Cdqm0p": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes. Titanium's non-porous surface holds up well to dishwasher detergents and heat, though hand washing will keep the finish looking newer for longer.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_Cdqm0p"
              ]
            },
            "accordion_row_pByjTK": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Will Titanium Damage My Knives Or Cooking Tools?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_KBLrEK": {
                  "type": "text",
                  "settings": {
                    "text": "<p>No. Titanium is a hard but smooth material, and our cutting boards and cookware are finished to be gentle on knife edges and metal utensils alike.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_KBLrEK"
              ]
            },
            "accordion_row_qIKAJ0": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Are There Any Downsides To Pure Titanium Kitchenware?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_uVXqXm": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Titanium products typically cost more upfront than plastic, wood or coated alternatives. That cost reflects the material and manufacturing — and it's offset by a product that doesn't need replacing.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",

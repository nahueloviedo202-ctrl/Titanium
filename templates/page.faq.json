                }
              },
              "block_order": [
                "text_R66rma"
              ]
            },
            "accordion_row_g0WMcE": {
              "type": "_accordion-row",
              "settings": {
                "heading": "How Does Titanium Cookware Help Food Retain More Nutrients?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_caJLWS": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Titanium heats evenly and doesn't react with food, which allows for gentler, more controlled cooking that can help preserve more of food's natural nutrients compared to prolonged high-heat cooking in reactive pans.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_caJLWS"
              ]
            },
            "accordion_row_OFL0AN": {
              "type": "_accordion-row",
              "settings": {
                "heading": "What Studies Show That Pure Titanium Cookware Retains More Nutrients?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_5azbuu": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Nutrient retention during cooking is influenced primarily by cooking temperature, time and the presence of reactive metals — titanium's inert, even-heating surface supports gentler cooking conditions that are generally associated with better nutrient preservation.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_5azbuu"
              ]
            },
            "accordion_row_Q4zuhn": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Why Should I Switch From My Existing Pan?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_g2u0zR": {
                  "type": "text",
                  "settings": {
                    "text": "<p>If your current pan is coated, it will eventually wear out. Titanium cookware is built to perform the same on day one and after ten years of daily cooking.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_g2u0zR"
              ]
            },
            "accordion_row_LQK55K": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Is Titanium Safe For Food Contact?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_hBcMq0": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes. Titanium is inert and won't leach metals or chemicals into your food, even during acidic or high-heat cooking.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_hBcMq0"
              ]
            },
            "accordion_row_vrCKE4": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Why Do Acidic Foods Cause Problems In Other Pans?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_uX51jV": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Acidic ingredients like tomatoes or citrus can react with reactive metals, altering flavor and, in coated pans, accelerating coating breakdown. Titanium doesn't react with acidic foods.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_uX51jV"
              ]
            },
            "accordion_row_3A1uvy": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Is It Safe To Use On All Stovetops And Ovens?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_gdlrou": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Titanium cookware works on gas, electric and most ceramic stovetops, and can go into the oven at high temperatures without damage. Check the specific product page for induction compatibility.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_gdlrou"
              ]
            },
            "accordion_row_7vx4zL": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Can I Cook At Very High Temperatures With Titanium?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_nW7i9F": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes. Titanium has a very high heat tolerance and remains stable well beyond the temperatures most home cooking requires.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_nW7i9F"
              ]
            },
            "accordion_row_V6UnBM": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Does Titanium Discolor With Heat?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_0Z7mNb": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Titanium is highly heat-stable and resistant to discoloration, holding its finish far better than aluminum or stainless steel under high heat.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_0Z7mNb"
              ]
            },
            "accordion_row_PewIaN": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Do I Need To Hand Wash Or Can I Use The Dishwasher?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_Jzml2h": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Titanium cookware is dishwasher safe, though hand washing with mild soap will help maintain the surface finish over time.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_Jzml2h"
              ]
            },
            "accordion_row_3GJquu": {
              "type": "_accordion-row",
              "settings": {
                "heading": "How Hot Do My Pans Need To Be To Start Cooking?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_ifjkxV": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Preheat on medium heat for a couple of minutes before adding food — titanium's even heat distribution means you rarely need high heat to cook effectively.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_ifjkxV"
              ]
            },
            "accordion_row_msaWRu": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Do I Need Butter, Oil, Or Cooking Spray When Cooking?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_dRNdFc": {
                  "type": "text",
                  "settings": {
                    "text": "<p>A small amount of oil or butter is recommended for flavor and best results, though titanium's naturally smooth surface requires far less than traditional pans.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_dRNdFc"
              ]
            },
            "accordion_row_GLs4c6": {
              "type": "_accordion-row",
              "settings": {
                "heading": "What Is Multi-Ply Titanium Construction?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_AwiRZw": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Multi-ply construction bonds layers of titanium and other metals together for optimal heat distribution and structural strength, combining performance with titanium's safety benefits.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_AwiRZw"
              ]
            },
            "accordion_row_Uf4Yfq": {
              "type": "_accordion-row",
              "settings": {
                "heading": "What Can I Cook With It?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_ktgLJ9": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Titanium cookware handles everything from delicate eggs and fish to searing meat and simmering sauces, on the stovetop or in the oven.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_ktgLJ9"
              ]
            }
          },
          "block_order": [
            "accordion_row_fLK7Sa",
            "accordion_row_g0WMcE",
            "accordion_row_OFL0AN",
            "accordion_row_Q4zuhn",
            "accordion_row_LQK55K",
            "accordion_row_vrCKE4",
            "accordion_row_3A1uvy",
            "accordion_row_7vx4zL",
            "accordion_row_V6UnBM",
            "accordion_row_PewIaN",
            "accordion_row_3GJquu",
            "accordion_row_msaWRu",
            "accordion_row_GLs4c6",
            "accordion_row_Uf4Yfq"
          ]
        },
        "faq_category_IrcypD": {
          "type": "_faq-category",
          "settings": {
            "heading": "Regular Cutting Boards",
            "heading_color": "#bca588",
            "icon": "plus",
            "dividers": true,
            "type_preset": "h6"
          },
          "blocks": {
            "accordion_row_WHhg3c": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Downsides Of Plastic Cutting Boards",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_QgBoxO": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Plastic boards develop deep knife grooves that trap bacteria over time and can shed microplastic particles into food.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_QgBoxO"
              ]
            },
            "accordion_row_zNy4RQ": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Downsides Of Wooden Cutting Boards",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_q7ECqC": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Wood is porous, absorbs moisture and odors, and requires regular oiling and careful drying to avoid warping or harboring bacteria.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_q7ECqC"
              ]
            },
            "accordion_row_DnBBiT": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Downsides Of Endgrain Wood Cutting Boards",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_Hd9tcz": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Endgrain boards are gentler on knives but still porous, heavy, and need consistent maintenance to stay sanitary and crack-free.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_Hd9tcz"
              ]
            },
            "accordion_row_xdPueH": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Downsides Of Bamboo Cutting Boards",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_8LHFlc": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Bamboo is harder than wood, which can dull knives faster, and it's still porous enough to absorb liquids and odors over time.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_8LHFlc"
              ]
            },
            "accordion_row_O0Uh34": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Downsides Of Glass Cutting Boards",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_8IsRbB": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Glass boards are extremely hard on knife edges and can crack or shatter if dropped.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_8IsRbB"
              ]
            },
            "accordion_row_se4vQk": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Downsides Of Stone Cutting Boards",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_b5cGYM": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Stone boards are heavy, can be porous depending on the material, and are just as hard on knife edges as glass.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_b5cGYM"
              ]
            },
            "accordion_row_48V7d2": {
              "type": "_accordion-row",
              "settings": {
                "heading": "How Does Titanium Compare To Regular Boards?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_KV7LWG": {
                  "type": "text",
                  "settings": {
                    "text": "<p>A titanium board combines a non-porous, antibacterial surface with a finish designed to be knife-friendly — solving the durability, hygiene and maintenance issues of wood, plastic, glass and stone.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_KV7LWG"
              ]
            }
          },
          "block_order": [
            "accordion_row_WHhg3c",
            "accordion_row_zNy4RQ",
            "accordion_row_DnBBiT",
            "accordion_row_xdPueH",
            "accordion_row_O0Uh34",
            "accordion_row_se4vQk",
            "accordion_row_48V7d2"
          ]
        },
        "faq_category_vemsIu": {
          "type": "_faq-category",
          "settings": {
            "heading": "Pure Titanium Cutting Board",
            "heading_color": "#bca588",
            "icon": "plus",
            "dividers": true,
            "type_preset": "h6"
          },
          "blocks": {
            "accordion_row_2KEGZg": {
              "type": "_accordion-row",
              "settings": {
                "heading": "How Do I Know This Is Real Titanium And Not A Fake?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_jvU4DN": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Genuine titanium has a distinct weight, a matte metallic finish, and doesn't rust or corrode. Look for products that specify certified pure titanium rather than a titanium-plated or coated surface.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_jvU4DN"
              ]
            },
            "accordion_row_EfXmAb": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Why Is Titanium The Safest Food Preparation Material?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_ASYvU1": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Titanium is non-porous and inert, so it doesn't absorb bacteria, moisture or odors the way wood and plastic do, and it won't shed microplastics like plastic boards.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_ASYvU1"
              ]
            },
            "accordion_row_ftUHxM": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Will Titanium Dull My Knives?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_ZWBEe9": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Our titanium boards are finished to be gentle on blade edges — comparable to a quality wood or endgrain board, and noticeably softer on knives than glass or stone.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_ZWBEe9"
              ]
            },
            "accordion_row_EEF3wt": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Do I Need To Sterilize It Like A Wooden Board?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_YqzJuy": {
                  "type": "text",
                  "settings": {
                    "text": "<p>No. Because the surface is non-porous, a simple wash with soap and water is enough to fully sanitize it — no oiling or special sterilizing routine required.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_YqzJuy"
              ]
            },
            "accordion_row_J1Drx4": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Is The Titanium Board Easy To Clean?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_SxvZ75": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes. It wipes clean easily and is dishwasher safe, with no risk of warping, cracking or absorbing stains and odors.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_SxvZ75"
              ]
            },
            "accordion_row_oejYnl": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Is The Titanium Board Third-Party Certified?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_yRG0RK": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Our titanium is tested and certified for purity and food-contact safety, so you can confirm it's the real material and not a coated imitation.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_yRG0RK"
              ]
            },
            "accordion_row_Og1rfL": {
              "type": "_accordion-row",
              "settings": {
                "heading": "What's It Like To Cut On This Titanium Board?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_AaxG4H": {
                  "type": "text",
                  "settings": {
                    "text": "<p>The surface offers a firm, stable cutting feel with a slight give that's kinder to your knife edge than glass or stone, while staying far more durable than wood or plastic.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_AaxG4H"
              ]
            },
            "accordion_row_MoaBY8": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Is A Titanium Cutting Board Really Antibacterial?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_BtFV5v": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Titanium's non-porous surface gives bacteria no grooves or pores to grow in, which is why it's naturally more hygienic than wood or plastic over repeated use.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_BtFV5v"
              ]
            },
            "accordion_row_i4eCdv": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Does It Eliminate Cross-Contamination Risk?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_w7l78G": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Because nothing can embed in the surface, thorough washing between uses fully removes residue — significantly reducing cross-contamination risk compared to grooved wood or plastic boards.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_w7l78G"
              ]
            }
          },
          "block_order": [
            "accordion_row_2KEGZg",
            "accordion_row_EfXmAb",
            "accordion_row_ftUHxM",
            "accordion_row_EEF3wt",
            "accordion_row_J1Drx4",
            "accordion_row_oejYnl",
            "accordion_row_Og1rfL",
            "accordion_row_MoaBY8",
            "accordion_row_i4eCdv"
          ]
        },
        "faq_category_wT67XR": {
          "type": "_faq-category",
          "settings": {
            "heading": "Regular Utensils",
            "heading_color": "#bca588",
            "icon": "plus",
            "dividers": true,
            "type_preset": "h6"
          },
          "blocks": {
            "accordion_row_Bvl6Ea": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Downsides Of Plastic Utensils",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_Ke24y2": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Plastic utensils can melt or warp near high heat and may leach chemicals into hot food over time.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_Ke24y2"
              ]
            },
            "accordion_row_ikL36z": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Downsides Of Silicone Utensils",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_i6zp9v": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Silicone is heat-resistant but can retain odors, stain over time, and lower-quality silicone may contain fillers.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_i6zp9v"
              ]
            },
            "accordion_row_ExfGV2": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Downsides Of Wooden Utensils",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_psaOR4": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Wood absorbs moisture and odors, can splinter with age, and requires regular oiling to avoid cracking.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_psaOR4"
              ]
            },
            "accordion_row_nLvMCS": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Downsides Of Steel Utensils",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_NQYIAR": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Standard steel utensils can scratch non-stick surfaces and, if not properly treated, may be prone to corrosion over time.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_NQYIAR"
              ]
            },
            "accordion_row_i2BIHH": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Downsides Of Carbon Steel Utensils",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_gQaMP8": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Carbon steel is strong but can rust if not dried immediately and thoroughly after washing.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_gQaMP8"
              ]
            }
          },
          "block_order": [
            "accordion_row_Bvl6Ea",
            "accordion_row_ikL36z",
            "accordion_row_ExfGV2",
            "accordion_row_nLvMCS",
            "accordion_row_i2BIHH"
          ]
        },
        "faq_category_eWIDMJ": {
          "type": "_faq-category",
          "settings": {
            "heading": "Pure Titanium Utensils",
            "heading_color": "#bca588",
            "icon": "plus",
            "dividers": true,
            "type_preset": "h6"
          },
          "blocks": {
            "accordion_row_FcJ6Hl": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Why Switch From Wood, Plastic, Or Silicone Utensils?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_ESPSUC": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Titanium utensils won't absorb odors, melt, splinter or degrade — they offer the durability of metal with a surface gentle enough for non-stick cookware.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_ESPSUC"
              ]
            },
            "accordion_row_onNT2i": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Can I Leave Titanium Utensils In The Pan Or Pot While Cooking?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_JZCnF0": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes. Titanium conducts heat slowly, so the handle stays cool enough to leave resting in the pan or pot while you cook.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_JZCnF0"
              ]
            },
            "accordion_row_9SuFx1": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Are Titanium Utensils Completely Toxin-Free?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_GgFeyN": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes. Titanium doesn't contain PFAS, BPA or the chemical fillers found in some plastic and silicone utensils.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_GgFeyN"
              ]
            },
            "accordion_row_Bv44TK": {
              "type": "_accordion-row",
              "settings": {
                "heading": "How Heavy Are They Compared To Steel Utensils?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_NMMFwd": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Titanium is significantly lighter than stainless steel while still being just as strong, so it feels comfortable during extended use.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",

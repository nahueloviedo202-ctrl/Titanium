        "faq_category_MuUnu1": {
          "type": "_faq-category",
          "settings": {
            "heading": "Regular Cookware",
            "heading_color": "#bca588",
            "icon": "plus",
            "dividers": true,
            "type_preset": "h6"
          },
          "blocks": {
            "accordion_row_n48e2J": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Downsides Of Non-Stick Coated Pans",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_CTTYEv": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Coated pans lose their non-stick surface over time, and scratches or overheating can cause the coating to flake or release particles into food.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_CTTYEv"
              ]
            },
            "accordion_row_d11w2A": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Downsides Of Stainless Steel Pans",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_U6wR2d": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Stainless steel is durable but food sticks easily without enough oil, and it can react with acidic foods over long cooking times.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_U6wR2d"
              ]
            },
            "accordion_row_cZAnsY": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Downsides Of Ceramic Pans",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_qv1HZj": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Ceramic coatings look great new but tend to lose their non-stick performance after just a few months of regular use.</p>",

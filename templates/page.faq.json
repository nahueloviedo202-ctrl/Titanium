                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_qv1HZj"
              ]
            },
            "accordion_row_2SF57z": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Downsides Of Cast Iron Pans",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_pFWT45": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Cast iron is heavy, requires ongoing seasoning to stay non-stick, and can rust if not dried and cared for properly.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",

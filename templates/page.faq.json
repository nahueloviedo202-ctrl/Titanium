        "faq_category_uaaiwD": {
          "type": "_faq-category",
          "settings": {
            "heading": "Pure Titanium Drinkware",
            "heading_color": "#bca588",
            "icon": "plus",
            "dividers": true,
            "type_preset": "h6"
          },
          "blocks": {
            "accordion_row_6kbO3I": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Why Is A Titanium Water Bottle Better Than Any Other?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_nzJemp": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Titanium won't leach chemicals or metallic taste into your water, resists denting far better than steel, and is significantly lighter to carry.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_nzJemp"
              ]
            },
            "accordion_row_BMVsGw": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Is It Safe For Both Hot And Cold Drinks?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_wfxcqa": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes. Titanium performs reliably across temperatures, from ice-cold water to hot coffee or tea, without affecting taste or safety.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_wfxcqa"
              ]
            },
            "accordion_row_CR3Uyw": {
              "type": "_accordion-row",
              "settings": {
                "heading": "How Heavy Is It Compared To Steel Bottles?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_iEXoIM": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Titanium bottles are noticeably lighter than stainless steel bottles of the same size, while matching their strength and durability.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_iEXoIM"
              ]
            },
            "accordion_row_wBcmMr": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Is It Really 100% Toxin-Free?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_HOfhB4": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes. Titanium contains no BPA, lead or the liners and coatings used in some metal and plastic bottles.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_HOfhB4"
              ]
            },
            "accordion_row_asRyRT": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Does The Bottle Retain Heat Or Cold Well?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_gxV6OM": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Insulated titanium bottles keep drinks cold or hot for extended periods, performing comparably to premium double-wall steel bottles.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_gxV6OM"
              ]
            },
            "accordion_row_pEWTXu": {
              "type": "_accordion-row",
              "settings": {
                "heading": "What Are Titanium Ice Cubes Made Of?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_qEvy8K": {
                  "type": "text",
                  "settings": {
                    "text": "<p>They're solid pure titanium, shaped and polished to chill drinks without ever melting, diluting or affecting flavor.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_qEvy8K"
              ]
            },
            "accordion_row_Zu9p1n": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Are Titanium Ice Cubes Corrosion Resistant?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_NEcXBI": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes. Titanium's natural oxide layer makes it fully resistant to corrosion, even with repeated freezing and washing.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_NEcXBI"
              ]
            },
            "accordion_row_kVDoTP": {
              "type": "_accordion-row",
              "settings": {
                "heading": "How Long Do Titanium Ice Cubes Keep Drinks Cold?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_7OJerb": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Once frozen, titanium ice cubes hold their cold temperature efficiently thanks to the metal's density, keeping drinks chilled without watering them down.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,

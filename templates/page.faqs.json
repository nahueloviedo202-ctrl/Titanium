                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text-1": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Plastic spatulas have a very low melting temperature, releasing toxic chemicals each time they're used, causing serious health risks like gut, hormone disruption & cancer.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",

            },
            "row-14": {
              "type": "_accordion-row",
              "settings": {
                "heading": "What can I cook with it?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text-1": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Anything you love. The Taima® Titanium Pan excels at searing steaks, flipping omelets, frying crispy potatoes, deglazing sauces, shallow or deep frying, baking, roasting, or even open-flame cooking. From delicate fish to hearty pastas - this pan adapts.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",

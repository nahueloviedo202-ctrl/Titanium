@font-face {
  font-family: 'Cormorant Garamond';
  src: url('{{ 'cormorant-garamond-400.woff2' | asset_url }}') format('woff2');
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

.image-cta-banner {
  overflow: hidden;
}

.image-cta-banner__image .placeholder-image {
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-cta-banner__scrim {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  height: 50.83%;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0) 100%);
  pointer-events: none;
}

.image-cta-banner__content {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  display: flex;
  padding: 0 var(--container-pad-x) 32px;
}

.image-cta-banner__inner {
  display: flex;
  width: 100%;
  max-width: 684px;
  flex-direction: column;
  align-items: flex-start;
  gap: 32px;
}

.image-cta-banner__text {
  display: flex;
  width: 100%;
  flex-direction: column;
  align-items: flex-start;
  gap: 12px;
  max-width: 391px;
}

.image-cta-banner__heading {
  margin: 0;
  width: 100%;
  font-family: 'Cormorant Garamond', serif;
  font-weight: 400;
  font-style: normal;
  font-size: 48px;
  line-height: 1.1;
  letter-spacing: -1px;
  color: #F5F5F2;
  text-transform: capitalize;
}

.image-cta-banner__text-rte {
  max-width: min(391px, 100%);
  font-family: 'DM Sans', sans-serif;
  font-weight: 400;
  font-size: 14px;
  font-variation-settings: 'opsz' 14;
  line-height: 1.5;
  color: #D4D4D4;
}

.image-cta-banner__text-rte p {
  margin: 0;
}

.image-cta-banner__button-row {
  display: flex;
  flex-wrap: wrap;
  align-items: stretch;
  gap: 12px;
}

.image-cta-banner__button {
  display: inline-flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  min-height: 40px;
  padding: 0 32px;
  border: 0;
  border-radius: 0;
  background: #F5F5F2;
  color: #050505;
  font-family: 'DM Sans', sans-serif;
  font-weight: 500;
  font-variation-settings: 'opsz' 14;
  font-size: 13px;
  line-height: 1;
  letter-spacing: 1px;
  text-align: center;
  text-decoration: none;
  text-transform: uppercase;
  white-space: nowrap;
  cursor: pointer;
  transition: background-color 100ms, color 100ms, border-color 100ms;
}

@media (max-width: 767.98px) {
  .image-cta-banner__button-row {
    flex-wrap: nowrap;
  }

  .image-cta-banner__button {
    flex: 1 1 0;
    min-width: 0;
    padding: 0 12px;
    white-space: normal;
    text-align: center;
  }
}

.image-cta-banner__button:hover {
  background: #050505;
  color: #F5F5F2;
}

.image-cta-banner__button--secondary {
  border: 1px solid #F5F5F2;
  background: transparent;
  color: #F5F5F2;
}

.image-cta-banner__button--secondary:hover {
  border-color: #F5F5F2;
  background: #F5F5F2;
  color: #050505;
}

@media (min-width: 768px) {
  .image-cta-banner__content {
    padding-bottom: 75px;
  }
}

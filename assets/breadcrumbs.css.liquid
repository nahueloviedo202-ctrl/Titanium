.container-breadcrumbs {
  padding-top: var(--bc-pad-top-mobile, 0px);
  padding-bottom: var(--bc-pad-bottom-mobile, 0px);
  padding-left: var(--bc-pad-left-mobile, 0px);
  padding-right: var(--bc-pad-right-mobile, 0px);
}

@media (min-width: 768px) {
  .container-breadcrumbs {
    padding-top: var(--bc-pad-top-desktop, 0px);
    padding-bottom: var(--bc-pad-bottom-desktop, 0px);
    padding-left: var(--bc-pad-left-desktop, 0px);
    padding-right: var(--bc-pad-right-desktop, 0px);
  }
}



{% liquid
  if section.settings.background_color != blank or section.settings.text_color != blank
    render 'contrast-override', background_color: section.settings.background_color, text_color: section.settings.text_color, section_id: section.id, skip_contrast: true
  endif
%}

<section
  id="ScrollTextFade-{{ section.id }}"
  class="scroll-text-fade{% if section.settings.background_color != blank or section.settings.text_color != blank %} color-custom-{{ section.id }}{% endif %}"
  role="region"
  aria-label="{{ 'accessibility.scroll_text_fade_region' | t }}"
>
  {%- if section.blocks.size > 0 -%}
    <script
      src="{{ 'scroll-text-fade.js' | asset_url }}"
      type="module"
      fetchpriority="low"
    ></script>
    <scroll-text-fade-component
      class="scroll-text-fade__inner"
      style="
        --scroll-text-fade-padding-block-start: {{ section.settings.padding_block_start }}px;
        --scroll-text-fade-padding-block-end: {{ section.settings.padding_block_end }}px;
        --scroll-text-fade-padding-inline-start: {{ section.settings.padding_inline_start }}px;
        --scroll-text-fade-padding-inline-end: {{ section.settings.padding_inline_end }}px;
        --scroll-text-fade-padding-block-start-mobile: {{ section.settings.padding_block_start_mobile }}px;
        --scroll-text-fade-padding-block-end-mobile: {{ section.settings.padding_block_end_mobile }}px;
        --scroll-text-fade-padding-inline-start-mobile: {{ section.settings.padding_inline_start_mobile }}px;
        --scroll-text-fade-padding-inline-end-mobile: {{ section.settings.padding_inline_end_mobile }}px;
        --scroll-text-fade-gap: {{ section.settings.line_gap }}px;
        --scroll-text-fade-font: {{ section.settings.font }};
        --scroll-text-fade-line-height: var(--line-height--display-{{ section.settings.line_height }});
        --scroll-text-fade-letter-spacing: var(--letter-spacing--display-{{ section.settings.letter_spacing }});
        --scroll-text-fade-case: {{ section.settings.case }};
        --scroll-text-fade-align: {{ section.settings.alignment }};
        --scroll-text-fade-focused-size: {{ section.settings.focused_font_size }}px;
        --scroll-text-fade-focused-size-mobile: {{ section.settings.focused_font_size_mobile }}px;
        --scroll-text-fade-transition-speed: {{ section.settings.transition_speed }}ms;
      "
    >
      {% content_for 'blocks' %}
    </scroll-text-fade-component>
  {%- endif -%}
</section>

{% stylesheet %}
  .scroll-text-fade {
    position: relative;
    color: var(--color-foreground);
    background-color: var(--color-background);
  }

  .scroll-text-fade__inner {
    display: block;
    padding-block: var(--scroll-text-fade-padding-block-start, 0) var(--scroll-text-fade-padding-block-end, 0);
    padding-inline: var(--scroll-text-fade-padding-inline-start, 0) var(--scroll-text-fade-padding-inline-end, 0);
    text-align: var(--scroll-text-fade-align, center);
  }

  .scroll-text-fade__line {
    margin: var(--scroll-text-fade-gap, 24px) 0;
    font-family: var(--scroll-text-fade-font, var(--font-body--family));
    line-height: var(--scroll-text-fade-line-height, 1.2);
    letter-spacing: var(--scroll-text-fade-letter-spacing, normal);
    text-transform: var(--scroll-text-fade-case, capitalize);
    color: var(--scroll-text-fade-line-color, currentColor);
    font-size: var(--scroll-text-fade-line-size, 3rem);
    opacity: var(--scroll-text-fade-line-opacity, 0.3);
    overflow-wrap: break-word;
    transition:
      opacity var(--scroll-text-fade-transition-speed, 0.4s) ease,
      font-size var(--scroll-text-fade-transition-speed, 0.4s) ease;
  }

  .scroll-text-fade__inner > .scroll-text-fade__line:first-child {
    margin-top: 0;
  }

  .scroll-text-fade__inner > .scroll-text-fade__line:last-child {
    margin-bottom: 0;
  }

  /* Declared after the base rule so it wins on equal specificity without !important. */
  .scroll-text-fade__line--focused {
    font-size: var(--scroll-text-fade-focused-size, 4rem);
    opacity: 1;
  }

  @media screen and (min-width: 750px) {
    .scroll-text-fade__line--hide-desktop {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .scroll-text-fade__inner {
      padding-block: var(--scroll-text-fade-padding-block-start-mobile, 0) var(--scroll-text-fade-padding-block-end-mobile, 0);
      padding-inline: var(--scroll-text-fade-padding-inline-start-mobile, 0) var(--scroll-text-fade-padding-inline-end-mobile, 0);
    }

    .scroll-text-fade__line--hide-mobile {
      display: none;
    }

    .scroll-text-fade__line {
      font-size: var(--scroll-text-fade-line-size-mobile, var(--scroll-text-fade-line-size));
    }

    .scroll-text-fade__line--focused {
      font-size: var(--scroll-text-fade-focused-size-mobile, var(--scroll-text-fade-focused-size));
    }
  }
{% endstylesheet %}

{% schema %}

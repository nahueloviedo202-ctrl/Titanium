      "max": 5,
      "step": 1,
      "default": 5,
      "visible_if": "{{ section.settings.show_rating }}"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "t:settings.star_color",
      "default": "#B57C46",
      "visible_if": "{{ section.settings.show_rating }}"
    },
    {
      "type": "range",
      "id": "rating_icon_size",
      "label": "t:settings.size",
      "min": 12,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.show_rating }}"
    },
    {
      "type": "range",
      "id": "rating_icon_size_mobile",
      "label": "t:settings.size_mobile",
      "min": 12,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.show_rating }}"
    },
    {
      "type": "header",
      "content": "t:content.heading"

      "default": "t:html_defaults.trust_band_tiles_heading"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:settings.heading_color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "highlighted_text_color",
      "label": "t:settings.highlighted_text_color",
      "default": "#BCA588"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "t:settings.size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "heading_size_mobile",

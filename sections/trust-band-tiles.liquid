

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id, skip_contrast: true
  endif

  assign rating_value = section.settings.rating_value | at_most: 5 | at_least: 0
%}

<section
  id="TrustBandTiles-{{ section.id }}"
  class="trust-band-tiles{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  role="region"
  aria-label="{% if section.settings.heading != blank %}{{ section.settings.heading | strip_html }}{% else %}{{ 'accessibility.trust_band_tiles_region' | t }}{% endif %}"
  style="
    --trust-band-tiles-padding-block-start: {{ section.settings.padding_block_start }}px;
    --trust-band-tiles-padding-block-end: {{ section.settings.padding_block_end }}px;
    --trust-band-tiles-padding-inline-start: {{ section.settings.padding_inline_start }}px;
    --trust-band-tiles-padding-inline-end: {{ section.settings.padding_inline_end }}px;
    --trust-band-tiles-padding-block-start-mobile: {{ section.settings.padding_block_start_mobile }}px;
    --trust-band-tiles-padding-block-end-mobile: {{ section.settings.padding_block_end_mobile }}px;
    --trust-band-tiles-padding-inline-start-mobile: {{ section.settings.padding_inline_start_mobile }}px;
    --trust-band-tiles-padding-inline-end-mobile: {{ section.settings.padding_inline_end_mobile }}px;
  "
>
  <div
    class="trust-band-tiles__head"
    style="--trust-band-tiles-head-max-width: {{ section.settings.content_max_width }}px;"
  >
    {%- if section.settings.show_rating -%}
      <div
        class="trust-band-tiles__stars"
        aria-hidden="true"
        style="
          --trust-band-tiles-star-color: {{ section.settings.star_color }};
          --trust-band-tiles-star-size: {{ section.settings.rating_icon_size }}px;
          --trust-band-tiles-star-size-mobile: {{ section.settings.rating_icon_size_mobile }}px;
        "
      >
        {%- for i in (1..5) -%}
          <span class="trust-band-tiles__star{% if i <= rating_value %} trust-band-tiles__star--filled{% endif %}">
            {% render 'icon-or-image',
              icon: 'star',
              width: section.settings.rating_icon_size,
              class_name: 'trust-band-tiles__star-icon'
            %}
          </span>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2
        class="trust-band-tiles__heading"
        style="
          {% if section.settings.heading_color != blank %}color: {{ section.settings.heading_color }};{% endif %}
          {% if section.settings.highlighted_text_color != blank %}--trust-band-tiles-heading-accent: {{ section.settings.highlighted_text_color }};{% endif %}
          --trust-band-tiles-heading-size: {{ section.settings.heading_size }}px;
          --trust-band-tiles-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
        "
      >
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div
      class="trust-band-tiles__grid"
      style="
        --trust-band-tiles-columns-desktop: {{ section.settings.columns_desktop }};
        --trust-band-tiles-columns-mobile: {{ section.settings.columns_mobile }};
        --trust-band-tiles-gap: {{ section.settings.tile_gap }}px;
      "
    >
      {% content_for 'blocks' %}
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .trust-band-tiles {
    --tbt-scale: 1;
    position: relative;
    background-color: var(--color-background, #03231A);
    padding-block: calc(var(--trust-band-tiles-padding-block-start, 120px) * var(--tbt-scale)) calc(var(--trust-band-tiles-padding-block-end, 120px) * var(--tbt-scale));
    padding-inline: calc(var(--trust-band-tiles-padding-inline-start, 0px) * var(--tbt-scale)) calc(var(--trust-band-tiles-padding-inline-end, 0px) * var(--tbt-scale));
  }

  .trust-band-tiles__head {
    max-width: calc(var(--trust-band-tiles-head-max-width, 1200px) * var(--tbt-scale));
    margin-inline: auto;
    margin-block-end: calc(48px * var(--tbt-scale));
    text-align: center;
  }

  .trust-band-tiles__stars {
    display: flex;
    justify-content: center;
    gap: calc(8px * var(--tbt-scale));
    margin-block-end: calc(10px * var(--tbt-scale));
  }

  .trust-band-tiles__star {
    display: flex;
    color: rgb(var(--color-foreground-rgb) / 0.3);
  }

  .trust-band-tiles__star--filled {
    color: var(--trust-band-tiles-star-color, #B57C46);
  }

  .trust-band-tiles__star-icon {
    width: calc(var(--trust-band-tiles-star-size, 24px) * var(--tbt-scale));
    height: calc(var(--trust-band-tiles-star-size, 24px) * var(--tbt-scale));
  }

  .trust-band-tiles__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-transform: capitalize;
    color: #ffffff;
    font-size: calc(var(--trust-band-tiles-heading-size, 48px) * var(--tbt-scale));
  }

  .trust-band-tiles__heading p {
    margin: 0;
  }

  .trust-band-tiles__heading strong {
    color: var(--trust-band-tiles-heading-accent, inherit);
    font-weight: 400;
  }

  .trust-band-tiles__grid {
    display: grid;
    grid-template-columns: repeat(var(--trust-band-tiles-columns-mobile, 3), 1fr);
    gap: var(--trust-band-tiles-gap, 0px);
  }

  @media screen and (min-width: 900px) {
    .trust-band-tiles__grid {
      grid-template-columns: repeat(var(--trust-band-tiles-columns-desktop, 8), 1fr);
    }
  }

  @media screen and (min-width: 750px) and (max-width: 1799px) {
    .trust-band-tiles {
      --tbt-scale: 0.9;
    }
  }

  @media screen and (min-width: 2200px) {
    .trust-band-tiles {
      --tbt-scale: 1.3;
    }
  }

  @media screen and (max-width: 749px) {
    .trust-band-tiles {
      padding-block: var(--trust-band-tiles-padding-block-start-mobile, 64px) var(--trust-band-tiles-padding-block-end-mobile, 64px);
      padding-inline: var(--trust-band-tiles-padding-inline-start-mobile, 16px) var(--trust-band-tiles-padding-inline-end-mobile, 16px);
    }

    .trust-band-tiles__head {
      max-width: none;
      margin-block-end: 48px;
    }

    .trust-band-tiles__heading {
      font-size: var(--trust-band-tiles-heading-size-mobile, 32px);
    }

    .trust-band-tiles__star-icon {
      width: var(--trust-band-tiles-star-size-mobile, 24px);
      height: var(--trust-band-tiles-star-size-mobile, 24px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.trust_band_tiles",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "_trust-tile"
    }

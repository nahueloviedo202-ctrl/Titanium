        "card_2": {
          "type": "_advantage-card",
          "settings": {
            "icon": "recycle",
            "title": "It Strengthens With Every Use",
            "text": "Titanium work-hardens: repeated pressure realigns the atoms at the point of contact, making that exact spot more resistant over time instead of wearing it down."
          }

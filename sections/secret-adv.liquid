      "id": "mobile_image",
      "label": "t:settings.image"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#03231A"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "t:settings.icon_color",

  ],
  "presets": [
    {
      "name": "t:names.secret_advantage",
      "category": "t:categories.storytelling",
      "blocks": {
        "card_1": {
          "type": "_advantage-card",
          "settings": {
            "icon": "lightning_bolt",
            "title": "Impact Spreads, It Doesn't Crack",
            "text": "A blade striking titanium doesn't chip or splinter. The force travels outward across countless crystal boundaries, leaving only faint marks instead of deep grooves where bacteria could hide."
          }

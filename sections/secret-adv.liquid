

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id, skip_contrast: true
  endif
%}

<section
  id="SecretAdv-{{ section.id }}"
  class="secret-adv{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  role="region"
  aria-label="{% if section.settings.heading != blank %}{{ section.settings.heading | strip_html }}{% else %}{{ 'accessibility.secret_advantage_region' | t }}{% endif %}"
>
  <div
    class="secret-adv__wrap"
    style="
      --secret-adv-padding-block-start: {{ section.settings.padding_block_start }}px;
      --secret-adv-padding-block-end: {{ section.settings.padding_block_end }}px;
      --secret-adv-padding-inline-start: {{ section.settings.padding_inline_start }}px;
      --secret-adv-padding-inline-end: {{ section.settings.padding_inline_end }}px;
      --secret-adv-padding-block-start-mobile: {{ section.settings.padding_block_start_mobile }}px;
      --secret-adv-padding-block-end-mobile: {{ section.settings.padding_block_end_mobile }}px;
      --secret-adv-padding-inline-start-mobile: {{ section.settings.padding_inline_start_mobile }}px;
      --secret-adv-padding-inline-end-mobile: {{ section.settings.padding_inline_end_mobile }}px;
      --secret-adv-heading-color: {{ section.settings.heading_color }};
      --secret-adv-subheading-color: {{ section.settings.subheading_color }};
      --secret-adv-copy-color: {{ section.settings.copy_color }};
      --secret-adv-matters-color: {{ section.settings.matters_heading_color }};
      --secret-adv-icon-color: {{ section.settings.icon_color }};
      --secret-adv-card-title-color: {{ section.settings.card_title_color }};
      --secret-adv-card-text-color: {{ section.settings.card_text_color }};
    "
  >
    {%- if section.settings.mobile_image != blank -%}
      <div class="secret-adv__mobile-image">
        <img
          src="{{ section.settings.mobile_image | image_url: width: 900 }}"
          srcset="
            {{- section.settings.mobile_image | image_url: width: 600 }} 600w,
            {{ section.settings.mobile_image | image_url: width: 900 }} 900w
          "
          sizes="100vw"
          alt="{{ section.settings.mobile_image.alt | escape }}"
          width="{{ section.settings.mobile_image.width }}"
          height="{{ section.settings.mobile_image.height }}"
          loading="lazy"
        >
      </div>
    {%- endif -%}

    <div
      class="secret-adv__grid"
      style="
        --secret-adv-left-width: {{ section.settings.left_column_width }}px;
        --secret-adv-column-gap: {{ section.settings.column_gap }}px;
      "
    >
      <div class="secret-adv__left">
        {%- if section.settings.heading != blank -%}
          <h2
            class="secret-adv__heading"
            style="
              --secret-adv-heading-size: {{ section.settings.heading_font_size }}px;
              --secret-adv-heading-size-mobile: {{ section.settings.heading_font_size_mobile }}px;
            "
          >
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <h3
            class="secret-adv__subheading"
            style="
              --secret-adv-subheading-size: {{ section.settings.subheading_font_size }}px;
              --secret-adv-subheading-size-mobile: {{ section.settings.subheading_font_size_mobile }}px;
            "
          >
            {{ section.settings.subheading }}
          </h3>
        {%- endif -%}

        {%- if section.settings.copy != blank -%}
          <div class="secret-adv__copy rte">
            {{ section.settings.copy }}
          </div>
        {%- endif -%}

        {%- if section.settings.matters_heading != blank -%}
          <p class="secret-adv__matters">
            {{ section.settings.matters_heading }}
          </p>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div
          class="secret-adv__cards"
          style="
            --secret-adv-cards-gap: {{ section.settings.cards_gap }}px;
            --secret-adv-cards-max-width: {{ section.settings.cards_max_width }}px;
          "
        >
          {% content_for 'blocks' %}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .secret-adv {
    position: relative;
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .secret-adv__wrap {
    padding-block: var(--secret-adv-padding-block-start, 0) var(--secret-adv-padding-block-end, 0);
    padding-inline: var(--secret-adv-padding-inline-start, 0) var(--secret-adv-padding-inline-end, 0);
  }

  .secret-adv__mobile-image {
    display: none;
  }

  .secret-adv__grid {
    display: grid;
    grid-template-columns: var(--secret-adv-left-width, 498px) 1fr;
    column-gap: var(--secret-adv-column-gap, 120px);
    align-items: start;
  }

  .secret-adv__heading {
    margin: 0 0 12px;
    color: var(--secret-adv-heading-color, #BCA588);
    font-family: var(--font-body--family);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: var(--letter-spacing--display-normal);
    text-transform: capitalize;
    font-size: var(--secret-adv-heading-size, 48px);
  }

  .secret-adv__subheading {
    margin: 0 0 32px;
    color: var(--secret-adv-subheading-color, #FFFFFF);
    font-family: var(--font-body--family);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: var(--letter-spacing--display-normal);
    text-transform: capitalize;
    font-size: var(--secret-adv-subheading-size, 24px);
  }

  .secret-adv__copy {
    color: var(--secret-adv-copy-color, #B0B0B0);
    font-family: var(--font-body--family);
  }

  .secret-adv__copy p {
    margin: 0 0 12px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: var(--letter-spacing--body-loose);
    font-size: 16px;
  }

  .secret-adv__copy p:last-child {
    margin-bottom: 0;
  }

  .secret-adv__matters {
    margin: 16px 0 0;
    color: var(--secret-adv-matters-color, #FFFFFF);
    font-family: var(--font-body--family);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: var(--letter-spacing--display-normal);
    text-transform: capitalize;
    font-size: 20px;
  }

  .secret-adv__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--secret-adv-cards-gap, 64px);
    max-width: var(--secret-adv-cards-max-width, 1028px);
  }

  .secret-adv__cards .adv-card__icon {
    color: var(--secret-adv-icon-color, #C9A371);
  }

  .secret-adv__cards .adv-card__title {
    color: var(--secret-adv-card-title-color, #FFFFFF);
  }

  .secret-adv__cards .adv-card__text {
    color: var(--secret-adv-card-text-color, #B0B0B0);
  }

  @media screen and (max-width: 989px) {
    .secret-adv__grid {
      grid-template-columns: 1fr;
      row-gap: 32px;
    }

    .secret-adv__cards {
      grid-template-columns: 1fr;
      max-width: none;
    }
  }

  @media screen and (max-width: 749px) {
    .secret-adv__wrap {
      padding-block: var(--secret-adv-padding-block-start-mobile, 0) var(--secret-adv-padding-block-end-mobile, 0);
      padding-inline: var(--secret-adv-padding-inline-start-mobile, 0) var(--secret-adv-padding-inline-end-mobile, 0);
    }

    .secret-adv__mobile-image {
      display: block;
      overflow: hidden;
      margin: 0 0 32px;
      aspect-ratio: 1 / 1;
      background: rgb(255 255 255 / 0.08);
    }

    .secret-adv__mobile-image img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .secret-adv__heading {
      font-size: var(--secret-adv-heading-size-mobile, 24px);
    }

    .secret-adv__subheading {
      margin-bottom: 16px;
      font-size: var(--secret-adv-subheading-size-mobile, 20px);
    }

    .secret-adv__copy p {
      font-size: 14px;
    }

    .secret-adv__matters {
      font-size: 16px;
    }

    .secret-adv__cards {
      gap: 32px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.secret_advantage",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "_advantage-card"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.secret_advantage_heading"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:settings.heading_color",
      "default": "#BCA588"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "t:settings.heading_size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {

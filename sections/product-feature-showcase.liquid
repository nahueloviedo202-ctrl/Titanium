                "label_position": "top_right",
                "label_x": 96,
                "label_y": 8,
                "dot_x": 76,
                "dot_y": 24
              }
            },
            "annotation_3": {
              "type": "_product-feature-annotation",
              "settings": {
                "icon": "fire",
                "title": "Triple-layer encapsulated base",
                "text": "Distributes heat evenly for perfect cooking results.",
                "label_position": "bottom_left",
                "label_x": 4,
                "label_y": 92,
                "dot_x": 40,
                "dot_y": 76
              }

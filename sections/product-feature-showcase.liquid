

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id, skip_contrast: true
  endif

  assign image = section.settings.image
%}

<section
  id="ProductFeatureShowcase-{{ section.id }}"
  class="product-feature-showcase{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  role="region"
  aria-label="{% if section.settings.heading != blank %}{{ section.settings.heading | strip_html }}{% else %}{{ 'accessibility.product_feature_showcase_region' | t }}{% endif %}"
>
  <div
    class="product-feature-showcase__inner"
    style="
      --pfs-padding-block-start: {{ section.settings.padding_block_start }}px;
      --pfs-padding-block-end: {{ section.settings.padding_block_end }}px;
      --pfs-padding-inline-start: {{ section.settings.padding_inline_start }}px;
      --pfs-padding-inline-end: {{ section.settings.padding_inline_end }}px;
      --pfs-padding-block-start-mobile: {{ section.settings.padding_block_start_mobile }}px;
      --pfs-padding-block-end-mobile: {{ section.settings.padding_block_end_mobile }}px;
      --pfs-padding-inline-start-mobile: {{ section.settings.padding_inline_start_mobile }}px;
      --pfs-padding-inline-end-mobile: {{ section.settings.padding_inline_end_mobile }}px;
      --pfs-accent-color: {{ section.settings.accent_color }};
      --pfs-accent-rgb: {{ section.settings.accent_color.rgb }};
      --pfs-title-color: {{ section.settings.card_title_color }};
      --pfs-text-color: {{ section.settings.text_color }};
      --pfs-card-border-color: {{ section.settings.card_border_color }};
      --pfs-card-radius: {{ section.settings.card_corner_radius }}px;
    "
  >
    <div class="product-feature-showcase__row">
      <div class="product-feature-showcase__content">
        {%- if section.settings.heading != blank -%}
          <h2
            class="product-feature-showcase__heading"
            style="
              color: {{ section.settings.heading_color }};
              --pfs-heading-accent: {{ section.settings.highlighted_text_color }};
              --pfs-heading-size: {{ section.settings.heading_font_size }}px;
              --pfs-heading-size-mobile: {{ section.settings.heading_font_size_mobile }}px;
            "
          >
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <div class="product-feature-showcase__subheading">
            {{ section.settings.subheading }}
          </div>
        {%- endif -%}

        {% content_for 'block', type: '_product-feature-list', id: 'feature-list' %}
      </div>

      <div class="product-feature-showcase__media">
        {%- if image != blank -%}
          <img
            class="product-feature-showcase__image"
            src="{{ image | image_url: width: 846 }}"
            srcset="
              {{- image | image_url: width: 423 }} 1x,
              {{ image | image_url: width: 846 }} 2x
            "
            width="423"
            height="423"
            alt="{{ image.alt | default: section.settings.heading | strip_html | escape }}"
            loading="lazy"
          >
        {%- else -%}
          {{ 'product-apparel-1' | placeholder_svg_tag: 'product-feature-showcase__image placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .product-feature-showcase {
    position: relative;
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .product-feature-showcase__inner {
    max-width: 1440px;
    margin-inline: auto;
    padding-block: var(--pfs-padding-block-start, 64px) var(--pfs-padding-block-end, 64px);
    padding-inline: var(--pfs-padding-inline-start, 24px) var(--pfs-padding-inline-end, 24px);
  }

  .product-feature-showcase__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 30px;
  }

  .product-feature-showcase__content {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
  }

  .product-feature-showcase__heading {
    margin: 0;
    font-family: var(--font-body--family);
    font-weight: 400;
    line-height: var(--line-height--display-loose, 1.2);
    letter-spacing: var(--letter-spacing--display-loose, 0.03em);
    text-transform: capitalize;
    font-size: var(--pfs-heading-size, 28px);
  }

  .product-feature-showcase__heading p {
    margin: 0;
  }

  .product-feature-showcase__heading strong {
    color: var(--pfs-heading-accent, inherit);
    font-weight: 400;
  }

  .product-feature-showcase__subheading {
    margin-top: -8px;
    color: var(--pfs-text-color, #b0b0b0);
    font-family: var(--font-body--family);
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: var(--letter-spacing--body-loose, 0.03em);
    font-size: 15px;
  }

  .product-feature-showcase__subheading p {
    margin: 0 0 1em;
  }

  .product-feature-showcase__subheading p:last-child {
    margin-bottom: 0;
  }

  .product-feature-showcase__media {
    min-width: 0;
  }

  .product-feature-showcase__image,
  .product-feature-showcase__media .placeholder-svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--pfs-card-radius, 12px);
  }

  @media screen and (max-width: 749px) {
    .product-feature-showcase__inner {
      padding-block: var(--pfs-padding-block-start-mobile, 0) var(--pfs-padding-block-end-mobile, 0);
      padding-inline: var(--pfs-padding-inline-start-mobile, 0) var(--pfs-padding-inline-end-mobile, 0);
    }

    .product-feature-showcase__row {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .product-feature-showcase__heading {
      font-size: var(--pfs-heading-size-mobile, 22px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_feature_showcase",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.heading"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:html_defaults.product_feature_showcase_heading"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:settings.heading_color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "t:settings.heading_size",
      "min": 20,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "t:settings.size_mobile",
      "min": 16,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:settings.subheading",
      "default": "t:html_defaults.product_feature_showcase_subheading"
    },
    {
      "type": "color",
      "id": "highlighted_text_color",
      "label": "t:settings.highlighted_text_color",
      "default": "#BCA588"
    },
    {
      "type": "header",
      "content": "t:content.media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "default": "#B0B0B0"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "t:settings.card_title_color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "t:settings.border_color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:settings.accent_color",
      "default": "#BCA588"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "range",
      "id": "card_corner_radius",
      "label": "t:settings.card_corner_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:content.padding_desktop"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_inline_start",
      "label": "t:settings.left",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_inline_end",
      "label": "t:settings.right",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "t:content.padding_mobile"
    },
    {
      "type": "range",
      "id": "padding_block_start_mobile",
      "label": "t:settings.top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_block_end_mobile",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_inline_start_mobile",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_inline_end_mobile",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "t:names.product_feature_showcase",
      "category": "t:categories.product",
      "blocks": {
        "feature-list": {
          "type": "_product-feature-list",
          "static": true,
          "blocks": {
            "item_1": {
              "type": "_product-feature-item",
              "settings": {
                "icon": "leaf",
                "title": "No chemicals, no coatings",
                "text": "Cook without worry — there's no coating to break down or leach harmful substances into your food."
              }
            },
            "item_2": {
              "type": "_product-feature-item",
              "settings": {
                "icon": "star",
                "title": "Strong and long-lasting",
                "text": "Made from high-quality stainless steel, built to withstand daily use and last for years."
              }
            },
            "item_3": {
              "type": "_product-feature-item",
              "settings": {
                "icon": "heart",
                "title": "Healthier cooking",
                "text": "A natural surface that won't react with food or alter its flavor."
              }
            },
            "item_4": {
              "type": "_product-feature-item",
              "settings": {
                "icon": "fire",
                "title": "Even heat distribution",
                "text": "An encapsulated base that ensures even cooking and perfect results every time."
              }
            }
          },
          "block_order": ["item_1", "item_2", "item_3", "item_4"]
        }
      }
    }
  ]
}
{% endschema %}



{%- liquid
  assign max_items = section.settings.max_products
  assign use_placeholders = false
  if section.settings.collection == blank or shop.products_count == 0
    assign use_placeholders = true
  endif

  assign product_count = max_items
  unless use_placeholders
    assign product_count = section.settings.collection.products.size | at_most: max_items
  endunless

  assign show_nav = true
  if section.settings.icons_style == 'none' or product_count <= 1
    assign show_nav = false
  endif

  assign slideshow_gutters = null
  assign gutter_style = '--gutter-slide-width: 0px;'
  if section.settings.section_width == 'page-width'
    assign slideshow_gutters = 'start end'
    assign gutter_style = '--gutter-slide-width: var(--util-page-margin-offset);'
  endif

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
-%}

{% capture header_content %}
  {%- if section.settings.heading != blank or show_nav -%}
    <div class="best-sellers-slider__header">
      {%- if section.settings.heading != blank -%}
        <h2
          class="best-sellers-slider__heading"
          style="
            color: {{ section.settings.heading_color }};
            --best-sellers-slider-heading-size: {{ section.settings.heading_font_size }}px;
            --best-sellers-slider-heading-size-mobile: {{ section.settings.heading_font_size_mobile }}px;
          "
        >
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}

      {%- if show_nav -%}
        <div class="best-sellers-slider__nav best-sellers-slider__nav--desktop">
          {%- render 'slideshow-arrow',
            action: 'previous',
            icon_style: section.settings.icons_style,
            icon_shape: section.settings.icons_shape
          -%}
          {%- render 'slideshow-arrow',
            action: 'next',
            icon_style: section.settings.icons_style,
            icon_shape: section.settings.icons_shape
          -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
{% endcapture %}

{% capture mobile_nav_content %}
  {%- if show_nav -%}
    <div class="best-sellers-slider__nav best-sellers-slider__nav--mobile">
      {%- render 'slideshow-arrow',
        action: 'previous',
        icon_style: section.settings.icons_style,
        icon_shape: section.settings.icons_shape
      -%}
      {%- render 'slideshow-arrow',
        action: 'next',
        icon_style: section.settings.icons_style,
        icon_shape: section.settings.icons_shape
      -%}
    </div>
  {%- endif -%}
{% endcapture %}

{% capture slides %}
  {%- if use_placeholders -%}
    {%- for i in (1..max_items) -%}
      {%- render 'best-sellers-card', product: null, section: section, index: forloop.index0 -%}
    {%- endfor -%}
  {%- else -%}
    {%- for product in section.settings.collection.products limit: max_items -%}
      {%- render 'best-sellers-card', product: product, section: section, index: forloop.index0 -%}
    {%- endfor -%}
  {%- endif -%}
{% endcapture %}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="
    best-sellers-slider
    section
    section--{{ section.settings.section_width }}
    spacing-style
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
  "
  style="
    {% render 'spacing-style', settings: section.settings %};
    --best-sellers-slider-gap: {{ section.settings.gap }}px;
    --slideshow-gap: var(--best-sellers-slider-gap);
    --best-sellers-slider-columns: {{ section.settings.slides_per_view }};
    --best-sellers-slider-mobile-width: {{ section.settings.mobile_card_width }}px;
    --best-sellers-slider-arrow-bg: {{ section.settings.arrow_background_color }};
    --best-sellers-slider-arrow-color: {{ section.settings.arrow_icon_color }};
    --best-sellers-slider-arrow-outline: {{ section.settings.subtitle_color }};
    --best-sellers-slider-padding-inline-start-mobile: {{ section.settings.padding_inline_start_mobile }}px;
    --best-sellers-slider-padding-inline-end-mobile: {{ section.settings.padding_inline_end_mobile }}px;
  "
>
  <div
    class="best-sellers-slider__carousel-wrapper"
    style="{{ gutter_style }}"
  >
    {% render 'slideshow',
      ref: 'bestSellersSlider',
      class: 'best-sellers-slider__carousel',
      header: header_content,
      slides: slides,
      show_arrows: false,
      autoplay: section.settings.autoplay,
      autoplay_speed: section.settings.autoplay_speed,
      infinite: false,
      slide_count: product_count,
      slideshow_gutters: slideshow_gutters
    %}
  </div>
  {{ mobile_nav_content }}
</div>

{% stylesheet %}
  .best-sellers-slider {
    position: relative;
  }

  .best-sellers-slider__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: clamp(1.5rem, 4vw, 3rem);
  }

  .best-sellers-slider__heading {
    margin: 0;
    font-family: var(--font-heading--family, var(--font-body--family));
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0.02em;
    text-transform: capitalize;
    font-size: var(--best-sellers-slider-heading-size, 48px);
  }

  @media screen and (max-width: 749px) {
    .best-sellers-slider__heading {
      font-size: var(--best-sellers-slider-heading-size-mobile, 24px);
    }

    /* Desktop's page-margin-sized inline padding only ever scales down to 70%, which is still
       far too wide on phones and leaves no room for the carousel to peek the next card. */
    .best-sellers-slider.spacing-style {
      padding-inline: var(--best-sellers-slider-padding-inline-start-mobile, 16px)
        var(--best-sellers-slider-padding-inline-end-mobile, 16px);
    }
  }

  .best-sellers-slider__nav {
    display: flex;
    flex: 0 0 auto;
    gap: 0.75rem;
  }

  .best-sellers-slider__nav--mobile {
    display: flex;
    margin-block-start: clamp(1rem, 4vw, 2rem);
  }

  .best-sellers-slider__nav--desktop {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .best-sellers-slider__nav--mobile {
      display: none;
    }

    .best-sellers-slider__nav--desktop {
      display: flex;
    }
  }

  .best-sellers-slider__carousel {
    container-type: inline-size;
    container-name: best-sellers-slider;
  }

  .best-sellers-slider__carousel slideshow-slides {
    /* Extra block padding keeps card shadows/borders from clipping while scrolling. */
    margin-block: -1rem;
    padding-block: 1rem;
  }

  @container best-sellers-slider (max-width: 749px) {
    .best-sellers-slider .best-sellers-slider__slide {
      --slide-width: var(--best-sellers-slider-mobile-width, 250px);
    }
  }

  @container best-sellers-slider (min-width: 750px) {
    .best-sellers-slider .best-sellers-slider__slide {
      --slide-width: calc(
        (100% - (var(--best-sellers-slider-gap, 16px) * (var(--best-sellers-slider-columns, 5) - 1))) /
          var(--best-sellers-slider-columns, 5)
      );
    }
  }

  /* Arrows sit in the header instead of overlaying the carousel: previous is an outline
     button, next is filled, matching the reference's asymmetric control styling. */
  .best-sellers-slider .slideshow-control.slideshow-control--shape-circle,
  .best-sellers-slider .slideshow-control.slideshow-control--shape-square {
    width: 4rem;
    height: 4rem;
  }

  .best-sellers-slider .slideshow-control.slideshow-control--shape-square {
    border-radius: 0.75rem;
  }

  .best-sellers-slider .slideshow-control.slideshow-control--shape-circle.slideshow-control--next,
  .best-sellers-slider .slideshow-control.slideshow-control--shape-square.slideshow-control--next {
    background-color: var(--best-sellers-slider-arrow-bg);
    color: var(--best-sellers-slider-arrow-color);
  }

  .best-sellers-slider .slideshow-control.slideshow-control--shape-circle.slideshow-control--previous,
  .best-sellers-slider .slideshow-control.slideshow-control--shape-square.slideshow-control--previous {
    background-color: transparent;
    border: 1.5px solid var(--best-sellers-slider-arrow-outline);
    color: var(--best-sellers-slider-arrow-outline);
  }

  .best-sellers-slider .slideshow-control:disabled {
    opacity: 0.4;
  }

  @media screen and (max-width: 749px) {
    .best-sellers-slider .slideshow-control.slideshow-control--shape-circle,
    .best-sellers-slider .slideshow-control.slideshow-control--shape-square {
      width: 3rem;
      height: 3rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.best_sellers_slider",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection",
      "info": "t:info.best_sellers_collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:settings.product_count",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.best_sellers_heading"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:settings.heading_color",
      "default": "#BCA588"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "t:settings.heading_size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "t:settings.size_mobile",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "range",
      "id": "slides_per_view",
      "label": "t:settings.items_to_show",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "mobile_card_width",
      "label": "t:settings.mobile_card_width",
      "min": 160,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 250
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:settings.image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "landscape",
          "label": "t:options.landscape"
        }
      ],
      "default": "square"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "t:settings.border_color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "card_border_width",
      "label": "t:settings.border_width",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "range",
      "id": "card_corner_radius",
      "label": "t:settings.corner_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "card_shadow",
      "label": "t:settings.drop_shadow",
      "default": true
    },
    {
      "type": "color",
      "id": "badge_background_color",
      "label": "t:settings.badge_sale_background_color",
      "default": "#BF092F"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "t:settings.badge_sale_text_color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "t:settings.card_title_color",
      "default": "#F6F4F0"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "t:settings.title_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "t:settings.card_subtitle_color",
      "default": "#D4C7B4"
    },
    {
      "type": "range",
      "id": "subtitle_font_size",
      "label": "t:settings.subtitle_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "t:settings.price_color",
      "default": "#F6F4F0"
    },
    {
      "type": "color",
      "id": "compare_price_color",
      "label": "t:settings.compare_price_color",
      "default": "#BCA588"
    },
    {
      "type": "range",
      "id": "price_font_size",
      "label": "t:settings.price_size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:content.carousel_navigation"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrows"
        },
        {
          "value": "chevron",
          "label": "t:options.chevrons"
        },
        {
          "value": "arrows_large",
          "label": "t:options.arrows_large"
        },
        {
          "value": "chevron_large",
          "label": "t:options.chevron_large"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "arrow"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "t:settings.icon_background",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "circle",
          "label": "t:options.circle"
        },
        {
          "value": "square",
          "label": "t:options.square"
        }
      ],
      "default": "square",
      "visible_if": "{{ section.settings.icons_style != 'none' }}"
    },
    {
      "type": "color",
      "id": "arrow_background_color",
      "label": "t:settings.arrow_background_color",
      "default": "#A3835F",
      "visible_if": "{{ section.settings.icons_style != 'none' and section.settings.icons_shape != 'none' }}"
    },
    {
      "type": "color",
      "id": "arrow_icon_color",
      "label": "t:settings.arrow_icon_color",
      "default": "#121212",
      "visible_if": "{{ section.settings.icons_style != 'none' }}"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:settings.autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "t:settings.speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5,
      "visible_if": "{{ section.settings.autoplay }}"
    },
    {
      "type": "header",
      "content": "t:content.padding_desktop"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 120
    },
    {
      "type": "header",
      "content": "t:content.padding_mobile"
    },
    {
      "type": "range",
      "id": "padding_inline_start_mobile",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_inline_end_mobile",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "t:names.best_sellers_slider",
      "category": "t:categories.products",
      "settings": {
        "collection": "",
        "max_products": 8
      }
    }
  ]
}
{% endschema %}



{% liquid
  if section.settings.background_color != blank or section.settings.text_color != blank
    render 'contrast-override', background_color: section.settings.background_color, text_color: section.settings.text_color, section_id: section.id, skip_contrast: true
  endif
%}

<section
  id="BenefitsMarquee-{{ section.id }}"
  class="benefits-marquee{% if section.settings.background_color != blank or section.settings.text_color != blank %} color-custom-{{ section.id }}{% endif %}"
  role="region"
  aria-label="{{ section.settings.heading | default: 'Store benefits' }}"
>
  {%- if section.blocks.size > 0 -%}
    <script
      src="{{ 'marquee.js' | asset_url }}"
      type="module"
      fetchpriority="low"
    ></script>
    <div
      class="benefits-marquee__inner spacing-style"
      style="{% render 'spacing-style', settings: section.settings %}"
    >
      <marquee-component
        class="benefits-marquee__marquee"
        style="
          --benefits-marquee-direction: {{ section.settings.direction }};
          --benefits-marquee-gap: {{ section.settings.gap }}px;
          --benefits-marquee-icon-height: clamp(1.5rem, calc({{ section.settings.icon_height }}px * 0.6), {{ section.settings.icon_height }}px);
          --benefits-marquee-text-size: clamp(0.875rem, calc({{ section.settings.text_size }}px * 0.55), {{ section.settings.text_size }}px);
        "
        data-speed-factor="{{ section.settings.speed }}"
        {% unless section.settings.autoplay %}
          data-disabled
        {% endunless %}
      >
        <div
          class="benefits-marquee__wrapper"
          ref="wrapper"
        >
          <div
            class="benefits-marquee__content"
            ref="content"
          >
            <div
              class="benefits-marquee__items"
              ref="marqueeItems[]"
            >
              {% content_for 'blocks' %}
            </div>
          </div>
        </div>
      </marquee-component>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .benefits-marquee {
    position: relative;
    overflow: hidden;
    color: var(--color-foreground);
    background-color: var(--color-background);
  }

  .benefits-marquee__marquee {
    display: block;
    width: 100%;
    overflow: hidden;
  }

  .benefits-marquee__wrapper {
    display: flex;
    align-items: center;
    gap: var(--benefits-marquee-gap, 6rem);
    width: max-content;
  }

  .benefits-marquee__content,
  .benefits-marquee__items {
    display: flex;
    align-items: center;
    gap: var(--benefits-marquee-gap, 6rem);
    min-width: max-content;
  }

  @media (prefers-reduced-motion: no-preference) {
    .benefits-marquee__marquee:not([data-disabled]) .benefits-marquee__wrapper {
      animation: benefits-marquee-scroll var(--marquee-speed, 20s) linear infinite
        var(--benefits-marquee-direction, normal);
    }
  }

  @keyframes benefits-marquee-scroll {
    to {
      transform: translate3d(calc(-50% - (var(--benefits-marquee-gap, 6rem) / 2)), 0, 0);
    }
  }

  @media screen and (max-width: 749px) {
    .benefits-marquee {
      --benefits-marquee-gap: calc(var(--benefits-marquee-gap, 6rem) * 0.5);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.benefits_marquee",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "_benefit-chip"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.marquee"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:settings.autoplay",
      "default": true
    },
    {
      "type": "select",
      "id": "direction",
      "label": "t:settings.motion_direction",
      "options": [
        {
          "value": "reverse",
          "label": "t:options.forward"
        },
        {
          "value": "normal",
          "label": "t:options.reverse"
        }
      ],
      "default": "normal",
      "visible_if": "{{ section.settings.autoplay }}"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.speed",
      "min": 5,
      "max": 60,
      "step": 1,
      "default": 20,
      "visible_if": "{{ section.settings.autoplay }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 16,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "icon_height",
      "label": "t:settings.height",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "t:settings.size",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#002768",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "default": "#D4C7B4",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.benefits_marquee",
      "category": "t:categories.decorative",
      "blocks": {
        "chip_1": {
          "type": "_benefit-chip",
          "settings": {
            "label": "Sustainable"
          }
        },
        "chip_2": {
          "type": "_benefit-chip",
          "settings": {
            "label": "Free Returns"
          }
        },
        "chip_3": {
          "type": "_benefit-chip",
          "settings": {
            "label": "PFAS-Free"
          }
        },
        "chip_4": {
          "type": "_benefit-chip",
          "settings": {
            "label": "100% Toxin-Free"
          }
        },
        "chip_5": {
          "type": "_benefit-chip",
          "settings": {
            "label": "Certified"
          }
        },
        "chip_6": {
          "type": "_benefit-chip",
          "settings": {
            "label": "Antibacterial"
          }
        }
      },
      "block_order": ["chip_1", "chip_2", "chip_3", "chip_4", "chip_5", "chip_6"]
    }
  ]
}
{% endschema %}

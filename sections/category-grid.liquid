

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id, skip_contrast: true
  endif
%}

<section
  id="CategoryGrid-{{ section.id }}"
  class="category-grid{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  role="region"
  aria-label="{{ section.settings.heading | default: 'Shop by category' }}"
>
  <div
    class="category-grid__inner spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="category-grid__top">
      {%- if section.settings.heading != blank -%}
        <h2
          class="category-grid__heading"
          style="
            {% if section.settings.heading_color != blank %}color: {{ section.settings.heading_color }};{% endif %}
            --category-grid-heading-size: {{ section.settings.heading_size }}px;
            --category-grid-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
          "
        >
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        {% render 'button-custom-styles', block_settings: section.settings, block_id: section.id %}
        <a
          {% if section.settings.button_link == blank %}
            role="link"
            aria-disabled="true"
          {% else %}
            href="{{ section.settings.button_link }}"
          {% endif %}
          class="
            category-grid__btn
            category-grid__btn--mobile
            size-style
            {{ section.settings.style_class }}
            {% if section.settings.style_class == 'button-custom' %}button-custom--{{ section.id }}{% endif %}
          "
          style="{% render 'size-style', settings: section.settings %}"
          {%- if section.settings.open_in_new_tab -%}
            target="_blank" rel="noopener noreferrer"
          {%- endif -%}
        >
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>

    <div
      class="category-grid__grid"
      style="
        --category-grid-columns-desktop: {{ section.settings.columns_desktop }};
        --category-grid-columns-mobile: {{ section.settings.columns_mobile }};
        --category-grid-gap: {{ section.settings.gap }}px;
        --category-grid-card-title-size: {{ section.settings.card_title_size }}px;
        --category-grid-card-title-size-mobile: {{ section.settings.card_title_size_mobile }}px;
        {% render 'border-override', settings: section.settings %}
      "
    >
      {% content_for 'blocks' %}
    </div>

    {%- if section.settings.button_label != blank -%}
      <a
        {% if section.settings.button_link == blank %}
          role="link"
          aria-disabled="true"
        {% else %}
          href="{{ section.settings.button_link }}"
        {% endif %}
        class="
          category-grid__btn
          category-grid__btn--desktop
          size-style
          {{ section.settings.style_class }}
          {% if section.settings.style_class == 'button-custom' %}button-custom--{{ section.id }}{% endif %}
        "
        style="{% render 'size-style', settings: section.settings %}"
        {%- if section.settings.open_in_new_tab -%}
          target="_blank" rel="noopener noreferrer"
        {%- endif -%}
      >
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .category-grid {
    position: relative;
    color: var(--color-foreground);
    background-color: var(--color-background);
  }

  .category-grid__inner {
    max-width: 82.5rem;
    margin-inline: auto;
  }

  .category-grid__top {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 3rem;
  }

  .category-grid__heading {
    margin: 0 auto;
    font-size: clamp(1.5rem, calc(var(--category-grid-heading-size, 48px) * 0.55), var(--category-grid-heading-size, 48px));
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-transform: capitalize;
    text-align: center;
  }

  .category-grid__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-decoration: none;
    border: none;
    cursor: pointer;
    width: 100%;
    max-width: 18.75rem;
    padding: 1.125rem;
    border-radius: 1rem;
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: capitalize;
  }

  .category-grid__btn--mobile {
    display: none;
  }

  .category-grid__btn--desktop {
    margin: 3rem auto 0;
  }

  .category-grid__grid {
    display: grid;
    grid-template-columns: repeat(var(--category-grid-columns-desktop, 4), minmax(0, 1fr));
    gap: var(--category-grid-gap, 2rem);
  }

  .category-grid__grid .card {
    background-color: rgb(255 255 255 / 0.06);
  }

  /* The reused theme "text" block bakes its font size into an inline
     --font-size custom property (see snippets/typography-style.liquid), so an
     !important is the only way to make the card title responsive without
     modifying that shared block file. */
  .category-grid__grid .card__inner > .text-block:last-child {
    --font-size: var(--category-grid-card-title-size, 2rem) !important;
  }

  @media screen and (max-width: 749px) {
    .category-grid__top {
      justify-content: space-between;
      margin-bottom: 1.5rem;
    }

    .category-grid__heading {
      margin: 0;
      font-size: var(--category-grid-heading-size-mobile, 24px);
      text-align: left;
    }

    .category-grid__btn {
      max-width: 6.875rem;
      padding: 0.625rem;
      border-radius: 0.5rem;
      font-size: 1rem;
    }

    .category-grid__btn--mobile {
      display: flex;
    }

    .category-grid__btn--desktop {
      display: none;
    }

    .category-grid__grid {
      grid-template-columns: repeat(var(--category-grid-columns-mobile, 2), minmax(0, 1fr));
    }

    .category-grid__grid .card__inner > .text-block:last-child {
      --font-size: var(--category-grid-card-title-size-mobile, 1.25rem) !important;
    }
  }
{% endstylesheet %}

{% schema %}

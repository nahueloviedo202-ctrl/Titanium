{%- liquid
  assign using_video_tag = false
  if section.settings.video_shopify != blank
    assign using_video_tag = true
  endif

  if section.settings.placeholder_image
    assign placeholder_image = section.settings.placeholder_image
  elsif section.settings.video_shopify
    assign placeholder_image = section.settings.video_shopify.preview_image
  endif

  assign has_video = false
  if section.settings.video_shopify != blank or section.settings.video_external != blank
    assign has_video = true
  endif
-%}

<link rel="stylesheet" href="{{ 'video-cta-banner.css' | asset_url }}" {%- render 'lazy-stylesheet-attrs' %}>
{%- if has_video -%}
  <link rel="stylesheet" href="{{ 'video.css' | asset_url }}" {%- render 'lazy-stylesheet-attrs' %}>
  <script src="{{ 'video.js' | asset_url }}" defer></script>
{%- endif -%}

<div id="section-id-{{ section.id }}" class="video-cta-banner{% if section.settings.color_scheme != 'default' %} use-color-scheme use-color-scheme--{{ section.settings.color_scheme }}{% endif %}" {%- render 'animation-attrs', attrs: 'data-cc-animate' -%}>
  {%- if section.settings.accent_color.alpha > 0 -%}
    {% style %}
      #section-id-{{ section.id }} { --accent-color: {{ section.settings.accent_color }}; }
    {% endstyle %}
  {%- endif -%}

  <div class="video-cta-banner__inner">
    <div class="video-cta-banner__media" {%- render 'animation-attrs', attrs: 'data-cc-animate' -%}>
      {%- if has_video -%}
        <div class="{% unless using_video_tag %}video-section__bg-iframe-video{% endunless %}">
          <deferred-media>
            <template>
              <video-component class="{% if using_video_tag %}has-video{% else %}has-iframe{% endif %}"
                {%- unless using_video_tag %} data-video-url="{{ section.settings.video_external | escape }}"{% endunless %}
                              data-video-id="{{ section.id }}"
                              data-autoplay="true"
                              data-background="true"
                              data-description="{{ section.settings.video_description | escape }}">
                {%- if using_video_tag -%}
                  {{ section.settings.video_shopify | video_tag: playsinline: true, autoplay: true, muted: true, loop: true, poster: '' | replace: '<img ', '<img loading="lazy" hidden ' }}
                {%- else -%}
                  <div></div>
                {%- endif -%}
              </video-component>
            </template>
          </deferred-media>
        </div>
      {%- endif -%}

      {%- if placeholder_image -%}
        {%- render 'image' with placeholder_image, class: 'video-played-hidden', custom_aspect_ratio: 1.544 -%}
      {%- else -%}
        <div class="placeholder-image video-played-hidden">{{- 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' -}}</div>
      {%- endif -%}
    </div>

    <div class="video-cta-banner__copy" {%- render 'animation-attrs', attrs: 'data-cc-animate data-cc-animate-delay="0.1s"' -%}>
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            {%- if block.settings.use_h1 -%}
              <h1 class="video-cta-banner__heading" {{ block.shopify_attributes }}>{% render 'multiline-text' with block.settings.title %}</h1>
            {%- else -%}
              <h2 class="video-cta-banner__heading" {{ block.shopify_attributes }}>{% render 'multiline-text' with block.settings.title %}</h2>
            {%- endif -%}

          {%- when 'text' -%}
            <div class="video-cta-banner__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

          {%- when 'button' -%}
            {%- if block.settings.button_label != blank -%}
              {%- assign button_class = 'video-cta-banner__button' -%}
              {%- if block.settings.button_style == 'secondary' -%}
                {%- assign button_class = button_class | append: ' video-cta-banner__button--secondary' -%}
              {%- endif -%}
              <div class="video-cta-banner__buttons">
                {%- if block.settings.button_link != blank -%}
                  <a href="{{ block.settings.button_link }}" class="{{ button_class }}" {{ block.shopify_attributes }}>{{ block.settings.button_label | escape }}</a>
                {%- else -%}
                  <span class="{{ button_class }}" {{ block.shopify_attributes }}>{{ block.settings.button_label | escape }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}

        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Video CTA banner",
  "class": "section-video-cta-banner",
  "disabled_on": {
    "groups": [
      "aside"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "id": "video_shopify",
      "type": "video",
      "label": "Video upload",
      "info": "Hosted by Shopify. Replaces External video if both are set."
    },
    {
      "id": "video_external",
      "type": "text",
      "label": "External video",
      "info": "Supports YouTube and Vimeo."
    },
    {
      "type": "text",
      "id": "video_description",
      "label": "Video description",
      "info": "Describe the video for customers using screen readers. [Learn more](https://help.shopify.com/manual/online-store/themes/theme-structure/theme-features#video-block)"
    },
    {
      "id": "placeholder_image",
      "type": "image_picker",
      "label": "Cover image",
      "info": "Shows while the video is loading, or if it cannot autoplay. 16:9 recommended."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "1",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Heading accent color",
      "info": "Leave blank to use the section's heading color.",
      "default": "#BCA588"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "See It In Action"
        },
        {
          "type": "checkbox",
          "id": "use_h1",
          "label": "Set as primary page heading",
          "info": "Use <h1> tag. One per page recommended. [Read more](https://cleancanvas.co.uk/support/symmetry/section-h1-setting)",
          "default": false
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Add a short paragraph that builds trust and explains what makes your product different.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "default": "primary",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video CTA banner",
      "category": "Video",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}

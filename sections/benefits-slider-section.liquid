

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<section
  id="BenefitsSliderSection-{{ section.id }}"
  class="benefits-slider{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  role="region"
  aria-label="{% if section.settings.heading != blank %}{{ section.settings.heading | strip_html }}{% else %}{{ 'accessibility.benefits_slider_region' | t }}{% endif %}"
>
  <div
    class="benefits-slider__inner"
    style="
      --bs-max-width: {{ section.settings.content_max_width }}px;
      --bs-padding-block-start: {{ section.settings.padding_block_start }}px;
      --bs-padding-block-end: {{ section.settings.padding_block_end }}px;
      --bs-padding-inline-start: {{ section.settings.padding_inline_start }}px;
      --bs-padding-inline-end: {{ section.settings.padding_inline_end }}px;
      --bs-padding-block-start-mobile: {{ section.settings.padding_block_start_mobile }}px;
      --bs-padding-block-end-mobile: {{ section.settings.padding_block_end_mobile }}px;
      --bs-padding-inline-start-mobile: {{ section.settings.padding_inline_start_mobile }}px;
      --bs-padding-inline-end-mobile: {{ section.settings.padding_inline_end_mobile }}px;
    "
  >
    {%- if section.settings.heading != blank -%}
      <h2
        class="benefits-slider__heading"
        style="
          color: {{ section.settings.heading_color }};
          --bs-heading-size: {{ section.settings.heading_font_size }}px;
          --bs-heading-size-mobile: {{ section.settings.heading_font_size_mobile }}px;
        "
      >
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      {% capture slides %}
        {% content_for 'blocks' %}
      {% endcapture %}

      <div
        class="benefits-slider__carousel-wrapper"
        style="
          --bs-columns: {{ section.settings.slides_per_view }};
          --bs-gap: {{ section.settings.gap }}px;
          --bs-gap-mobile: {{ section.settings.gap_mobile }}px;
          --bs-mobile-width: {{ section.settings.mobile_card_width }}px;
        "
      >
        {% render 'slideshow',
          ref: 'benefitsSlider',
          class: 'benefits-slider__slideshow',
          slides: slides,
          show_arrows: false,
          infinite: false,
          autoplay: section.settings.autoplay,
          autoplay_speed: section.settings.autoplay_speed,
          slide_count: section.blocks.size
        %}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .benefits-slider {
    position: relative;
    background-color: var(--color-background);
    color: var(--color-foreground);
    overflow-x: clip;
  }

  .benefits-slider__inner {
    max-width: var(--bs-max-width, 1800px);
    margin-inline: auto;
    padding-block: var(--bs-padding-block-start, 0) var(--bs-padding-block-end, 0);
    padding-inline: var(--bs-padding-inline-start, 0) var(--bs-padding-inline-end, 0);
  }

  .benefits-slider__heading {
    margin: 0 0 48px;
    font-family: var(--font-body--family);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-transform: capitalize;
    font-size: var(--bs-heading-size, 48px);
  }

  .benefits-slider__slideshow {
    container-type: inline-size;
    container-name: benefits-slider;
  }

  .benefits-slider__slideshow slideshow-slides {
    --slideshow-gap: var(--bs-gap, 32px);
    /* Extra block padding keeps card shadows/borders from clipping while scrolling. */
    margin-block: -1rem;
    padding-block: 1rem;
  }

  /* The base slideshow component collapses inactive slides (content-visibility: hidden)
     to save render cost, so the scroller's stretched height is driven only by the
     visible card(s). Since title/text wrap to different line counts, that made the
     whole section resize on slide change. Keeping all slides rendered makes the
     section height stable at the tallest card. */
  .benefits-slider slideshow-slide {
    content-visibility: visible !important;
  }

  @media screen and (max-width: 749px) {
    .benefits-slider__inner {
      padding-block: var(--bs-padding-block-start-mobile, 0) var(--bs-padding-block-end-mobile, 0);
      padding-inline: var(--bs-padding-inline-start-mobile, 0) var(--bs-padding-inline-end-mobile, 0);
    }

    .benefits-slider__heading {
      margin-bottom: 32px;
      font-size: var(--bs-heading-size-mobile, 24px);
    }

    .benefits-slider__slideshow slideshow-slides {
      --slideshow-gap: var(--bs-gap-mobile, 16px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.benefits_slider_section",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "_benefits-slider-card"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.benefits_slider_heading"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:settings.heading_color",
      "default": "#D4C7B4"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "t:settings.heading_size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "t:settings.size_mobile",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "t:settings.width",
      "min": 1200,
      "max": 2400,
      "step": 20,
      "unit": "px",
      "default": 1800
    },
    {
      "type": "range",
      "id": "slides_per_view",
      "label": "t:settings.items_to_show",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "mobile_card_width",
      "label": "t:settings.mobile_card_width",
      "min": 160,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 240
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "t:settings.gap",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "t:settings.border_color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "t:settings.card_title_color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "t:settings.text_color",
      "default": "#B0B0B0"
    },
    {
      "type": "range",
      "id": "card_corner_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "t:content.carousel_navigation"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:settings.autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "t:settings.speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5,
      "visible_if": "{{ section.settings.autoplay }}"
    },
    {
      "type": "header",
      "content": "t:content.padding_desktop"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_inline_start",
      "label": "t:settings.left",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_inline_end",
      "label": "t:settings.right",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "header",
      "content": "t:content.padding_mobile"
    },
    {
      "type": "range",
      "id": "padding_block_start_mobile",
      "label": "t:settings.top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_block_end_mobile",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_inline_start_mobile",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_inline_end_mobile",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.benefits_slider_section",
      "category": "t:categories.storytelling",
      "blocks": {
        "benefit_1": {
          "type": "_benefits-slider-card",
          "settings": {
            "image_position": "top",
            "title": "t:text_defaults.benefits_slider_card_title_1",
            "text": "t:text_defaults.benefits_slider_card_text_1"
          }
        },
        "benefit_2": {
          "type": "_benefits-slider-card",
          "settings": {
            "image_position": "bottom",
            "title": "t:text_defaults.benefits_slider_card_title_2",
            "text": "t:text_defaults.benefits_slider_card_text_2"
          }
        },
        "benefit_3": {
          "type": "_benefits-slider-card",
          "settings": {
            "image_position": "top",
            "title": "t:text_defaults.benefits_slider_card_title_3",
            "text": "t:text_defaults.benefits_slider_card_text_3"
          }
        },
        "benefit_4": {
          "type": "_benefits-slider-card",
          "settings": {
            "image_position": "bottom",
            "title": "t:text_defaults.benefits_slider_card_title_4",
            "text": "t:text_defaults.benefits_slider_card_text_4"
          }
        },
        "benefit_5": {
          "type": "_benefits-slider-card",
          "settings": {
            "image_position": "top",
            "title": "t:text_defaults.benefits_slider_card_title_5",
            "text": "t:text_defaults.benefits_slider_card_text_5"
          }
        }
      },
      "block_order": ["benefit_1", "benefit_2", "benefit_3", "benefit_4", "benefit_5"]
    }
  ]
}
{% endschema %}

{% liquid
  assign show_video = false
  if section.settings.media_type == 'video' and section.settings.video != blank
    assign show_video = true
    assign video_style = 'aspect-ratio: ' | append: section.settings.video.aspect_ratio
  elsif section.settings.image != blank
    assign image_style = 'aspect-ratio: ' | append: section.settings.image.aspect_ratio
  endif
%}

<section
  id="ScienceStickyVideo-{{ section.id }}"
  class="science-sticky-video{% if section.settings.media_position == 'left' %} science-sticky-video--media-left{% endif %}"
  role="region"
  aria-label="{% if section.settings.heading != blank %}{{ section.settings.heading | strip_html }}{% else %}{{ 'accessibility.science_sticky_video_region' | t }}{% endif %}"
  style="
    --science-sticky-video-bg: {{ section.settings.background_color }};
    --science-sticky-video-heading-color: {{ section.settings.heading_color }};
    --science-sticky-video-body-color: {{ section.settings.body_color }};
    --science-sticky-video-emphasis-color: {{ section.settings.emphasis_color }};
    --science-sticky-video-accent-color: {{ section.settings.accent_color }};
    --science-sticky-video-media-width: {{ section.settings.media_width }}px;
    --science-sticky-video-media-height-mobile: {{ section.settings.media_height_mobile }}px;
    --science-sticky-video-content-max-width: {{ section.settings.content_max_width }}px;
    --science-sticky-video-block-spacing: {{ section.settings.block_spacing }}px;
    --science-sticky-video-bottom-spacing: {{ section.settings.content_bottom_spacing }}px;
    --science-sticky-video-padding-block-start: {{ section.settings.padding_block_start }}px;
    --science-sticky-video-padding-block-end: {{ section.settings.padding_block_end }}px;
    --science-sticky-video-padding-inline-start: {{ section.settings.padding_inline_start }}px;
    --science-sticky-video-padding-inline-end: {{ section.settings.padding_inline_end }}px;
    --science-sticky-video-padding-block-start-mobile: {{ section.settings.padding_block_start_mobile }}px;
    --science-sticky-video-padding-block-end-mobile: {{ section.settings.padding_block_end_mobile }}px;
    --science-sticky-video-padding-inline-start-mobile: {{ section.settings.padding_inline_start_mobile }}px;
    --science-sticky-video-padding-inline-end-mobile: {{ section.settings.padding_inline_end_mobile }}px;
  "
>
  <div class="science-sticky-video__grid">
    <div class="science-sticky-video__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="science-sticky-video__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.kicker != blank -%}
        <p class="science-sticky-video__kicker">{{ section.settings.kicker }}</p>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="science-sticky-video__intro rte">{{ section.settings.intro }}</div>
      {%- endif -%}

      {% content_for 'blocks' %}
    </div>

    <div class="science-sticky-video__media">
      <div class="science-sticky-video__sticky">
        {%- if show_video -%}
          {{
            section.settings.video
            | video_tag:
              poster: nil,
              autoplay: true,
              loop: true,
              controls: false,
              muted: true,
              image_size: '1600x',
              class: 'science-sticky-video__media-el',
              style: video_style
          }}
        {%- elsif section.settings.image != blank -%}
          <img
            class="science-sticky-video__media-el"
            src="{{ section.settings.image | image_url: width: 1600 }}"
            srcset="
              {{- section.settings.image | image_url: width: 700 }} 700w,
              {{ section.settings.image | image_url: width: 1200 }} 1200w,
              {{ section.settings.image | image_url: width: 1600 }} 1600w
            "
            sizes="(min-width: 750px) 45vw, 100vw"
            alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            style="{{ image_style }}"
            loading="lazy"
          >
        {%- else -%}
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'science-sticky-video__media-el' }}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .science-sticky-video {
    --science-sticky-video-scale: 1;
    position: relative;
    background-color: var(--science-sticky-video-bg, #000);
    color: var(--science-sticky-video-body-color, #d6d6d6);
    padding-block: var(--science-sticky-video-padding-block-start-mobile, 0) var(--science-sticky-video-padding-block-end-mobile, 0);
  }

  .science-sticky-video__grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas: 'media' 'content';
    align-items: start;
  }

  .science-sticky-video__content {
    grid-area: content;
    padding-inline: var(--science-sticky-video-padding-inline-start-mobile, 16px) var(--science-sticky-video-padding-inline-end-mobile, 16px);
  }

  .science-sticky-video__media {
    grid-area: media;
    margin-top: var(--header-group-height, 0px);
  }

  .science-sticky-video__heading {
    margin: 0 0 16px;
    color: var(--science-sticky-video-heading-color, #fff);
    font-family: var(--font-heading--family, var(--font-body--family));
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0.02em;
    text-transform: capitalize;
    font-size: 48px;
  }

  .science-sticky-video__kicker {
    margin: 0 0 32px;
    color: var(--science-sticky-video-heading-color, #fff);
    font-family: var(--font-body--family);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.02em;
    text-transform: capitalize;
    font-size: 20px;
  }

  .science-sticky-video__intro {
    font-family: var(--font-body--family);
  }

  .science-sticky-video__intro p {
    margin: 0 0 12px;
    color: var(--science-sticky-video-body-color, #b0b0b0);
    font-size: 14px;
    line-height: 1.5;
    letter-spacing: 0.02em;
  }

  .science-sticky-video__intro p:last-child {
    margin-bottom: 32px;
    color: var(--science-sticky-video-emphasis-color, #e7e7e7);
    font-weight: 500;
    font-size: 16px;
    line-height: 1.4;
    text-transform: capitalize;
  }

  .science-sticky-video__block {
    margin-top: 40px;
    max-width: var(--science-sticky-video-content-max-width, 700px);
  }

  .science-sticky-video__block:last-child {
    padding-bottom: 0;
  }

  .science-sticky-video__block-title {
    margin: 0 0 16px;
    color: var(--science-sticky-video-accent-color, #bca588);
    font-family: var(--font-heading--family, var(--font-body--family));
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0.02em;
    text-transform: capitalize;
    font-size: 24px;
  }

  .science-sticky-video__block-text {
    color: var(--science-sticky-video-body-color, #b0b0b0);
    font-family: var(--font-body--family);
    line-height: 1.5;
    letter-spacing: 0.02em;
    font-size: 14px;
  }

  .science-sticky-video__block-text p {
    margin: 0 0 12px;
  }

  .science-sticky-video__block-text p:last-child {
    margin-bottom: 0;
  }

  .science-sticky-video__sticky {
    position: relative;
    width: 100%;
    height: var(--science-sticky-video-media-height-mobile, 323px);
    overflow: hidden;
  }

  .science-sticky-video__media-el {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (min-width: 750px) {
    .science-sticky-video {
      padding-block: var(--science-sticky-video-padding-block-start, 0) var(--science-sticky-video-padding-block-end, 0);
      padding-inline: var(--science-sticky-video-padding-inline-start, 120px) var(--science-sticky-video-padding-inline-end, 80px);
    }

    .science-sticky-video__content {
      padding-inline: 0;
    }

    .science-sticky-video__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, min(calc(var(--science-sticky-video-media-width, 893px) * var(--science-sticky-video-scale)), 45%));
      grid-template-areas: 'content media';
      gap: 0;
    }

    .science-sticky-video--media-left .science-sticky-video__grid {
      grid-template-columns: minmax(0, min(calc(var(--science-sticky-video-media-width, 893px) * var(--science-sticky-video-scale)), 45%)) minmax(0, 1fr);
      grid-template-areas: 'media content';
    }

    .science-sticky-video__heading {
      font-size: calc(64px * var(--science-sticky-video-scale));
    }

    .science-sticky-video__kicker {
      font-size: calc(20px * var(--science-sticky-video-scale));
    }

    .science-sticky-video__intro p {
      font-size: calc(16px * var(--science-sticky-video-scale));
    }

    .science-sticky-video__intro p:last-child {
      font-size: calc(20px * var(--science-sticky-video-scale));
    }

    .science-sticky-video__block {
      margin-top: calc(var(--science-sticky-video-block-spacing, 332px) * var(--science-sticky-video-scale));
      font-size: calc(16px * var(--science-sticky-video-scale));
    }

    .science-sticky-video__block:last-child {
      padding-bottom: calc(var(--science-sticky-video-bottom-spacing, 300px) * var(--science-sticky-video-scale));
    }

    .science-sticky-video__block-title {
      font-size: calc(48px * var(--science-sticky-video-scale));
    }

    .science-sticky-video__block-text {
      font-size: calc(16px * var(--science-sticky-video-scale));
    }

    .science-sticky-video__media {
      align-self: start;
      margin-top: 0;
    }

    .science-sticky-video__sticky {
      position: sticky;
      top: calc(var(--header-group-height, 0px) + 24px);
      height: auto;
      max-height: calc(100svh - var(--header-group-height, 0px) - 48px);
    }

    .science-sticky-video__media-el {
      height: auto;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 1799px) {
    .science-sticky-video {
      --science-sticky-video-scale: 0.9;
    }
  }

  @media screen and (min-width: 2200px) {
    .science-sticky-video {
      --science-sticky-video-scale: 1.3;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.science_sticky_video",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "_science-sticky-video-block"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.science_sticky_video_heading"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:settings.kicker",
      "default": "t:text_defaults.science_sticky_video_kicker"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:settings.text",
      "default": "t:html_defaults.science_sticky_video_intro"
    },
    {
      "type": "header",
      "content": "t:content.media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "t:settings.type",
      "options": [
        { "value": "image", "label": "t:options.image" },
        { "value": "video", "label": "t:options.video" }
      ],
      "default": "video"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:settings.video",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:settings.heading_color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "t:settings.text_color",
      "default": "#B0B0B0"
    },
    {
      "type": "color",
      "id": "emphasis_color",
      "label": "t:settings.emphasis_color",
      "default": "#E7E7E7"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:settings.accent_color",
      "default": "#BCA588"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "t:settings.media_position",
      "options": [
        { "value": "left", "label": "t:options.left" },
        { "value": "right", "label": "t:options.right" }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "t:settings.media_width",
      "min": 400,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "default": 893
    },
    {
      "type": "range",
      "id": "media_height_mobile",
      "label": "t:settings.image_height_mobile",
      "min": 200,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 323
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "t:settings.width",
      "min": 400,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 700
    },
    {
      "type": "range",
      "id": "block_spacing",
      "label": "t:settings.gap",
      "min": 80,
      "max": 480,
      "step": 4,
      "unit": "px",
      "default": 332
    },
    {
      "type": "range",
      "id": "content_bottom_spacing",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 400,
      "step": 4,
      "unit": "px",
      "default": 300
    },
    {
      "type": "header",
      "content": "t:content.padding_desktop"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_inline_start",
      "label": "t:settings.left",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_inline_end",
      "label": "t:settings.right",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "t:content.padding_mobile"
    },
    {
      "type": "range",
      "id": "padding_block_start_mobile",
      "label": "t:settings.top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_block_end_mobile",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_inline_start_mobile",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_inline_end_mobile",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "t:names.science_sticky_video",
      "category": "t:categories.storytelling",
      "blocks": {
        "block_1": {
          "type": "_science-sticky-video-block"
        }
      },
      "block_order": ["block_1"]
    }
  ]
}
{% endschema %}

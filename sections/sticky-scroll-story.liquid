

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign show_video = false
  if section.settings.media_type == 'video' and section.settings.video != blank
    assign show_video = true
    assign video_style = 'aspect-ratio: ' | append: section.settings.video.aspect_ratio
  endif
%}

<section
  id="StickyScrollStory-{{ section.id }}"
  class="sticky-scroll-story{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  role="region"
  aria-label="{% if section.settings.heading != blank %}{{ section.settings.heading | escape }}{% else %}{{ 'accessibility.sticky_scroll_story_region' | t }}{% endif %}"
>
  <div
    class="sticky-scroll-story__wrap{% if section.settings.media_position == 'right' %} sticky-scroll-story--media-right{% endif %}"
    style="
      max-width: {{ section.settings.content_max_width }}px;
      --sticky-scroll-story-padding-block-start: {{ section.settings.padding_block_start }}px;
      --sticky-scroll-story-padding-block-end: {{ section.settings.padding_block_end }}px;
      --sticky-scroll-story-padding-inline-start: {{ section.settings.padding_inline_start }}px;
      --sticky-scroll-story-padding-inline-end: {{ section.settings.padding_inline_end }}px;
      --sticky-scroll-story-padding-block-start-mobile: {{ section.settings.padding_block_start_mobile }}px;
      --sticky-scroll-story-padding-block-end-mobile: {{ section.settings.padding_block_end_mobile }}px;
      --sticky-scroll-story-padding-inline-start-mobile: {{ section.settings.padding_inline_start_mobile }}px;
      --sticky-scroll-story-padding-inline-end-mobile: {{ section.settings.padding_inline_end_mobile }}px;
      --sticky-scroll-story-media-width: {{ section.settings.media_width }}px;
    "
  >
    <div class="sticky-scroll-story__media">
      {%- if show_video -%}
        {{
          section.settings.video
          | video_tag:
            poster: nil,
            autoplay: true,
            loop: true,
            controls: false,
            muted: true,
            image_size: '1600x',
            class: 'sticky-scroll-story__image',
            style: video_style
        }}
      {%- elsif section.settings.image != blank -%}
        <img
          class="sticky-scroll-story__image"
          src="{{ section.settings.image | image_url: width: 1600 }}"
          srcset="
            {{- section.settings.image | image_url: width: 700 }} 700w,
            {{ section.settings.image | image_url: width: 1200 }} 1200w,
            {{ section.settings.image | image_url: width: 1600 }} 1600w
          "
          sizes="(min-width: 750px) 45vw, 90vw"
          alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy"
        >
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'sticky-scroll-story__image' }}
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <script
        src="{{ 'sticky-scroll-story.js' | asset_url }}"
        type="module"
        fetchpriority="low"
      ></script>
      <sticky-scroll-story-component class="sticky-scroll-story__content">
        {% content_for 'blocks' %}
      </sticky-scroll-story-component>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .sticky-scroll-story {
    position: relative;
    color: var(--color-foreground);
    background-color: var(--color-background);
  }

  .sticky-scroll-story__wrap {
    display: grid;
    margin-inline: auto;
    grid-template-columns: 1fr;
    padding-block: var(--sticky-scroll-story-padding-block-start-mobile, 0) var(--sticky-scroll-story-padding-block-end-mobile, 0);
    padding-inline: var(--sticky-scroll-story-padding-inline-start-mobile, 0) var(--sticky-scroll-story-padding-inline-end-mobile, 0);
  }

  @media screen and (min-width: 750px) {
    .sticky-scroll-story__wrap {
      grid-template-columns: minmax(0, 1fr) minmax(0, min(var(--sticky-scroll-story-media-width, 760px), 45%));
      align-items: start;
      gap: 4rem;
      padding-block: var(--sticky-scroll-story-padding-block-start, 0) var(--sticky-scroll-story-padding-block-end, 0);
      padding-inline: var(--sticky-scroll-story-padding-inline-start, 0) var(--sticky-scroll-story-padding-inline-end, 0);
    }

    .sticky-scroll-story--media-right .sticky-scroll-story__media {
      order: 2;
    }
  }

  .sticky-scroll-story__media {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
  }

  @media screen and (min-width: 750px) {
    .sticky-scroll-story__media {
      position: sticky;
      top: calc(var(--header-group-height, 0px) + 2rem);
      max-height: calc(100svh - var(--header-group-height, 0px) - 4rem);
    }
  }

  .sticky-scroll-story__image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .sticky-scroll-story__content {
    display: flex;
    flex-direction: column;
    gap: 6rem;
    padding-block: 2rem;
  }

  @media screen and (max-width: 749px) {
    .sticky-scroll-story__content {
      gap: 3rem;
      padding-block-top: 2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sticky Scroll Story",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "_sticky-scroll-line"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "t:settings.type",
      "options": [
        { "value": "image", "label": "t:options.image" },
        { "value": "video", "label": "t:options.video" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:settings.video",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "t:settings.media_width",
      "min": 400,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 760
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "t:settings.media_position",
      "options": [
        { "value": "left", "label": "t:options.left" },
        { "value": "right", "label": "t:options.right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "t:settings.width",
      "min": 1200,
      "max": 2400,
      "step": 20,
      "unit": "px",
      "default": 1600
    },
    {
      "type": "header",
      "content": "t:content.padding_desktop"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_inline_start",
      "label": "t:settings.left",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_inline_end",
      "label": "t:settings.right",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "header",
      "content": "t:content.padding_mobile"
    },
    {
      "type": "range",
      "id": "padding_block_start_mobile",
      "label": "t:settings.top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_block_end_mobile",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_inline_start_mobile",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_inline_end_mobile",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Sticky Scroll Story",
      "category": "t:categories.storytelling",
      "blocks": {
        "line_1": {
          "type": "_sticky-scroll-line",
          "settings": {
            "heading": "A Story Worth Telling",
            "heading_size": "xl",
            "body": "<p>Introduce the topic with a short, confident line that sets up everything that follows.</p>"
          }
        }
      },
      "block_order": ["line_1"]
    }
  ]
}
{% endschema %}

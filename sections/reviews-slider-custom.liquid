

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id, skip_contrast: true
  endif

  assign show_arrows = true
  if section.settings.icons_style == 'none'
    assign show_arrows = false
  endif
%}

<section
  id="ReviewsSliderCustom-{{ section.id }}"
  class="reviews-slider-custom{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  role="region"
  aria-label="{{ 'accessibility.reviews_slider_custom_region' | t }}"
>
  <div
    class="reviews-slider-custom__inner"
    style="
      max-width: {{ section.settings.content_max_width }}px;
      --review-slider-padding-block-start: {{ section.settings.padding_block_start }}px;
      --review-slider-padding-block-end: {{ section.settings.padding_block_end }}px;
      --review-slider-padding-inline-start: {{ section.settings.padding_inline_start }}px;
      --review-slider-padding-inline-end: {{ section.settings.padding_inline_end }}px;
      --review-slider-padding-block-start-mobile: {{ section.settings.padding_block_start_mobile }}px;
      --review-slider-padding-block-end-mobile: {{ section.settings.padding_block_end_mobile }}px;
      --review-slider-padding-inline-start-mobile: {{ section.settings.padding_inline_start_mobile }}px;
      --review-slider-padding-inline-end-mobile: {{ section.settings.padding_inline_end_mobile }}px;
    "
  >
    {%- if section.settings.heading != blank -%}
      <h2
        class="reviews-slider-custom__heading"
        style="
          color: {{ section.settings.heading_color }};
          --review-slider-heading-size: {{ section.settings.heading_font_size }}px;
          --review-slider-heading-size-mobile: {{ section.settings.heading_font_size_mobile }}px;
        "
      >
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <script
        src="{{ 'materials-comparison.js' | asset_url }}"
        type="module"
        fetchpriority="low"
      ></script>
      <materials-comparison-component
        class="reviews-slider-custom__component"
        style="
          --review-slider-tab-text-color: {{ section.settings.tab_text_color }};
          --review-slider-tab-border-color: {{ section.settings.tab_border_color }};
          --review-slider-tab-active-background: {{ section.settings.tab_active_background_color }};
          --review-slider-tab-active-text-color: {{ section.settings.tab_active_text_color }};
          --review-slider-card-background: {{ section.settings.card_background_color }};
          --review-slider-card-text-color: {{ section.settings.card_text_color }};
          --review-slider-name-color: {{ section.settings.name_color }};
          --review-slider-quote-color: {{ section.settings.quote_color }};
          --review-slider-star-color: {{ section.settings.star_color }};
          --review-slider-card-width: {{ section.settings.card_width }}px;
          --review-slider-mobile-card-width: {{ section.settings.mobile_card_width }}px;
          --review-slider-gap: {{ section.settings.gap }}px;
          --review-slider-arrow-next-background: {{ section.settings.arrow_background_color }};
          --review-slider-arrow-next-color: {{ section.settings.arrow_icon_color }};
          --review-slider-arrow-border-color: {{ section.settings.arrow_border_color }};
        "
      >
        <div class="reviews-slider-custom__layout">
          {% content_for 'blocks' %}

          {%- if show_arrows -%}
            <div class="reviews-slider-custom__arrows reviews-slider-custom__arrows--desktop">
              {% render 'slideshow-arrow', action: 'previous', icon_style: section.settings.icons_style, icon_shape: section.settings.icons_shape %}
              {% render 'slideshow-arrow', action: 'next', icon_style: section.settings.icons_style, icon_shape: section.settings.icons_shape %}
            </div>
          {%- endif -%}
        </div>

        {%- if show_arrows -%}
          <div class="reviews-slider-custom__arrows reviews-slider-custom__arrows--mobile">
            {% render 'slideshow-arrow', action: 'previous', icon_style: section.settings.icons_style, icon_shape: section.settings.icons_shape %}
            {% render 'slideshow-arrow', action: 'next', icon_style: section.settings.icons_style, icon_shape: section.settings.icons_shape %}
          </div>
        {%- endif -%}
      </materials-comparison-component>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .reviews-slider-custom {
    position: relative;
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .reviews-slider-custom__inner {
    margin-inline: auto;
    padding-block: var(--review-slider-padding-block-start-mobile, 0) var(--review-slider-padding-block-end-mobile, 0);
    padding-inline: var(--review-slider-padding-inline-start-mobile, 0) var(--review-slider-padding-inline-end-mobile, 0);
  }

  .reviews-slider-custom__heading {
    margin: 0 0 3rem;
    color: var(--review-slider-heading-color, #bca588);
    font-family: var(--font-body--family);
    font-weight: 400;
    line-height: var(--line-height--display-loose);
    letter-spacing: var(--letter-spacing--display-loose);
    text-transform: capitalize;
    text-align: center;
    font-size: var(--review-slider-heading-size-mobile, 24px);
  }

  .reviews-slider-custom__component {
    display: block;
  }

  .reviews-slider-custom__layout {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    column-gap: 12px;
    row-gap: 0;
  }

  .review-slider-custom__tab {
    order: 1;
    appearance: none;
    padding: 10px 20px;
    background: transparent;
    color: var(--review-slider-tab-text-color, #b0b0b0);
    border: 1.5px solid var(--review-slider-tab-border-color, #454545);
    border-inline-start: 0;
    flex: 0 1 343px;
    font-family: var(--font-body--family);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.02em;
    text-align: center;
    text-transform: capitalize;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .review-slider-custom__tab:first-of-type {
    border-inline-start: 1.5px solid var(--review-slider-tab-border-color, #454545);
    border-start-start-radius: 12px;
    border-end-start-radius: 12px;
  }

  .review-slider-custom__tab:last-of-type {
    border-start-end-radius: 12px;
    border-end-end-radius: 12px;
  }

  .review-slider-custom__tab[aria-selected='true'] {
    background: var(--review-slider-tab-active-background, #a3835f);
    color: var(--review-slider-tab-active-text-color, #121212);
  }

  .reviews-slider-custom__arrows {
    display: flex;
    gap: 12px;
    flex: 0 0 auto;
  }

  .reviews-slider-custom__arrows--desktop {
    display: none;
    order: 2;
    margin-inline-start: auto;
  }

  .reviews-slider-custom__arrows--mobile {
    width: 100%;
    justify-content: center;
    margin-top: 2rem;
  }

  .reviews-slider-custom__arrows .slideshow-control {
    opacity: 1;
    min-height: 0;
    min-width: 0;
    padding: 0;
  }

  .reviews-slider-custom__arrows .slideshow-control.slideshow-control--shape-circle,
  .reviews-slider-custom__arrows .slideshow-control.slideshow-control--shape-square {
    width: 48px;
    height: 48px;
    border-radius: 12px;
  }

  .reviews-slider-custom__arrows .slideshow-control.slideshow-control--previous {
    background: transparent;
    border: 1.5px solid var(--review-slider-arrow-border-color, #454545);
    color: var(--review-slider-arrow-border-color, #454545);
  }

  .reviews-slider-custom__arrows .slideshow-control.slideshow-control--next {
    background: var(--review-slider-arrow-next-background, #a3835f);
    color: var(--review-slider-arrow-next-color, #121212);
  }

  @media screen and (max-width: 749px) {
    .review-slider-custom__tab {
      flex: 0 1 50%;
      font-size: 14px;
    }
  }

  @media screen and (min-width: 750px) {
    .reviews-slider-custom__inner {
      padding-block: var(--review-slider-padding-block-start, 0) var(--review-slider-padding-block-end, 0);
      padding-inline: var(--review-slider-padding-inline-start, 0) var(--review-slider-padding-inline-end, 0);
    }

    .reviews-slider-custom__heading {
      text-align: left;
      font-size: var(--review-slider-heading-size, 48px);
    }

    .reviews-slider-custom__arrows--desktop {
      display: flex;
    }

    .reviews-slider-custom__arrows--mobile {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.reviews_slider_custom",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "_review-slider-category"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "5,000+ 5-Star Reviews"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:settings.heading_color",
      "default": "#BCA588"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "t:settings.heading_size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "t:settings.size_mobile",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "tab_text_color",
      "label": "t:settings.text_color",
      "default": "#B0B0B0"
    },
    {
      "type": "color",
      "id": "tab_border_color",
      "label": "t:settings.border_color",
      "default": "#454545"
    },
    {
      "type": "color",
      "id": "tab_active_background_color",
      "label": "t:settings.background_color",
      "default": "#A3835F"
    },
    {
      "type": "color",
      "id": "tab_active_text_color",
      "label": "t:settings.text_color",
      "default": "#121212"
    },
    {
      "type": "header",

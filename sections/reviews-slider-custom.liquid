  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "_review-slider-category"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "5,000+ 5-Star Reviews"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:settings.heading_color",
      "default": "#BCA588"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "t:settings.heading_size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "t:settings.size_mobile",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "tab_text_color",
      "label": "t:settings.text_color",
      "default": "#B0B0B0"
    },
    {
      "type": "color",
      "id": "tab_border_color",
      "label": "t:settings.border_color",
      "default": "#454545"
    },
    {
      "type": "color",
      "id": "tab_active_background_color",
      "label": "t:settings.background_color",
      "default": "#A3835F"
    },
    {
      "type": "color",
      "id": "tab_active_text_color",
      "label": "t:settings.text_color",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "t:content.cards_layout"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "t:settings.background_color",
      "default": "#F6F4F0"
    },
    {
      "type": "color",
      "id": "name_color",
      "label": "t:settings.text_color",
      "default": "#2C1F1C"
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "t:settings.text_color",
      "default": "#252525"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "t:settings.star_color",
      "default": "#B57C46"
    },
    {
      "type": "header",
      "content": "t:content.carousel_navigation"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "t:settings.width",
      "min": 240,
      "max": 480,
      "step": 4,
      "unit": "px",
      "default": 324

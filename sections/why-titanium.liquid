

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id, skip_contrast: true
  endif

  assign image = section.settings.image
  assign image_width_wide = section.settings.image_width | times: 1.3 | round
  assign image_width_desktop = section.settings.image_width | times: 0.9 | round
  assign sizes_attribute = '(min-width: 2200px) [wide]px, (min-width: 750px) [desktop]px, 100vw'
  assign sizes_attribute = sizes_attribute | replace: '[wide]', image_width_wide
  assign sizes_attribute = sizes_attribute | replace: '[desktop]', image_width_desktop
%}

<section
  id="WhyTitanium-{{ section.id }}"
  class="
    why-titanium
    {% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}
    {% if section.settings.media_position == 'right' %} why-titanium--media-right{% endif %}
  "
  role="region"
  aria-label="{% if section.settings.heading != blank %}{{ section.settings.heading | strip_html }}{% else %}{{ 'accessibility.why_titanium_region' | t }}{% endif %}"
>
  <div
    class="why-titanium__wrap"
    style="
      --why-titanium-img-w: {{ section.settings.image_width }}px;
      --why-titanium-img-h: {{ section.settings.image_height }}px;
      --why-titanium-img-h-mobile: {{ section.settings.image_height_mobile }}px;
      --why-titanium-gap: {{ section.settings.gap }}px;
      --why-titanium-gap-mobile: {{ section.settings.gap_mobile }}px;
      --why-titanium-copy-max-width: {{ section.settings.content_max_width }}px;
      --why-titanium-heading-color: {{ section.settings.heading_color }};
      --why-titanium-heading-size: {{ section.settings.heading_font_size }}px;
      --why-titanium-heading-size-mobile: {{ section.settings.heading_font_size_mobile }}px;
      --why-titanium-kicker-color: {{ section.settings.kicker_color }};
      --why-titanium-kicker-size: {{ section.settings.kicker_font_size }}px;
      --why-titanium-kicker-size-mobile: {{ section.settings.kicker_font_size_mobile }}px;
      --why-titanium-body-color: {{ section.settings.body_color }};
      --why-titanium-body-size: {{ section.settings.body_font_size }}px;
      --why-titanium-body-size-mobile: {{ section.settings.body_font_size_mobile }}px;
      --why-titanium-accent-color: {{ section.settings.body_accent_color }};
      --why-titanium-padding-block-start: {{ section.settings.padding_block_start }}px;
      --why-titanium-padding-block-end: {{ section.settings.padding_block_end }}px;
      --why-titanium-padding-inline-start: {{ section.settings.padding_inline_start }}px;
      --why-titanium-padding-inline-end: {{ section.settings.padding_inline_end }}px;
      --why-titanium-padding-block-start-mobile: {{ section.settings.padding_block_start_mobile }}px;
      --why-titanium-padding-block-end-mobile: {{ section.settings.padding_block_end_mobile }}px;
      --why-titanium-padding-inline-start-mobile: {{ section.settings.padding_inline_start_mobile }}px;
      --why-titanium-padding-inline-end-mobile: {{ section.settings.padding_inline_end_mobile }}px;
    "
  >
    <div class="why-titanium__inner">
      <div class="why-titanium__media">
        {%- if image != blank -%}
          {{
            image
            | image_url: width: 1600
            | image_tag:
              widths: '400, 600, 800, 1200, 1600',
              sizes: sizes_attribute,
              loading: 'lazy',
              class: 'why-titanium__image',
              alt: image.alt | default: section.settings.heading | escape
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'why-titanium__image placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="why-titanium__copy">
        {%- if section.settings.heading != blank -%}
          <h2 class="why-titanium__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.kicker != blank -%}
          <p class="why-titanium__kicker">{{ section.settings.kicker }}</p>
        {%- endif -%}

        {%- if section.settings.body_text != blank -%}
          <div class="why-titanium__body rte">{{ section.settings.body_text }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .why-titanium {
    --why-titanium-scale: 1;
    position: relative;
    background-color: var(--color-background, #0e2e24);
    color: var(--why-titanium-body-color, #b0b0b0);
  }

  .why-titanium__wrap {
    padding-block: calc(var(--why-titanium-padding-block-start, 0px) * var(--why-titanium-scale)) calc(var(--why-titanium-padding-block-end, 0px) * var(--why-titanium-scale));
    padding-inline: calc(var(--why-titanium-padding-inline-start, 120px) * var(--why-titanium-scale)) calc(var(--why-titanium-padding-inline-end, 80px) * var(--why-titanium-scale));
  }

  .why-titanium__inner {
    display: grid;
    grid-template-columns: calc(var(--why-titanium-img-w, 893px) * var(--why-titanium-scale)) 1fr;
    grid-template-areas: 'media copy';
    align-items: center;
    gap: calc(var(--why-titanium-gap, 0px) * var(--why-titanium-scale));
  }

  .why-titanium--media-right .why-titanium__inner {
    grid-template-columns: 1fr calc(var(--why-titanium-img-w, 893px) * var(--why-titanium-scale));
    grid-template-areas: 'copy media';
  }

  .why-titanium__media {
    grid-area: media;
    display: block;
  }

  .why-titanium__media img,
  .why-titanium__media svg {
    display: block;
    width: 100%;
    height: calc(var(--why-titanium-img-h, 740px) * var(--why-titanium-scale));
    object-fit: cover;
  }

  .why-titanium__copy {
    grid-area: copy;
    display: flex;
    flex-direction: column;
    max-width: calc(var(--why-titanium-copy-max-width, 700px) * var(--why-titanium-scale));
  }

  .why-titanium__heading {
    margin: 0 0 calc(16px * var(--why-titanium-scale));
    color: var(--why-titanium-heading-color, #ffffff);
    font-family: var(--font-body--family);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0.02em;
    text-transform: capitalize;
    font-size: calc(var(--why-titanium-heading-size, 64px) * var(--why-titanium-scale));
  }

  .why-titanium__kicker {
    margin: 0 0 calc(32px * var(--why-titanium-scale));
    color: var(--why-titanium-kicker-color, #ffffff);
    font-family: var(--font-body--family);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.02em;
    text-transform: capitalize;
    font-size: calc(var(--why-titanium-kicker-size, 20px) * var(--why-titanium-scale));
  }

  .why-titanium__body {
    color: var(--why-titanium-body-color, #b0b0b0);
    font-family: var(--font-body--family);
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0.04em;
    font-size: calc(var(--why-titanium-body-size, 16px) * var(--why-titanium-scale));
  }

  .why-titanium__body p {
    margin: 0 0 0.75em;
  }

  .why-titanium__body p:first-child {
    margin-bottom: calc(32px * var(--why-titanium-scale));
  }

  .why-titanium__body p:last-child {
    margin-bottom: 0;
    color: var(--why-titanium-accent-color, #e7e7e7);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.02em;
    text-transform: capitalize;
    font-size: calc(var(--why-titanium-kicker-size, 20px) * var(--why-titanium-scale));
  }

  @media screen and (min-width: 750px) and (max-width: 1799px) {
    .why-titanium {
      --why-titanium-scale: 0.9;
    }
  }

  @media screen and (min-width: 2200px) {
    .why-titanium {
      --why-titanium-scale: 1.3;
    }
  }

  @media screen and (max-width: 749px) {
    .why-titanium__wrap {
      padding-block: var(--why-titanium-padding-block-start-mobile, 32px) var(--why-titanium-padding-block-end-mobile, 64px);
      padding-inline: var(--why-titanium-padding-inline-start-mobile, 16px) var(--why-titanium-padding-inline-end-mobile, 16px);
    }

    .why-titanium__inner,
    .why-titanium--media-right .why-titanium__inner {
      grid-template-columns: 1fr;
      grid-template-areas: 'media' 'copy';
      gap: var(--why-titanium-gap-mobile, 32px);
    }

    .why-titanium__media img,
    .why-titanium__media svg {
      height: var(--why-titanium-img-h-mobile, 323px);
    }

    .why-titanium__copy {
      max-width: none;
    }

    .why-titanium__heading {
      font-size: var(--why-titanium-heading-size-mobile, 48px);
      letter-spacing: 1.82px;
    }

    .why-titanium__kicker {
      margin-bottom: 12px;
      font-size: var(--why-titanium-kicker-size-mobile, 16px);
    }

    .why-titanium__body {
      font-size: var(--why-titanium-body-size-mobile, 14px);
    }

    .why-titanium__body p:first-child {
      margin-bottom: 12px;
    }

    .why-titanium__body p:last-child {
      margin-bottom: 32px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.why_titanium",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.why_titanium_heading"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:settings.heading_color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "t:settings.heading_size",
      "min": 24,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 64



{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id, skip_contrast: true
  endif

  assign desktop_image = section.settings.image
  assign mobile_image = section.settings.image_mobile | default: desktop_image
%}

<section
  id="HeritageText-{{ section.id }}"
  class="
    heritage-text
    heritage-text--align-{{ section.settings.content_alignment }}
    {% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}
  "
  role="region"
  aria-label="{% if section.settings.heading != blank %}{{ section.settings.heading | strip_html }}{% else %}{{ 'accessibility.heritage_text_region' | t }}{% endif %}"
  style="
    --heritage-text-height: {{ section.settings.section_height }}px;
    --heritage-text-content-max-width: {{ section.settings.content_max_width }}px;
    --heritage-text-padding-block: {{ section.settings.content_padding_block }}px;
    --heritage-text-padding-inline: {{ section.settings.content_padding_inline }}px;
    --heritage-text-heading-color: {{ section.settings.heading_color }};
    --heritage-text-accent-color: {{ section.settings.accent_color }};
    --heritage-text-heading-size: {{ section.settings.heading_font_size }}px;
    --heritage-text-heading-size-mobile: {{ section.settings.heading_font_size_mobile }}px;
    --heritage-text-kicker-color: {{ section.settings.kicker_color }};
    --heritage-text-kicker-size: {{ section.settings.kicker_font_size }}px;
    --heritage-text-kicker-size-mobile: {{ section.settings.kicker_font_size_mobile }}px;
    --heritage-text-body-color: {{ section.settings.body_text_color }};
    --heritage-text-body-accent-color: {{ section.settings.body_accent_color }};
    --heritage-text-body-size: {{ section.settings.body_font_size }}px;
    --heritage-text-body-size-mobile: {{ section.settings.body_font_size_mobile }}px;
    --heritage-text-mobile-min-height: {{ section.settings.mobile_min_height }}px;
    --heritage-text-mobile-content-max-width: {{ section.settings.mobile_content_max_width }}px;
    --heritage-text-mobile-padding-block: {{ section.settings.mobile_padding_block }}px;
    --heritage-text-mobile-padding-inline: {{ section.settings.mobile_padding_inline }}px;
  "
>
  <div class="heritage-text__media heritage-text__media--desktop">
    {% render 'background-media', background_media: 'image', background_image: desktop_image, placeholder: 'lifestyle-1', section: section %}
  </div>
  {%- if section.settings.image_mobile != blank -%}
    <div class="heritage-text__media heritage-text__media--mobile">
      {% render 'background-media', background_media: 'image', background_image: mobile_image, placeholder: 'lifestyle-1', section: section %}
    </div>
  {%- endif -%}

  <div class="heritage-text__inner">
    <div class="heritage-text__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="heritage-text__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.kicker != blank -%}
        <p class="heritage-text__kicker">{{ section.settings.kicker }}</p>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="heritage-text__body rte">
          {{ section.settings.body }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .heritage-text {
    --heritage-text-scale: 1;
    position: relative;
    overflow: hidden;
    background-color: var(--color-background, #121212);
    color: var(--heritage-text-heading-color, #F6F4F0);
  }

  .heritage-text__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .heritage-text__media--mobile {
    display: none;
  }

  .heritage-text__inner {
    position: relative;
    z-index: 1;
    height: calc(var(--heritage-text-height, 977px) * var(--heritage-text-scale));
  }

  .heritage-text__content {
    position: relative;
    max-width: calc(var(--heritage-text-content-max-width, 916px) * var(--heritage-text-scale));
    padding-block: calc(var(--heritage-text-padding-block, 80px) * var(--heritage-text-scale));
    padding-inline: calc(var(--heritage-text-padding-inline, 120px) * var(--heritage-text-scale));
  }

  .heritage-text--align-right .heritage-text__content {
    margin-inline-start: auto;
  }

  .heritage-text--align-left .heritage-text__content {
    margin-inline-end: auto;
  }

  .heritage-text__heading {
    margin: 0 0 calc(16px * var(--heritage-text-scale));
    color: var(--heritage-text-heading-color, #F6F4F0);
    font-family: var(--font-heading--family, var(--font-body--family));
    font-size: calc(var(--heritage-text-heading-size, 48px) * var(--heritage-text-scale));
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-transform: capitalize;
  }

  .heritage-text__heading p {
    margin: 0;
  }

  .heritage-text__heading strong {
    color: var(--heritage-text-accent-color, #BCA588);
    font-weight: 400;
  }

  .heritage-text__kicker {
    margin: 0 0 calc(16px * var(--heritage-text-scale));
    color: var(--heritage-text-kicker-color, #E9E2D8);
    font-family: var(--font-heading--family, var(--font-body--family));
    font-size: calc(var(--heritage-text-kicker-size, 24px) * var(--heritage-text-scale));
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-transform: capitalize;
  }

  .heritage-text__body {
    color: var(--heritage-text-body-color, #D1D1D1);
    font-family: var(--font-body--family);
    font-size: calc(var(--heritage-text-body-size, 16px) * var(--heritage-text-scale));
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0.04em;
  }

  .heritage-text__body p {
    margin: 0 0 calc(16px * var(--heritage-text-scale));
  }

  .heritage-text__body p:last-child {
    margin-bottom: 0;
  }

  .heritage-text__body strong {
    color: var(--heritage-text-body-accent-color, #FFFFFF);
    font-style: italic;
    font-weight: 500;
  }

  @media screen and (min-width: 750px) and (max-width: 1799px) {
    .heritage-text {
      --heritage-text-scale: 0.9;
    }
  }

  @media screen and (min-width: 2200px) {
    .heritage-text {
      --heritage-text-scale: 1.3;
    }
  }

  @media screen and (max-width: 749px) {
    .heritage-text:has(.heritage-text__media--mobile) .heritage-text__media--desktop {
      display: none;
    }

    .heritage-text__media--mobile {
      display: block;
    }

    .heritage-text__inner {
      height: auto;
      min-height: var(--heritage-text-mobile-min-height, 520px);
      display: flex;
      align-items: flex-end;
    }

    .heritage-text__content {
      max-width: var(--heritage-text-mobile-content-max-width, 480px);
      margin-inline: 0;
      padding-block: var(--heritage-text-mobile-padding-block, 64px);
      padding-inline: var(--heritage-text-mobile-padding-inline, 16px);
    }

    .heritage-text__heading {
      font-size: var(--heritage-text-heading-size-mobile, 32px);
    }

    .heritage-text__kicker {
      font-size: var(--heritage-text-kicker-size-mobile, 20px);
    }

    .heritage-text__body {
      font-size: var(--heritage-text-body-size-mobile, 14px);
    }

    .heritage-text__body p {
      margin: 0 0 8px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.heritage_text",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.heading"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:html_defaults.heritage_text_heading"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:settings.heading_color",
      "default": "#F6F4F0"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:settings.accent_color",
      "info": "t:info.heritage_text_accent_color",
      "default": "#BCA588"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "t:settings.heading_size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "t:settings.size_mobile",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:settings.kicker",
      "default": "t:text_defaults.heritage_text_kicker"
    },
    {
      "type": "color",
      "id": "kicker_color",
      "label": "t:settings.text_color",
      "default": "#E9E2D8"
    },
    {
      "type": "range",
      "id": "kicker_font_size",
      "label": "t:settings.size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "kicker_font_size_mobile",
      "label": "t:settings.size_mobile",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:content.paragraph"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:settings.text",
      "default": "t:html_defaults.heritage_text_body"
    },
    {
      "type": "color",
      "id": "body_text_color",
      "label": "t:settings.text_color",
      "default": "#D1D1D1"
    },
    {
      "type": "color",
      "id": "body_accent_color",
      "label": "t:settings.accent_color",
      "info": "t:info.heritage_text_accent_color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "body_font_size",
      "label": "t:settings.size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "body_font_size_mobile",
      "label": "t:settings.size_mobile",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "t:content.media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "header",
      "content": "t:content.mobile_media"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:settings.image"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:settings.content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "t:settings.height",
      "min": 500,
      "max": 1400,
      "step": 10,
      "unit": "px",
      "default": 980
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "t:settings.width",
      "min": 400,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "default": 920
    },
    {
      "type": "range",
      "id": "content_padding_block",
      "label": "t:settings.padding_block",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "content_padding_inline",
      "label": "t:settings.padding_inline",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 120
    },
    {
      "type": "header",
      "content": "t:content.padding_mobile"
    },
    {
      "type": "range",
      "id": "mobile_min_height",
      "label": "t:settings.height",
      "min": 300,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 520
    },
    {
      "type": "range",
      "id": "mobile_content_max_width",
      "label": "t:settings.width",
      "min": 280,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "mobile_padding_block",
      "label": "t:settings.padding_block",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "mobile_padding_inline",
      "label": "t:settings.padding_inline",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "t:names.heritage_text",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}

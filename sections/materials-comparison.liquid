

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id, skip_contrast: true
  endif
%}

<section
  id="MaterialsComparison-{{ section.id }}"
  class="materials-comparison{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  role="region"
  aria-label="{{ 'accessibility.materials_comparison_region' | t }}"
>
  <div
    class="materials-comparison__inner"
    style="
      max-width: {{ section.settings.content_max_width }}px;
      --materials-comparison-padding-block-start: {{ section.settings.padding_block_start }}px;
      --materials-comparison-padding-block-end: {{ section.settings.padding_block_end }}px;
      --materials-comparison-padding-inline-start: {{ section.settings.padding_inline_start }}px;
      --materials-comparison-padding-inline-end: {{ section.settings.padding_inline_end }}px;
      --materials-comparison-padding-block-start-mobile: {{ section.settings.padding_block_start_mobile }}px;
      --materials-comparison-padding-block-end-mobile: {{ section.settings.padding_block_end_mobile }}px;
      --materials-comparison-padding-inline-start-mobile: {{ section.settings.padding_inline_start_mobile }}px;
      --materials-comparison-padding-inline-end-mobile: {{ section.settings.padding_inline_end_mobile }}px;
    "
  >
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <header class="materials-comparison__header">
        {%- if section.settings.heading != blank -%}
          <h2
            class="materials-comparison__heading"
            style="
              color: {{ section.settings.heading_color }};
              --materials-comparison-heading-size: {{ section.settings.heading_font_size }}px;
              --materials-comparison-heading-size-mobile: {{ section.settings.heading_font_size_mobile }}px;
            "
          >
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p
            class="materials-comparison__subheading"
            style="
              color: {{ section.settings.subheading_color }};
              --materials-comparison-subheading-size: {{ section.settings.subheading_font_size }}px;
              --materials-comparison-subheading-size-mobile: {{ section.settings.subheading_font_size_mobile }}px;
            "
          >
            {{ section.settings.subheading }}
          </p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <script
        src="{{ 'materials-comparison.js' | asset_url }}"
        type="module"
        fetchpriority="low"
      ></script>
      <materials-comparison-component
        class="materials-comparison__component"
        style="
          --materials-comparison-tab-count: {{ section.blocks.size }};
          --materials-comparison-tab-text-color: {{ section.settings.tab_text_color }};
          --materials-comparison-tab-border-color: {{ section.settings.tab_border_color }};
          --materials-comparison-tab-active-bg: {{ section.settings.tab_active_background_color }};
          --materials-comparison-tab-active-color: {{ section.settings.tab_active_text_color }};
          --materials-comparison-card-border-color: {{ section.settings.card_border_color }};
          --materials-comparison-card-radius: {{ section.settings.card_corner_radius }}px;
          --materials-comparison-card-title-color: {{ section.settings.card_title_color }};
          --materials-comparison-card-text-color: {{ section.settings.card_text_color }};
          --materials-comparison-badge-bg: {{ section.settings.badge_background_color }};
          --materials-comparison-badge-color: {{ section.settings.badge_text_color }};
          --materials-comparison-columns: {{ section.settings.columns }};
          --materials-comparison-mobile-card-width: {{ section.settings.mobile_card_width }}px;
          --materials-comparison-gap: {{ section.settings.gap }}px;
          --materials-comparison-arrow-bg: {{ section.settings.arrow_background_color }};
          --materials-comparison-arrow-color: {{ section.settings.arrow_icon_color }};
        "
      >
        <div
          class="materials-comparison__tablist"
          role="tablist"
          aria-label="{{ 'accessibility.materials_comparison_categories' | t }}"
        >
          {%- for block in section.blocks -%}
            <button
              ref="tabs[]"
              type="button"
              role="tab"
              id="MaterialsTab-{{ block.id }}"
              aria-controls="MaterialsPanel-{{ block.id }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              class="materials-comparison__tab{% if forloop.first %} materials-comparison__tab--active{% endif %}"
              on:click="/selectCategory/{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              {{- block.settings.label -}}
            </button>
          {%- endfor -%}
        </div>
        <div class="materials-comparison__panels">
          {% content_for 'blocks' %}
        </div>
      </materials-comparison-component>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .materials-comparison {
    position: relative;
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .materials-comparison__inner {
    margin-inline: auto;
    padding-block: var(--materials-comparison-padding-block-start, 0) var(--materials-comparison-padding-block-end, 0);
    padding-inline: var(--materials-comparison-padding-inline-start, 0) var(--materials-comparison-padding-inline-end, 0);
  }

  .materials-comparison__header {
    margin-block-end: 3rem;
  }

  .materials-comparison__heading {
    margin: 0 0 1rem;
    font-family: var(--font-body--family);
    font-weight: 400;
    line-height: var(--line-height--display-loose);
    letter-spacing: var(--letter-spacing--display-loose);
    text-transform: capitalize;
    font-size: var(--materials-comparison-heading-size, 48px);
  }

  .materials-comparison__subheading {
    margin: 0;
    max-width: 40rem;
    font-family: var(--font-body--family);
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: var(--letter-spacing--body-loose);
    font-size: var(--materials-comparison-subheading-size, 16px);
  }

  .materials-comparison__component {
    display: block;
  }

  .materials-comparison__tablist {
    display: grid;
    grid-template-columns: repeat(var(--materials-comparison-tab-count, 4), 1fr);
    border: 1.5px solid var(--materials-comparison-tab-border-color, #454545);
    border-radius: 12px;
    overflow: hidden;
  }

  .materials-comparison__tab {
    appearance: none;
    border: 0;
    border-inline-end: 1.5px solid var(--materials-comparison-tab-border-color, #454545);
    background: transparent;
    color: var(--materials-comparison-tab-text-color, inherit);
    padding: 10px 12px;
    cursor: pointer;
    font-family: var(--font-body--family);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: var(--letter-spacing--display-normal);
    text-transform: capitalize;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .materials-comparison__tab:last-of-type {
    border-inline-end: 0;
  }

  .materials-comparison__tab--active {
    background: var(--materials-comparison-tab-active-bg, transparent);
    color: var(--materials-comparison-tab-active-color, inherit);
  }

  .materials-comparison__panels {
    margin-block-start: 3rem;
  }

  .materials-comparison__carousel-wrapper {
    min-width: 0;
  }

  .materials-comparison__slideshow .slideshow-control[disabled] {
    display: none;
  }

  .materials-comparison__slideshow .slideshow-control--shape-circle,
  .materials-comparison__slideshow .slideshow-control--shape-square {
    background-color: var(--materials-comparison-arrow-bg);
    color: var(--materials-comparison-arrow-color);
  }

  @media screen and (max-width: 749px) {
    .materials-comparison__inner {
      padding-block: var(--materials-comparison-padding-block-start-mobile, 0) var(--materials-comparison-padding-block-end-mobile, 0);
      padding-inline: var(--materials-comparison-padding-inline-start-mobile, 0) var(--materials-comparison-padding-inline-end-mobile, 0);
    }

    .materials-comparison__heading {
      font-size: var(--materials-comparison-heading-size-mobile, 24px);
    }

    .materials-comparison__subheading {
      max-width: 22.4rem;
      font-size: var(--materials-comparison-subheading-size-mobile, 14px);
    }

    .materials-comparison__tablist {
      grid-template-columns: repeat(2, 1fr);
    }

    .materials-comparison__tab {
      padding: 14px;
      font-size: 14px;
    }

    .materials-comparison__tablist .materials-comparison__tab:nth-of-type(1),
    .materials-comparison__tablist .materials-comparison__tab:nth-of-type(2) {
      border-block-end: 1.5px solid var(--materials-comparison-tab-border-color, #454545);
    }
  }
{% endstylesheet %}

{% schema %}

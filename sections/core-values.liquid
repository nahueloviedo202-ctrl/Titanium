

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id, skip_contrast: true
  endif
%}

<section
  id="CoreValues-{{ section.id }}"
  class="core-values{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  role="region"
  aria-label="{% if section.settings.heading != blank %}{{ section.settings.heading | strip_html }}{% else %}{{ 'accessibility.core_values_region' | t }}{% endif %}"
>
  <div
    class="core-values__inner"
    style="
      --core-values-max-width: {{ section.settings.content_max_width }}px;
      --core-values-padding-block-start: {{ section.settings.padding_block_start }}px;
      --core-values-padding-block-end: {{ section.settings.padding_block_end }}px;
      --core-values-padding-inline-start: {{ section.settings.padding_inline_start }}px;
      --core-values-padding-inline-end: {{ section.settings.padding_inline_end }}px;
      --core-values-padding-block-start-mobile: {{ section.settings.padding_block_start_mobile }}px;
      --core-values-padding-block-end-mobile: {{ section.settings.padding_block_end_mobile }}px;
      --core-values-padding-inline-start-mobile: {{ section.settings.padding_inline_start_mobile }}px;
      --core-values-padding-inline-end-mobile: {{ section.settings.padding_inline_end_mobile }}px;
    "
  >
    {%- if section.settings.heading != blank -%}
      <h2
        class="core-values__heading{% if section.settings.subheading != blank %} core-values__heading--with-subheading{% endif %}"
        style="
          color: {{ section.settings.heading_color }};
          --core-values-heading-size: {{ section.settings.heading_font_size }}px;
          --core-values-heading-size-mobile: {{ section.settings.heading_font_size_mobile }}px;
        "
      >
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <div
        class="core-values__subheading"
        style="color: {{ section.settings.subheading_color }};"
      >
        {{ section.settings.subheading }}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div
        class="core-values__grid"
        style="
          --core-values-columns: {{ section.settings.columns_desktop }};
          --core-values-gap: {{ section.settings.items_gap }}px;
          --core-values-gap-mobile: {{ section.settings.items_gap_mobile }}px;
          --core-values-card-border-color: {{ section.settings.card_border_color }};
          --core-values-card-radius: {{ section.settings.card_border_radius }}px;
          --core-values-card-title-color: {{ section.settings.card_title_color }};
          --core-values-card-text-color: {{ section.settings.card_text_color }};
          --core-values-media-height: {{ section.settings.card_media_height }}px;
          --core-values-media-height-mobile: {{ section.settings.card_media_height_mobile }}px;
        "
      >
        {% content_for 'blocks' %}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .core-values {
    --cv-scale: 1;
    position: relative;
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .core-values__inner {
    position: relative;
    max-width: calc(var(--core-values-max-width, 1920px) * var(--cv-scale, 1));
    margin-inline: auto;
    padding-block: calc(var(--core-values-padding-block-start, 0px) * var(--cv-scale, 1)) calc(var(--core-values-padding-block-end, 0px) * var(--cv-scale, 1));
    padding-inline: calc(var(--core-values-padding-inline-start, 0px) * var(--cv-scale, 1)) calc(var(--core-values-padding-inline-end, 0px) * var(--cv-scale, 1));
  }

  .core-values__heading {
    margin: 0 0 calc(var(--core-values-heading-size, 48px) * var(--cv-scale, 1));
    font-family: var(--font-body--family);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-transform: capitalize;
    font-size: calc(var(--core-values-heading-size, 48px) * var(--cv-scale, 1));
  }

  .core-values__subheading {
    max-width: calc(880px * var(--cv-scale, 1));
    margin: 0 0 calc(48px * var(--cv-scale, 1));
    font-family: var(--font-body--family);
    font-size: calc(16px * var(--cv-scale, 1));
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0.04em;
  }

  .core-values__subheading p {
    margin: 0 0 1em;
  }

  .core-values__subheading p:last-child {
    margin-bottom: 0;
  }

  .core-values__grid {
    display: grid;
    grid-template-columns: repeat(var(--core-values-columns, 4), minmax(0, 1fr));
    gap: calc(var(--core-values-gap, 32px) * var(--cv-scale, 1));
  }

  @media screen and (max-width: 749px) {
    .core-values__inner {
      padding-block: var(--core-values-padding-block-start-mobile, 0) var(--core-values-padding-block-end-mobile, 0);
      padding-inline: var(--core-values-padding-inline-start-mobile, 0) var(--core-values-padding-inline-end-mobile, 0);
    }

    .core-values__heading {
      margin-bottom: 2rem;
      font-size: var(--core-values-heading-size-mobile, 24px);
    }

    .core-values__subheading {
      max-width: none;
      margin-bottom: 2rem;
      font-size: 14px;
    }

    .core-values__grid {
      grid-template-columns: 1fr;
      gap: var(--core-values-gap-mobile, 12px);
    }
  }

  @media screen and (min-width: 750px) and (max-width: 1799px) {
    .core-values {
      --cv-scale: 0.9;
    }
  }

  @media screen and (min-width: 2200px) {
    .core-values {
      --cv-scale: 1.3;
    }
  }
{% endstylesheet %}


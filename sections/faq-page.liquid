

{% liquid
  if section.settings.background_color != blank or section.settings.text_color != blank
    render 'contrast-override', background_color: section.settings.background_color, text_color: section.settings.text_color, section_id: section.id
  endif
%}

<section
  id="FaqPage-{{ section.id }}"
  class="faq-page{% if section.settings.background_color != blank or section.settings.text_color != blank %} color-custom-{{ section.id }}{% endif %}"
  role="region"
  aria-label="{{ 'accessibility.faq_page_navigation' | t }}"
>
  <div
    class="faq-page__inner spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="faq-page__layout">
        <nav
          class="faq-page__nav"
          aria-label="{{ 'accessibility.faq_page_navigation' | t }}"
          data-faq-nav
        >
          <ul
            class="faq-page__nav-list"
            role="list"
            data-faq-nav-list
          ></ul>
        </nav>

      <div class="faq-page__content">
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .faq-page {
    position: relative;
    color: var(--color-foreground);
    background-color: var(--color-background);
  }

  .faq-page:has(.faq-category) {
    scroll-behavior: smooth;
  }

  .faq-page__layout {
    display: flex;
    align-items: stretch;
    gap: 0;
  }

  .faq-page__nav {
    flex: 0 0 300px;
    max-width: 300px;
    border-inline-end: 1px solid var(--color-border);
  }

  .faq-page__nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .faq-page__nav-link {
    display: block;
    padding-block: 20px;
    padding-inline: 48px;
    border-block-end: 1px solid var(--color-border);
    color: var(--color-foreground-muted);
    font-size: 16px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: capitalize;
    transition: color var(--animation-speed, 0.2s) ease;
  }

  .faq-page__nav-link:hover,
  .faq-page__nav-link:focus-visible,
  .faq-page__nav-link.is-active {
    color: var(--color-foreground);
  }

  .faq-page__content {
    flex: 1 1 auto;
    min-width: 0;
    max-width: 1420px;
    margin-inline: auto;
    padding-inline: 120px;
  }

  @media screen and (max-width: 989px) {
    .faq-page__layout {
      flex-direction: column;
      gap: 0;
    }

    .faq-page__nav {
      flex-basis: auto;
      width: 100%;
      max-width: none;
      border-inline-end: none;
      border-block-end: 1px solid var(--color-border);
    }

    .faq-page__nav-list {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding-block-end: 12px;
      -webkit-overflow-scrolling: touch;
    }

    .faq-page__nav-item {
      flex: 0 0 auto;
    }

    .faq-page__nav-link {
      padding: 14px 20px;
      border: 1px solid var(--color-border);
      border-radius: 999px;
      font-size: 14px;
      letter-spacing: 0.02em;
      white-space: nowrap;
    }

    .faq-page__nav-link.is-active {
      border-color: var(--color-foreground);
    }

    .faq-page__content {
      max-width: none;
      padding-inline: 20px;
      margin-block-start: 32px;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('.faq-page').forEach((root) => {
    const nav = root.querySelector('[data-faq-nav]');
    const navList = root.querySelector('[data-faq-nav-list]');
    const categories = root.querySelectorAll('.faq-category[id]');

    if (!nav || !navList || !categories.length) {
      if (nav) nav.hidden = true;
      return;
    }

    categories.forEach((category) => {
      const headingEl = category.querySelector('.faq-category__heading');
      if (!headingEl) return;

      const item = document.createElement('li');
      item.className = 'faq-page__nav-item';

      const link = document.createElement('a');
      link.className = 'faq-page__nav-link';
      link.href = `#${category.id}`;
      link.textContent = headingEl.textContent.trim();
      link.setAttribute('data-faq-nav-link', '');

      item.appendChild(link);
      navList.appendChild(item);
    });

    const links = navList.querySelectorAll('[data-faq-nav-link]');
    if (!links.length || !('IntersectionObserver' in window)) return;

    const setActive = (id) => {
      links.forEach((link) => {
        link.classList.toggle('is-active', link.getAttribute('href') === `#${id}`);
      });
    };

    setActive(categories[0].id);

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

        if (visible.length) {
          setActive(visible[0].target.id);
        }
      },
      { rootMargin: '-15% 0px -70% 0px' }
    );

    categories.forEach((category) => observer.observe(category));
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:names.faq_page",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "_faq-category"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#121212",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.faq_page",
      "category": "t:categories.text",
      "blocks": {
        "category_1": {
          "type": "_faq-category",
          "settings": {
            "heading": "t:text_defaults.faq_category_heading"
          },
          "blocks": {
            "row-1": {
              "type": "_accordion-row",
              "settings": {
                "heading": "t:text_defaults.when_will_order_arrive"
              },
              "blocks": {
                "text-1": {
                  "type": "text",
                  "settings": {
                    "text": "t:html_defaults.work_quickly_to_ship",
                    "width": "100%"
                  }
                }
              },
              "block_order": ["text-1"]
            }
          },
          "block_order": ["row-1"]
        }
      },
      "block_order": ["category_1"]
    }
  ]
}
{% endschema %}

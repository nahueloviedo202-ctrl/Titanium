          }
        },
        "feat_10": {
          "type": "_health-feature",
          "settings": {
            "text": "Sustainable By Design",
            "side": "right"
          }
        },
        "feat_11": {
          "type": "_health-feature",
          "settings": {
            "text": "Safe At Any Temperature",
            "side": "right"
          }
        },
        "feat_12": {
          "type": "_health-feature",
          "settings": {
            "text": "PFAS-Free. Microplastic-Free.",
            "side": "right"
          }
        }
      },
      "block_order": [
        "feat_1",
        "feat_2",
        "feat_3",
        "feat_4",
        "feat_5",
        "feat_6",
        "feat_7",

          "type": "_health-feature",
          "settings": {
            "text": "No Toxins",
            "side": "left"
          }
        },
        "feat_2": {
          "type": "_health-feature",
          "settings": {
            "text": "Biocompatible",
            "side": "left"
          }
        },
        "feat_3": {
          "type": "_health-feature",
          "settings": {
            "text": "Extremely Hygienic",
            "side": "left"
          }
        },
        "feat_4": {
          "type": "_health-feature",
          "settings": {
            "text": "Naturally Antibacterial",
            "side": "left"
          }
        },
        "feat_5": {
          "type": "_health-feature",
          "settings": {
            "text": "Mold & Fungi Resistant",
            "side": "left"
          }
        },
        "feat_6": {
          "type": "_health-feature",
          "settings": {
            "text": "No Cross-Contamination",
            "side": "left"
          }
        },
        "feat_7": {
          "type": "_health-feature",
          "settings": {
            "text": "No Heavy Metals",
            "side": "right"
          }
        },
        "feat_8": {
          "type": "_health-feature",
          "settings": {
            "text": "Effortless To Clean",

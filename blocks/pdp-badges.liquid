

{%- liquid
  assign block_settings = block.settings
  assign badges = closest.product.metafields.custom.pdp_badges.value
-%}

{%- if badges.size > 0 -%}
  <ul
    class="pdp-badges"
    style="
      --pdp-badges-columns-desktop: {{ block_settings.columns_desktop }};
      --pdp-badges-columns-mobile: {{ block_settings.columns_mobile }};
      --pdp-badges-column-gap: {{ block_settings.column_gap }}px;
      --pdp-badges-row-gap: {{ block_settings.row_gap }}px;
      --pdp-badges-icon-gap: {{ block_settings.icon_gap }}px;
      --pdp-badges-icon-size: {{ block_settings.icon_size }}px;
      --pdp-badges-font-size: {{ block_settings.font_size }}px;
      --pdp-badges-font-size-mobile: {{ block_settings.font_size_mobile }}px;
      {% if block_settings.text_color != blank %}
        --pdp-badges-text-color: {{ block_settings.text_color }};
      {% endif %}
    "
    {{ block.shopify_attributes }}
  >
    {%- for badge in badges -%}
      {%- assign badge_icon = badge.icon.value -%}
      {%- assign badge_text = badge.text.value -%}
      <li class="pdp-badges__item">
        {%- if badge_icon != blank -%}
          <span class="pdp-badges__icon" aria-hidden="true">
            {{
              badge_icon
              | image_url: width: 96
              | image_tag: loading: 'lazy', alt: '', class: 'pdp-badges__icon-image'
            }}
          </span>
        {%- endif -%}
        {%- if badge_text != blank -%}
          <span class="pdp-badges__text">{{ badge_text }}</span>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
{%- endif -%}

{% stylesheet %}
  .pdp-badges {
    display: grid;
    grid-template-columns: repeat(var(--pdp-badges-columns-mobile, 2), minmax(0, 1fr));
    column-gap: var(--pdp-badges-column-gap, 8px);
    row-gap: var(--pdp-badges-row-gap, 8px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .pdp-badges {
      grid-template-columns: repeat(var(--pdp-badges-columns-desktop, 2), minmax(0, 1fr));
    }
  }

  .pdp-badges__item {
    display: flex;
    align-items: center;
    gap: var(--pdp-badges-icon-gap, 8px);
    min-width: 0;
  }

  .pdp-badges__icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: var(--pdp-badges-icon-size, 24px);
    height: var(--pdp-badges-icon-size, 24px);
  }

  .pdp-badges__icon-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .pdp-badges__text {
    min-width: 0;
    font-family: var(--font-body--family);
    font-weight: 400;
    line-height: var(--font-paragraph--line-height);
    letter-spacing: var(--letter-spacing--body-loose, 0.03em);
    font-size: var(--pdp-badges-font-size, 16px);
    color: var(--pdp-badges-text-color, rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text)));
  }

  @media screen and (max-width: 749px) {
    .pdp-badges__text {
      font-size: var(--pdp-badges-font-size-mobile, 14px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.pdp_badges",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.pdp_badges_metafield_help"



<div
  ref="lines[]"
  class="sticky-scroll-story__line sticky-scroll-story__line--heading-{{ block.settings.heading_size }} sticky-scroll-story__line--body-{{ block.settings.body_size }}"
  {%- if block.settings.heading_color != blank -%}
    style="--sticky-scroll-story-line-heading-color: {{ block.settings.heading_color }};"
  {%- endif -%}
  {{ block.shopify_attributes }}
>
  {%- if block.settings.kicker != blank -%}
    <p class="sticky-scroll-story__line-kicker">{{ block.settings.kicker | escape }}</p>
  {%- endif -%}
  {%- if block.settings.heading != blank -%}
    <p class="sticky-scroll-story__line-heading">{{ block.settings.heading }}</p>
  {%- endif -%}
  {%- if block.settings.body != blank -%}
    <div class="sticky-scroll-story__line-body">{{ block.settings.body }}</div>
  {%- endif -%}
</div>

{% stylesheet %}
  .sticky-scroll-story__line {
    max-width: 42rem;
    opacity: 0.35;
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }

  .sticky-scroll-story__line--focused {
    opacity: 1;
  }

  .sticky-scroll-story__line-kicker {
    margin: 0 0 0.5rem;
    font-family: var(--font-body--family);
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.02em;
    text-transform: capitalize;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text, 0.7));
  }

  .sticky-scroll-story__line-heading {
    margin: 0 0 0.75rem;
    font-family: var(--font-heading--family);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0.02em;
    text-transform: capitalize;
    color: var(--sticky-scroll-story-line-heading-color, var(--color-foreground));
  }

  .sticky-scroll-story__line-body {
    margin: 0;
    font-family: var(--font-body--family);
    line-height: 1.5;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text, 0.7));
  }

  .sticky-scroll-story__line-body p {
    margin: 0 0 1em;
  }

  .sticky-scroll-story__line-body p:last-child {
    margin-bottom: 0;
  }

  .sticky-scroll-story__line--heading-xl .sticky-scroll-story__line-heading {
    font-size: 2.4rem;
  }

  .sticky-scroll-story__line--heading-large .sticky-scroll-story__line-heading {
    font-size: 1.8rem;
  }

  .sticky-scroll-story__line--heading-medium .sticky-scroll-story__line-heading {
    font-size: 1.3rem;
  }

  .sticky-scroll-story__line--heading-small .sticky-scroll-story__line-heading {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .sticky-scroll-story__line--body-large .sticky-scroll-story__line-body {
    font-size: 1.15rem;
  }

  .sticky-scroll-story__line--body-medium .sticky-scroll-story__line-body {
    font-size: 1rem;
  }

  .sticky-scroll-story__line--body-small .sticky-scroll-story__line-body {
    font-size: 0.9rem;
  }

  @media screen and (min-width: 750px) {
    .sticky-scroll-story__line--heading-xl .sticky-scroll-story__line-heading {
      font-size: 4rem;
    }

    .sticky-scroll-story__line--heading-large .sticky-scroll-story__line-heading {
      font-size: 3rem;
    }

    .sticky-scroll-story__line--heading-medium .sticky-scroll-story__line-heading {
      font-size: 1.6rem;
    }
  }

  @media screen and (max-width: 749px) {
    .sticky-scroll-story__line {
      opacity: 1;
      max-width: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sticky Scroll Line",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:settings.kicker"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:settings.heading_size",
      "options": [
        { "value": "xl", "label": "t:options.extra_large" },
        { "value": "large", "label": "t:options.large" },
        { "value": "medium", "label": "t:options.medium" },
        { "value": "small", "label": "t:options.small" }
      ],
      "default": "large"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:settings.text_color"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:settings.text"
    },
    {
      "type": "select",
      "id": "body_size",
      "label": "t:settings.size",
      "options": [
        { "value": "large", "label": "t:options.large" },
        { "value": "medium", "label": "t:options.medium" },
        { "value": "small", "label": "t:options.small" }
      ],
      "default": "medium"
    }
  ],
  "presets": [
    {
      "name": "Sticky Scroll Line",
      "category": "t:categories.text"
    }
  ]
}
{% endschema %}

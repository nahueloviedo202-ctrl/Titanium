

<li
  ref="items[]"
  class="health-features__item{% if block.settings.body != blank %} health-features__item--detailed{% endif %}"
  data-side="{{ block.settings.side }}"
  {{ block.shopify_attributes }}
>
  {%- liquid
    capture icon
      if block.settings.icon != blank
        echo block.settings.icon | image_url: width: 96 | image_tag: widths: '48, 96', loading: 'lazy', alt: '', class: 'health-features__item-icon-image'
      endif
    endcapture

    capture label
      if block.settings.text != blank
        echo '<span class="health-features__item-text">' | append: block.settings.text | append: '</span>'
      endif
    endcapture
  -%}
  {%- if block.settings.side == 'right' and block.settings.body == blank -%}
    {%- if icon != blank -%}
      <span class="health-features__item-icon" aria-hidden="true">{{ icon }}</span>
    {%- endif -%}
    {{ label }}
  {%- else -%}
    {{ label }}
    {%- if icon != blank -%}
      <span class="health-features__item-icon" aria-hidden="true">{{ icon }}</span>
    {%- endif -%}
  {%- endif -%}
  {%- if block.settings.body != blank -%}
    <div class="health-features__item-body">{{ block.settings.body }}</div>
  {%- endif -%}
</li>

{% schema %}
{
  "name": "t:names.health_feature",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "icon",
      "label": "t:settings.image_icon"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:text_defaults.health_feature_text"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:settings.description"
    },
    {
      "type": "select",
      "id": "side",
      "label": "t:settings.side",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "t:names.health_feature",
      "category": "t:categories.text"
    }
  ]
}
{% endschema %}



<li
  class="product-feature-item"
  {{ block.shopify_attributes }}
>
  <div class="product-feature-item__head">
    <span class="product-feature-item__icon" aria-hidden="true">
      {% render 'icon-or-image',
        icon: block.settings.icon,
        image_upload: block.settings.image,
        width: 24,
        class_name: 'product-feature-item__icon-media'
      %}
    </span>
    {%- if block.settings.title != blank -%}
      <h3 class="product-feature-item__title">{{ block.settings.title }}</h3>
    {%- endif -%}
  </div>
  {%- if block.settings.text != blank -%}
    <p class="product-feature-item__text">{{ block.settings.text }}</p>
  {%- endif -%}
</li>

{% stylesheet %}
  .product-feature-item {
    display: flex;
    flex-direction: column;
    padding: 16px 18px;
    border: 1px solid var(--pfs-card-border-color, #333333);
    border-radius: var(--pfs-card-radius, 12px);
  }

  .product-feature-item__head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }

  .product-feature-item__icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    color: var(--pfs-accent-color, #bca588);
  }

  .product-feature-item__icon-media {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .product-feature-item__title {
    margin: 0;
    color: var(--pfs-title-color, #ffffff);
    font-family: var(--font-body--family);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.02em;
    text-transform: capitalize;
    font-size: 16px;
  }

  .product-feature-item__text {
    margin: 0;
    color: var(--pfs-text-color, #b0b0b0);
    font-family: var(--font-body--family);
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: var(--letter-spacing--body-loose, 0.03em);
    font-size: 14px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_feature_item",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "t:settings.icon",
      "options": [
        { "value": "none", "label": "t:options.none" },
        { "value": "leaf", "label": "t:options.leaf" },
        { "value": "heart", "label": "t:options.heart" },
        { "value": "check_box", "label": "t:options.check_box" },
        { "value": "lock", "label": "t:options.lock" },
        { "value": "star", "label": "t:options.star" },
        { "value": "fire", "label": "t:options.fire" },
        { "value": "lightning_bolt", "label": "t:options.lightning_bolt" }
      ],
      "default": "star"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image_icon"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.title",
      "default": "t:text_defaults.product_feature_item_title"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:text_defaults.product_feature_item_text"
    }
  ],
  "presets": [
    {
      "name": "t:names.product_feature_item",
      "category": "t:categories.text"
    }
  ]
}
{% endschema %}

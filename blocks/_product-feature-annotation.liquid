

<div
  class="product-feature-annotation product-feature-annotation--{{ block.settings.label_position | replace: '_', '-' }}"
  style="
    --pfa-label-x: {{ block.settings.label_x }}%;
    --pfa-label-y: {{ block.settings.label_y }}%;
    --pfa-dot-x: {{ block.settings.dot_x }}%;
    --pfa-dot-y: {{ block.settings.dot_y }}%;
  "
  {{ block.shopify_attributes }}
>
  <svg
    class="product-feature-annotation__line"
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <line x1="{{ block.settings.label_x }}" y1="{{ block.settings.label_y }}" x2="{{ block.settings.dot_x }}" y2="{{ block.settings.dot_y }}" />
  </svg>
  <span class="product-feature-annotation__dot" aria-hidden="true"></span>
  <div class="product-feature-annotation__label">
    <span class="product-feature-annotation__icon" aria-hidden="true">
      {% render 'icon-or-image',
        icon: block.settings.icon,
        image_upload: block.settings.image,
        width: 20,
        class_name: 'product-feature-annotation__icon-media'
      %}
    </span>
    <div class="product-feature-annotation__copy">
      {%- if block.settings.title != blank -%}
        <p class="product-feature-annotation__title">{{ block.settings.title }}</p>
      {%- endif -%}
      {%- if block.settings.text != blank -%}
        <p class="product-feature-annotation__text">{{ block.settings.text }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .product-feature-annotation {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .product-feature-annotation__line {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .product-feature-annotation__line line {
    stroke: rgb(var(--pfs-accent-rgb, 53 225 184) / 0.7);
    stroke-width: 0.3;
  }

  .product-feature-annotation__dot {
    position: absolute;
    left: var(--pfa-dot-x);
    top: var(--pfa-dot-y);
    width: calc(8px * var(--pfs-scale, 1));
    height: calc(8px * var(--pfs-scale, 1));
    background-color: var(--pfs-accent-color, #35e1b8);
    border-radius: 50%;
    box-shadow: 0 0 0 calc(4px * var(--pfs-scale, 1)) rgb(var(--pfs-accent-rgb, 53 225 184) / 0.2);
    transform: translate(-50%, -50%);
  }

  .product-feature-annotation__label {
    position: absolute;
    left: var(--pfa-label-x);
    top: var(--pfa-label-y);
    display: flex;
    align-items: flex-start;
    gap: calc(10px * var(--pfs-scale, 1));
    max-width: calc(200px * var(--pfs-scale, 1));
    pointer-events: auto;
  }

  .product-feature-annotation--top-left .product-feature-annotation__label {
    transform: translate(-100%, -100%);
  }

  .product-feature-annotation--top-right .product-feature-annotation__label {
    transform: translateY(-100%);
  }

  .product-feature-annotation--bottom-left .product-feature-annotation__label {
    transform: translateX(-100%);
  }

  .product-feature-annotation__icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: calc(32px * var(--pfs-scale, 1));
    height: calc(32px * var(--pfs-scale, 1));
    color: var(--pfs-accent-color, #35e1b8);
    background-color: rgb(var(--pfs-accent-rgb, 53 225 184) / 0.12);
    border: 1px solid rgb(var(--pfs-accent-rgb, 53 225 184) / 0.4);
    border-radius: 50%;
  }

  .product-feature-annotation__icon-media {
    display: block;
    width: 60%;
    height: 60%;
    object-fit: contain;
  }

  .product-feature-annotation__copy {
    min-width: 0;
  }

  .product-feature-annotation__title {
    margin: 0 0 2px;
    color: var(--pfs-title-color, #ffffff);
    font-family: var(--font-body--family);
    font-weight: 600;
    line-height: 1.3;
    font-size: calc(14px * var(--pfs-scale, 1));
  }

  .product-feature-annotation__text {
    margin: 0;
    color: var(--pfs-text-color, #a9c4bc);
    font-family: var(--font-body--family);
    font-weight: 400;
    line-height: 1.4;
    font-size: calc(12px * var(--pfs-scale, 1));
  }

  @media screen and (max-width: 989px) {
    .product-feature-annotation {
      position: static;
      display: contents;
    }

    .product-feature-annotation__line,
    .product-feature-annotation__dot {
      display: none;
    }

    .product-feature-annotation__label {
      position: static;
      grid-column: 1 / -1;
      max-width: none;
      transform: none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_feature_annotation",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "t:settings.icon",
      "options": [
        { "value": "none", "label": "t:options.none" },
        { "value": "check_box", "label": "t:options.check_box" },
        { "value": "lock", "label": "t:options.lock" },
        { "value": "star", "label": "t:options.star" },
        { "value": "fire", "label": "t:options.fire" },
        { "value": "lightning_bolt", "label": "t:options.lightning_bolt" },
        { "value": "leaf", "label": "t:options.leaf" },
        { "value": "heart", "label": "t:options.heart" }
      ],
      "default": "check_box"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image_icon"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.title",
      "default": "t:text_defaults.product_feature_annotation_title"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:text_defaults.product_feature_annotation_text"
    },
    {
      "type": "select",
      "id": "label_position",
      "label": "t:settings.position",
      "options": [
        { "value": "top_left", "label": "t:options.top_left" },
        { "value": "top_right", "label": "t:options.top_right" },
        { "value": "bottom_left", "label": "t:options.bottom_left" },
        { "value": "bottom_right", "label": "t:options.bottom_right" }
      ],
      "default": "top_left"
    },
    {
      "type": "header",
      "content": "t:content.label_position"
    },
    {
      "type": "range",
      "id": "label_x",
      "label": "t:settings.x_position",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "label_y",
      "label": "t:settings.y_position",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 10
    },
    {
      "type": "header",
      "content": "t:content.point_position"
    },
    {
      "type": "range",
      "id": "dot_x",
      "label": "t:settings.x_position",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 35
    },
    {
      "type": "range",
      "id": "dot_y",
      "label": "t:settings.y_position",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 35
    }
  ],
  "presets": [
    {
      "name": "t:names.product_feature_annotation",
      "category": "t:categories.text"
    }
  ]
}
{% endschema %}

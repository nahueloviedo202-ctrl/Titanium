

{%- liquid
  assign block_settings = block.settings
  assign metafield = closest.product.metafields.custom.details_care_use

  if block_settings.type_preset == 'rte' or block_settings.type_preset == 'paragraph'
    assign is_rte = true
  endif

  capture text_block_classes
    if block_settings.width == '100%'
      echo 'text-block--align-' | append: block_settings.alignment
      if block_settings.max_width == 'none'
        echo ' text-block--full-width'
      endif
    endif
    if block_settings.type_preset == 'custom'
      echo ' custom-typography'
      if block_settings.font_size != ''
        echo ' custom-font-size'
      endif
      if block_settings.text_color != ''
        echo ' custom-color'
      endif
    endif
    if is_rte
      echo ' rte'
    endif
  endcapture

  assign element = 'div'
  if is_rte
    assign element = 'rte-formatter'
  endif
-%}

{% if metafield.value != blank %}
  <{{ element }}
    class="text-block {{ text_block_classes }} spacing-style"
    style="
      {% render 'typography-style', settings: block_settings %}
      {% render 'spacing-style', settings: block_settings %}
      {% if block_settings.text_color != blank %}
        --color: {{ block_settings.text_color }};
        --color-rgb: {{ block_settings.text_color.rgb }};
      {% endif %}
      --width: {{ block_settings.width }};
      --max-width: var(--max-width--body-{{ block_settings.max_width }});
      {% if block_settings.width == '100%' %}
        --text-align: {{ block_settings.alignment }};
      {% endif %}
    "
    {{ block.shopify_attributes }}
  >
    {{ metafield | metafield_tag }}
  </{{ element }}>
{% else %}
  <div
    hidden
    shopify-block-empty
    {{ block.shopify_attributes }}
  ></div>
{% endif %}




<div
  class="behind-the-scenes__quote-block"
  style="
    --behind-the-scenes-quote-size: {{ block.settings.quote_size }}px;
    --behind-the-scenes-quote-size-mobile: {{ block.settings.quote_size_mobile }}px;
    --behind-the-scenes-founder-size: {{ block.settings.founder_size }}px;
    --behind-the-scenes-signature-width: {{ block.settings.signature_width }}px;
    --behind-the-scenes-signature-height: {{ block.settings.signature_height }}px;
  "
  {{ block.shopify_attributes }}
>
  {%- if block.settings.quote != blank -%}
    <blockquote
      class="behind-the-scenes__quote"
      style="{% if block.settings.quote_color != blank %}color: {{ block.settings.quote_color }};{% endif %}"
    >
      {{ block.settings.quote }}
    </blockquote>
  {%- endif -%}

  {%- if block.settings.founder_name != blank or block.settings.signature != blank -%}
    <div class="behind-the-scenes__attribution">
      {%- if block.settings.founder_name != blank -%}
        <p
          class="behind-the-scenes__founder"
          style="{% if block.settings.founder_color != blank %}color: {{ block.settings.founder_color }};{% endif %}"
        >
          {{- block.settings.founder_name -}}
        </p>
      {%- endif -%}

      {%- if block.settings.signature != blank -%}
        {{
          block.settings.signature
          | image_url: width: 480
          | image_tag:
            widths: '120, 240, 480',
            alt: '',
            loading: 'lazy',
            class: 'behind-the-scenes__signature'
        }}
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .behind-the-scenes__quote {
    margin: 0 0 1rem;
    font-style: italic;
    font-weight: 500;
    font-size: var(--behind-the-scenes-quote-size-mobile, 1rem);
    line-height: 1.4;
    letter-spacing: 0.02em;
    text-transform: capitalize;
  }

  .behind-the-scenes__quote :is(p) {
    margin: 0;
  }

  /* Mobile: name and signature sit side by side */
  .behind-the-scenes__attribution {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .behind-the-scenes__founder {
    margin: 0;
    font-weight: 500;
    font-size: var(--behind-the-scenes-founder-size, 1.25rem);
    line-height: 1.4;
    letter-spacing: 0.02em;
    text-transform: capitalize;
  }

  .behind-the-scenes__signature {
    display: block;
    width: var(--behind-the-scenes-signature-width, 7.5rem);
    height: var(--behind-the-scenes-signature-height, 5rem);
    object-fit: contain;
  }

  @media screen and (min-width: 1100px) {
    .behind-the-scenes__quote {
      font-size: var(--behind-the-scenes-quote-size, 1.5rem);
    }

    /* Desktop: name stacks above the signature */
    .behind-the-scenes__attribution {
      display: block;
    }

    .behind-the-scenes__founder {
      margin-bottom: 1.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.pull_quote",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "quote",
      "label": "t:settings.quote",
      "default": "t:html_defaults.behind_the_scenes_quote"
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "quote_size",
      "label": "t:settings.size",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "quote_size_mobile",
      "label": "t:settings.size_mobile",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "t:content.heading"
    },
    {
      "type": "text",
      "id": "founder_name",
      "label": "t:settings.author",
      "default": "t:text_defaults.behind_the_scenes_founder"
    },
    {
      "type": "color",
      "id": "founder_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "founder_size",
      "label": "t:settings.size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:content.image"
    },
    {
      "type": "image_picker",
      "id": "signature",
      "label": "t:settings.image"
    },
    {
      "type": "range",
      "id": "signature_width",
      "label": "t:settings.width",
      "min": 60,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "signature_height",
      "label": "t:settings.height",
      "min": 40,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "t:names.pull_quote",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}

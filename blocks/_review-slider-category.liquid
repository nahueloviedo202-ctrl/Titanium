

{%- liquid
  assign block_index = section.blocks | find_index: 'id', block.id
  assign show_arrows = true
  if section.settings.icons_style == 'none'
    assign show_arrows = false
  endif
-%}

<button
  ref="tabs[]"
  type="button"
  role="tab"
  id="ReviewSliderTab-{{ block.id }}"
  aria-controls="ReviewSliderPanel-{{ block.id }}"
  aria-selected="{% if block_index == 0 %}true{% else %}false{% endif %}"
  class="review-slider-custom__tab"
  on:click="/selectCategory/{{ block_index }}"
  {{ block.shopify_attributes }}
>
  {{- block.settings.label -}}
</button>

{% capture cards %}
  {% content_for 'blocks' %}
{% endcapture %}

<div
  ref="panels[]"
  class="review-slider-custom__panel"
  id="ReviewSliderPanel-{{ block.id }}"
  role="tabpanel"
  aria-labelledby="ReviewSliderTab-{{ block.id }}"
  {% if block_index > 0 %}
    hidden
  {% endif %}
>
  {%- if block.blocks.size > 0 -%}
    {% render 'slideshow',
      class: 'review-slider-custom__slideshow',
      slides: cards,
      show_arrows: show_arrows,
      icon_style: section.settings.icons_style,
      icon_shape: section.settings.icons_shape,
      infinite: false,
      slide_count: block.blocks.size,
      style: '--slideshow-gap: var(--review-slider-gap);'
    %}
  {%- endif -%}
</div>

{% stylesheet %}
  .review-slider-custom__tab {
    appearance: none;
    padding: 10px 20px;
    background: transparent;
    color: var(--review-slider-tab-text-color, #b0b0b0);
    border: 1.5px solid var(--review-slider-tab-border-color, #454545);
    border-inline-start: 0;
    max-width: 343px;
    width: 100%;
    font-family: var(--font-body--family);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.02em;
    text-align: center;
    text-transform: capitalize;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .review-slider-custom__tab:first-of-type {
    border-inline-start: 1.5px solid var(--review-slider-tab-border-color, #454545);
    border-start-start-radius: 12px;
    border-end-start-radius: 12px;
  }

  .review-slider-custom__tab:last-of-type {
    border-start-end-radius: 12px;
    border-end-end-radius: 12px;
  }

  .review-slider-custom__tab[aria-selected='true'] {
    background: var(--review-slider-tab-active-background, #a3835f);
    color: var(--review-slider-tab-active-text-color, #121212);
  }

  .review-slider-custom__panel {
    grid-column: 1 / -1;
  }

  .review-slider-custom__slideshow .slideshow-control[disabled] {
    display: none;
  }

  .review-slider-custom__slideshow .slideshow-control--shape-circle,
  .review-slider-custom__slideshow .slideshow-control--shape-square {
    background-color: var(--review-slider-arrow-background, #a3835f);
    color: var(--review-slider-arrow-color, #121212);
  }

  @media screen and (max-width: 749px) {
    .review-slider-custom__tab {
      max-width: none;
      width: 50%;
      font-size: 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.review_slider_category",
  "tag": null,
  "blocks": [
    {
      "type": "_review-slider-card"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "t:text_defaults.material_category_label"
    }
  ],
  "presets": [
    {
      "name": "t:names.review_slider_category",
      "category": "t:categories.layout"
    }
  ]
}
{% endschema %}

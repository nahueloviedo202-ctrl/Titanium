

{% liquid
  assign desktop_vw = 100.0 | divided_by: section.settings.columns_desktop
  assign mobile_vw = 100.0 | divided_by: section.settings.columns_mobile
  assign sizes_attribute = '(min-width: 900px) [desktop_vw]vw, [mobile_vw]vw' | replace: '[desktop_vw]', desktop_vw | replace: '[mobile_vw]', mobile_vw
%}

<div
  class="trust-band-tiles__tile{% if block.settings.hide_on_desktop %} trust-band-tiles__tile--hide-desktop{% endif %}"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.image != blank -%}
    {{
      block.settings.image
      | image_url: width: 800
      | image_tag:
        widths: '300, 450, 600, 800',
        sizes: sizes_attribute,
        loading: 'lazy',
        class: 'trust-band-tiles__tile-img',
        alt: block.settings.alt | default: block.settings.image.alt | escape
    }}
  {%- else -%}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'trust-band-tiles__tile-img' }}
  {%- endif -%}
</div>

{% stylesheet %}
  .trust-band-tiles__tile {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .trust-band-tiles__tile-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (min-width: 900px) {
    .trust-band-tiles__tile--hide-desktop {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.trust_tile",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "t:settings.alt_text"
    },
    {
      "type": "header",
      "content": "t:content.visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "t:settings.hide_on_desktop",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:names.trust_tile",
      "category": "t:categories.text"
    }
  ]
}
{% endschema %}

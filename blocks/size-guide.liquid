

{%- liquid
  assign block_settings = block.settings
  assign size_guide_product = closest.product
  if request.visual_preview_mode and size_guide_product == blank
    assign size_guide_product = collections.all.products.first
  endif
  assign size_guide_entries = size_guide_product.metafields.custom.size_guide.value

  assign trigger_justify = 'flex-start'
  if block_settings.alignment == 'center'
    assign trigger_justify = 'center'
  elsif block_settings.alignment == 'right'
    assign trigger_justify = 'flex-end'
  endif
-%}

{%- if size_guide_entries != blank and size_guide_entries.size > 0 -%}
  <script
    src="{{ 'dialog.js' | asset_url }}"
    type="module"
  ></script>

  <dialog-component
    class="size-guide-link"
    {{ block.shopify_attributes }}
  >
    <div
      class="size-guide-link__trigger-wrapper spacing-style"
      style="--text-alignment: {{ trigger_justify }}; {% render 'spacing-style', settings: block_settings %}"
    >
      <button
        on:click="/showDialog"
        class="button button-unstyled size-guide-link__trigger {{ block_settings.type_preset }}"
      >
        {{- block_settings.link_text -}}
      </button>
    </div>

    <dialog
      ref="dialog"
      class="size-guide-link__content dialog-modal"
      scroll-lock
      aria-labelledby="size-guide-dialog-heading-{{ block.id }}"
    >
      <div class="size-guide-link__header">
        <div class="size-guide-link__heading-group">
          {%- if block_settings.popup_heading != blank -%}
            <h3
              id="size-guide-dialog-heading-{{ block.id }}"
              class="size-guide-link__heading"
            >
              {{ block_settings.popup_heading }}
            </h3>
          {%- endif -%}
          {%- if block_settings.popup_subheading != blank -%}
            <p class="size-guide-link__subheading">{{ block_settings.popup_subheading }}</p>
          {%- endif -%}
        </div>
        <button
          ref="closeButton"
          on:click="/closeDialog"
          class="button button-unstyled size-guide-link__close"
          aria-label="{{ 'accessibility.close_dialog' | t }}"
        >
          {{- 'icon-close.svg' | inline_asset_content -}}
        </button>
      </div>

      <ul
        class="size-guide-link__list"
        role="list"
      >
        {%- for entry in size_guide_entries -%}
          <li class="size-guide-card">
            <div class="size-guide-card__header">
              <div class="size-guide-card__title-group">
                {%- if entry.size.value != blank -%}
                  <span class="size-guide-card__size">{{ entry.size.value }}</span>
                {%- endif -%}
                {%- if entry.size_subtitle.value != blank -%}
                  <span class="size-guide-card__subtitle">{{ entry.size_subtitle.value }}</span>
                {%- endif -%}
              </div>
              {%- if entry.badge.value != blank -%}
                <span class="size-guide-card__badge">{{ entry.badge.value | escape }}</span>
              {%- endif -%}
            </div>
            <div class="size-guide-card__content">
              {%- if entry.size_image.value != blank -%}
                <div class="size-guide-card__media">
                  {{
                    entry.size_image.value
                    | image_url: width: 160
                    | image_tag:
                      loading: 'lazy',
                      width: 80,
                      height: 80,
                      class: 'size-guide-card__image',
                      alt: entry.size.value
                  }}
                </div>
              {%- endif -%}
              {%- if entry.size_description.value != blank -%}
                <p class="size-guide-card__description">{{ entry.size_description.value }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </dialog>
  </dialog-component>
{%- endif -%}

{% stylesheet %}
  .size-guide-link__trigger-wrapper {
    display: flex;
    justify-content: var(--text-alignment, flex-start);
  }

  .size-guide-link__trigger {
    text-align: left;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .size-guide-link__trigger:hover {
    text-decoration-color: transparent;
  }

  .size-guide-link__content {
    background-color: #121212;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 1rem;
    box-shadow: 0 18px 60px 0 rgb(0 0 0 / 0.24);
    padding: 1.625rem 1.75rem 1.75rem;
    max-width: 32.5rem;
    max-height: var(--modal-max-height);
  }

  .size-guide-link__content[open] {
    animation: modalSlideInTop var(--animation-speed) var(--animation-easing) forwards;
  }

  .size-guide-link__content.dialog-closing {
    animation: modalSlideOutTop var(--animation-speed) var(--animation-easing) forwards;
  }

  .size-guide-link__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-block-end: 1.375rem;
  }

  .size-guide-link__heading {
    margin: 0;
    color: #ffffff;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .size-guide-link__subheading {
    margin: 0.75rem 0 0;
    color: rgb(255 255 255 / 0.85);
    font-size: 0.8125rem;
    font-weight: 400;
  }

  .size-guide-link__close {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 0.5rem;
    color: #ffffff;
    opacity: 1;
    animation: none;
  }

  .size-guide-link__close svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  .size-guide-link__list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .size-guide-card {
    background-color: #f5f2ed;
    border-radius: 0.875rem;
    padding: 1rem;
  }

  .size-guide-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .size-guide-card__title-group {
    display: flex;
    flex-direction: column;
  }

  .size-guide-card__size {
    color: #272727;
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .size-guide-card__subtitle {
    margin-top: 0.125rem;
    color: #272727;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .size-guide-card__badge {
    flex-shrink: 0;
    background-color: #3d3529;
    color: #fcfaf6;
    border-radius: 0.375rem;
    padding: 0.3125rem 0.625rem;
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .size-guide-card__content {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    margin-top: 0.75rem;
  }

  .size-guide-card__media {
    flex-shrink: 0;
    width: 4.5rem;
  }

  .size-guide-card__image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
    object-fit: contain;
  }

  .size-guide-card__description {
    margin: 0;
    color: #47433f;
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.45;
  }

  @media screen and (max-width: 749px) {
    .size-guide-link__content {
      padding: 1.375rem 1.25rem 1.5rem;
    }

    .size-guide-card__media {
      width: 3.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Size Guide",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Link"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Text",
      "default": "Size Guide"
    },
    {
      "type": "select",
      "id": "type_preset",
      "label": "Preset",
      "options": [
        {
          "value": "",
          "label": "Default"
        },
        {
          "value": "paragraph",
          "label": "Paragraph"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "paragraph"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "Popup"
    },
    {
      "type": "text",
      "id": "popup_heading",
      "label": "Heading",
      "default": "Size Guide"
    },
    {
      "type": "text",
      "id": "popup_subheading",
      "label": "Subheading",
      "info": "Optional supporting line shown under the heading."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Size Guide",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}

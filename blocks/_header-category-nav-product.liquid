

{%- liquid
  assign card = block.settings
  assign product = card.product

  assign card_image = card.image
  if card_image == blank and product != blank
    assign card_image = product.featured_image
  endif

  # Once a real product is linked, its title/link/price/discount always win
  # over the manual text fields, so the card stays in sync with the product.
  if product != blank
    assign card_title = product.title
    assign card_link = product.url

    assign product_on_sale = false
    if product.compare_at_price > product.price
      assign product_on_sale = true
    endif

    capture card_price
      render 'format-price', price: product.price
    endcapture

    if product_on_sale
      capture card_compare_price
        render 'format-price', price: product.compare_at_price
      endcapture
      assign discount_percentage = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
      assign card_save_badge_text = 'products.product.save_percentage' | t: percentage: discount_percentage
    else
      assign card_compare_price = blank
      assign card_save_badge_text = blank
    endif
  else
    if card.title != blank
      assign card_title = card.title
    else
      assign card_title = 'placeholders.product_title' | t
    endif
    assign card_link = card.link
    assign card_price = card.price
    assign card_compare_price = card.compare_price
    assign card_save_badge_text = card.save_badge_text
  endif

  assign rating_value = card.rating_value | at_most: 5 | at_least: 0
-%}

{% render 'category-nav-product-card',
  image: card_image,
  title: card_title,
  link: card_link,
  open_in_new_tab: card.open_in_new_tab,
  sale_badge_text: card.sale_badge_text,
  show_rating: card.show_rating,
  rating_value: rating_value,
  review_count: card.review_count,
  compare_price: card_compare_price,
  price: card_price,
  save_badge_text: card_save_badge_text,
  block: block
%}

{% schema %}
{
  "name": "t:names.header_category_nav_product",
  "tag": null,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product",
      "info": "t:info.category_nav_product_source"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.title"
    },
    {
      "type": "header",
      "content": "t:content.block_link"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:settings.open_new_tab",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.badges"
    },
    {
      "type": "text",
      "id": "sale_badge_text",
      "label": "t:settings.image_badge_text",
      "info": "t:info.category_nav_image_badge"
    },
    {
      "type": "text",
      "id": "save_badge_text",
      "label": "t:settings.price_badge_text",
      "info": "t:info.category_nav_price_badge"
    },
    {
      "type": "header",
      "content": "t:content.rating"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "t:settings.show_rating",
      "default": true
    },
    {
      "type": "range",
      "id": "rating_value",
      "label": "t:settings.rating_value",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "default": 5,
      "visible_if": "{{ block.settings.show_rating }}"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "t:settings.review_count",
      "default": "t:text_defaults.header_category_nav_review_count",
      "visible_if": "{{ block.settings.show_rating }}"
    },
    {
      "type": "header",
      "content": "t:content.pricing"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "t:settings.compare_price"
    },
    {
      "type": "text",
      "id": "price",
      "label": "t:settings.current_price"
    }
  ],
  "presets": [
    {
      "name": "t:names.header_category_nav_product"
    }
  ]
}
{% endschema %}



{%- liquid
  assign endorse_rating = block.settings.endorse_rating | at_most: 5 | at_least: 0
  assign nav_collection = block.settings.collection

  assign panel_title = block.settings.title
  if panel_title == blank and nav_collection != blank
    assign panel_title = nav_collection.title
  endif

  assign shop_all_link = block.settings.shop_all_link
  if shop_all_link == blank and nav_collection != blank
    assign shop_all_link = nav_collection.url
  endif

  assign auto_products = nav_collection.products
-%}

{%- capture panel_description -%}
  {%- if block.settings.description != blank -%}
    {{ block.settings.description }}
  {%- elsif nav_collection.metafields.custom.menu_description.value != blank -%}
    <p>{{ nav_collection.metafields.custom.menu_description.value | newline_to_br }}</p>
  {%- endif -%}
{%- endcapture -%}
{%- assign panel_description = panel_description | strip -%}

<button
  class="category-nav__tab"
  role="tab"
  type="button"
  id="CategoryNavTab-{{ block.id }}"
  aria-controls="CategoryNavPanel-{{ block.id }}"
  aria-selected="false"
  data-key="{{ block.id }}"
  on:pointerdown="/guardOpen"
  on:click="/togglePanel?key={{ block.id }}"
  {{ block.shopify_attributes }}
>
  {{- block.settings.label -}}
</button>

<section
  class="category-nav__panel"
  id="CategoryNavPanel-{{ block.id }}"
  aria-labelledby="CategoryNavTab-{{ block.id }}"
  role="tabpanel"
  data-key="{{ block.id }}"
  aria-hidden="true"
>
  <aside class="category-nav__panel-left">
    <div class="category-nav__panel-left-top">
      {%- if panel_title != blank -%}
        <h3 class="category-nav__panel-title">{{ panel_title }}</h3>
      {%- endif -%}

      {%- if block.settings.shop_all_label != blank and shop_all_link != blank -%}
        <a
          class="category-nav__panel-link"
          href="{{ shop_all_link }}"
        >
          {{- block.settings.shop_all_label -}}
        </a>
      {%- endif -%}

      <div
        class="category-nav__panel-hr"
        aria-hidden="true"
      ></div>
    </div>

    <div class="category-nav__panel-left-bottom">
      {%- if panel_description != blank -%}
        <div class="category-nav__panel-desc rte">{{ panel_description }}</div>
      {%- endif -%}

      {%- if block.settings.show_endorsement -%}
        <div class="category-nav__endorse">
          {%- if block.settings.endorse_avatar != blank -%}
            {{
              block.settings.endorse_avatar
              | image_url: width: 64
              | image_tag: widths: '32, 64', loading: 'lazy', alt: '', class: 'category-nav__endorse-avatar'
            }}
          {%- endif -%}

          <div class="category-nav__endorse-meta">
            {%- if block.settings.endorse_name != blank -%}
              <div class="category-nav__endorse-name">
                {{- block.settings.endorse_name -}}
                {%- if block.settings.endorse_verified -%}
                  <span
                    class="category-nav__endorse-badge"
                    aria-hidden="true"
                  >
                    {{- 'icon-checkmark.svg' | inline_asset_content -}}
                  </span>
                {%- endif -%}
              </div>
            {%- endif -%}

            <div
              class="category-nav__endorse-stars"
              aria-label="{{ 'accessibility.rating' | t: rating: endorse_rating }}"
            >
              {%- for i in (1..5) -%}
                <span class="category-nav__star{% if i <= endorse_rating %} category-nav__star--filled{% endif %}">
                  <svg
                    class="icon-default"
                    aria-hidden="true"
                    focusable="false"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                  >
                    {%- render 'icon', icon: 'star' -%}
                  </svg>
                </span>
              {%- endfor -%}
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>
  </aside>

  <div class="category-nav__grid">
    {%- if block.blocks.size > 0 -%}
      {% content_for 'blocks' %}
    {%- elsif auto_products.size > 0 -%}
      {%- for auto_product in auto_products limit: 5 -%}
        {%- render 'category-nav-product-card', product: auto_product -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .category-nav__panel {
    display: none;
    position: absolute;
    top: 100%;
    left: 50%;
    z-index: var(--layer-overlay, 16);
    width: 100vw;
    grid-template-columns: 20rem 1fr;
    gap: 0;
    background: var(--category-nav-background, #121212);
    border-top: 1px solid var(--category-nav-border-color, #2b2b2b);
    box-shadow: 0 0.5rem 1rem rgb(10 10 10 / 0.3);
    opacity: 0;
    translate: -50% -0.625rem;
    transition-property: display, opacity, translate;
    transition-duration: var(--animation-speed-slow);
    transition-timing-function: var(--ease-out-quad);
    transition-behavior: allow-discrete;
  }

  .category-nav__panel[aria-hidden='false'] {
    display: grid;
    opacity: 1;
    translate: -50% 0;
  }

  @starting-style {
    .category-nav__panel[aria-hidden='false'] {
      opacity: 0;
      translate: -50% -0.625rem;
    }
  }

  .category-nav__panel-left {
    display: flex;
    flex-direction: column;
    min-height: 21.25rem;
    border-right: 1px solid var(--category-nav-border-color, #454545);
  }

  .category-nav__panel-left-top {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    height: 50%;
    padding: 2rem;
  }

  .category-nav__panel-left-bottom {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 50%;
    padding: 2rem;
    border-top: 1px solid var(--category-nav-border-color, #454545);
  }

  .category-nav__panel-title {
    margin: 0;
    color: var(--category-nav-heading-color, #fff);
    font-size: var(--category-nav-panel-title-size, 2rem);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-transform: capitalize;
  }

  .category-nav__panel-link {
    width: max-content;
    color: var(--category-nav-heading-color, #fff);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.04em;
    text-decoration-line: underline;
    text-transform: capitalize;
  }

  .category-nav__panel-link:hover {
    opacity: 0.9;
  }

  .category-nav__panel-hr {
    height: 1px;
    margin-top: 1rem;
    background: var(--category-nav-border-color, #2b2b2b);
  }

  .category-nav__panel-desc {
    color: var(--category-nav-text-color, #b0b0b0);
    font-size: 0.875rem;
    line-height: 1.5;
    letter-spacing: 0.04em;
  }

  .category-nav__panel-desc :is(p) {
    margin: 0;
  }

  .category-nav__endorse {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .category-nav__endorse-avatar {
    display: block;
    width: 2rem;
    height: 2rem;
    object-fit: cover;
    border-radius: 0.25rem;
  }

  .category-nav__endorse-meta {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .category-nav__endorse-name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--category-nav-heading-color, #f7f7f7);
    font-size: 0.625rem;
    line-height: 1.5;
    letter-spacing: 0.04em;
  }

  .category-nav__endorse-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1rem;
    padding: 0.2rem;
    border-radius: 50%;
    background: var(--category-nav-accent-color, #bca588);
    color: var(--category-nav-background, #121212);
  }

  .category-nav__endorse-badge svg {
    width: 100%;
    height: 100%;
  }

  .category-nav__endorse-stars {
    display: flex;
    gap: 0.2rem;
  }

  .category-nav__endorse-stars .category-nav__star {
    width: 0.5625rem;
    height: 0.5625rem;
  }

  .category-nav__grid {
    display: flex;
    flex-wrap: nowrap;
    align-items: stretch;
    gap: 1.5rem;
    padding: 3rem;
    overflow-x: auto;
  }

  @media screen and (max-width: 1530px) {
    .category-nav__grid {
      gap: 1rem;
      padding: 2.5rem 2rem;
    }
  }

  .category-nav__star {
    display: inline-flex;
    width: 0.625rem;
    height: 0.625rem;
    color: rgb(255 255 255 / 0.3);
  }

  .category-nav__star svg {
    width: 100%;
    height: 100%;
  }

  .category-nav__star--filled {
    color: var(--category-nav-star-color, #b57c46);
  }

  .category-nav__product {
    flex: 0 0 13.75rem;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--category-nav-card-background, #252525);
    border-radius: var(--category-nav-card-radius, 0.75rem);
  }

  .category-nav__product-media {
    position: relative;
    display: block;
    background: #181818;
  }

  .category-nav__product-image {
    display: block;
    width: 100%;
    height: auto;
  }

  .category-nav__product-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    display: inline-flex;
    padding: 0.375rem 0.625rem;
    border-radius: 0.375rem;
    background: var(--category-nav-badge-background, #bf092f);
    color: var(--category-nav-badge-text, #fff);
    font-size: 0.75rem;
    line-height: 1;
    letter-spacing: 0.015em;
    white-space: nowrap;
    pointer-events: none;
  }

  .category-nav__product-body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-height: 0;
    padding: 0.875rem 0.875rem 1rem;
    border-top: 1.5px solid #333;
  }

  .category-nav__product-rating {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-bottom: 0.5rem;
  }

  .category-nav__product-stars {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  .category-nav__product-review-count {
    color: var(--category-nav-accent-color, #bca588);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .category-nav__product-title {
    display: block;
    margin: 0 0 0.75rem;
    color: var(--category-nav-price-color, #f6f4f0);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.02em;
    text-transform: capitalize;
    text-decoration: none;
  }

  a.category-nav__product-title:hover {
    opacity: 0.95;
  }

  .category-nav__product-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: auto;
  }

  .category-nav__product-save-badge {
    flex-basis: 100%;
    width: fit-content;
  }

  .category-nav__product-compare-price {
    color: var(--category-nav-accent-color, #a3835f);
    font-size: 1rem;
    line-height: 1.5;
    text-decoration-line: line-through;
  }

  .category-nav__product-current-price {
    color: var(--category-nav-price-color, #f6f4f0);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .category-nav__product-save-badge {
    display: inline-flex;
    padding: 0.375rem 0.75rem;
    border-radius: 999px;
    background: var(--category-nav-save-badge-background, #bca588);
    color: var(--category-nav-save-badge-text, #252525);
    font-size: 0.875rem;
    line-height: 1.5;
    text-transform: uppercase;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.header_category_nav_tab",
  "tag": null,
  "blocks": [
    {
      "type": "_header-category-nav-product"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection",
      "info": "t:info.category_nav_tab_collection"
    },
    {
      "type": "paragraph",
      "content": "t:content.category_nav_metafield_help"
    },
    {
      "type": "header",
      "content": "t:content.heading"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "t:text_defaults.header_category_nav_tab_label"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.title",
      "info": "t:info.category_nav_tab_title",
      "default": "t:text_defaults.header_category_nav_tab_title"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:settings.text",
      "info": "t:info.category_nav_tab_description"
    },
    {
      "type": "header",
      "content": "t:content.block_link"
    },
    {
      "type": "text",
      "id": "shop_all_label",
      "label": "t:settings.label",
      "default": "t:text_defaults.header_category_nav_shop_all"
    },
    {
      "type": "url",
      "id": "shop_all_link",
      "label": "t:settings.link"
    },
    {
      "type": "header",
      "content": "t:content.rating"
    },
    {
      "type": "checkbox",
      "id": "show_endorsement",
      "label": "t:settings.show",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "endorse_avatar",
      "label": "t:settings.image",
      "visible_if": "{{ block.settings.show_endorsement }}"
    },
    {
      "type": "text",
      "id": "endorse_name",
      "label": "t:settings.author",
      "default": "t:text_defaults.header_category_nav_endorse_name",
      "visible_if": "{{ block.settings.show_endorsement }}"
    },
    {
      "type": "checkbox",
      "id": "endorse_verified",
      "label": "t:settings.verified_badge",
      "default": true,
      "visible_if": "{{ block.settings.show_endorsement }}"
    },
    {
      "type": "range",
      "id": "endorse_rating",
      "label": "t:settings.rating_value",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "default": 5,
      "visible_if": "{{ block.settings.show_endorsement }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.header_category_nav_tab",
      "blocks": {
        "product_1": {
          "type": "_header-category-nav-product"
        }
      },
      "block_order": ["product_1"]
    }
  ]
}
{% endschema %}

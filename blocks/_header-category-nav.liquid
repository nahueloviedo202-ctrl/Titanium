    {
      "type": "color",
      "id": "badge_background_color",
      "label": "t:settings.badge_sale_background_color",
      "default": "#BF092F"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "t:settings.badge_sale_text_color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "save_badge_background_color",
      "label": "t:settings.badge_sale_background_color",
      "default": "#BCA588"
    },
    {
      "type": "color",
      "id": "save_badge_text_color",
      "label": "t:settings.badge_sale_text_color",
      "default": "#252525"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "range",
      "id": "tab_font_size",
      "label": "t:settings.size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "panel_title_font_size",
      "label": "t:settings.heading_size",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "t:names.header_category_nav",
      "blocks": {
        "tab_1": {
          "type": "_header-category-nav-tab"
        }

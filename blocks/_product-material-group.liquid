

{%- capture material_needle -%}
  {%- render 'material-metafield-key', target_product: product -%}
{%- endcapture -%}

{%- liquid
  assign material_needle = material_needle | strip
  assign show_group = false

  assign tokens = block.settings.material_key
  if block.settings.metafield_values != blank
    assign tokens = tokens | append: ',' | append: block.settings.metafield_values
  endif
  assign tokens = tokens | split: ','

  if material_needle != blank
    for token in tokens
      assign candidate = token | downcase | replace: ' ', '' | replace: '-', '' | replace: '_', '' | strip
      if candidate != blank and material_needle contains candidate
        assign show_group = true
        break
      endif
    endfor
  elsif section.settings.fallback_material == block.settings.material_key
    assign show_group = true
  endif

  assign show_arrows = true
  if section.settings.icons_style == 'none'
    assign show_arrows = false
  endif
-%}

{%- if show_group and block.blocks.size > 0 -%}
  {% capture cards %}
    {% content_for 'blocks' %}
  {% endcapture %}

  <div
    class="product-materials__group"
    data-material-key="{{ block.settings.material_key | escape }}"
    {{ block.shopify_attributes }}
  >
    {% render 'slideshow',
      class: 'product-materials__slideshow',
      slides: cards,
      show_arrows: show_arrows,
      icon_style: section.settings.icons_style,
      icon_shape: section.settings.icons_shape,
      infinite: false,
      slide_count: block.blocks.size,
      style: '--slideshow-gap: var(--materials-comparison-gap);'
    %}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:names.product_material_group",
  "tag": null,
  "blocks": [
    {
      "type": "_material-card"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "material_key",
      "label": "t:settings.material_type",
      "options": [
        {
          "value": "pans",
          "label": "t:options.pans"
        },
        {
          "value": "cutting_boards",
          "label": "t:options.cutting_boards"
        },
        {
          "value": "utensils",
          "label": "t:options.utensils"
        },
        {
          "value": "water_bottles",
          "label": "t:options.water_bottles"
        }
      ],
      "default": "pans"
    },
    {
      "type": "text",
      "id": "metafield_values",
      "label": "t:settings.material_metafield_values",
      "info": "t:info.material_metafield_values"
    }
  ],
  "presets": [
    {
      "name": "t:names.product_material_group",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}

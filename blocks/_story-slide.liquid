

{%- liquid
  assign block_index = section.blocks | find_index: 'id', block.id
-%}

{% capture children %}
  <div class="story-slide">
    <div class="story-slide__media">
      {%- if block.settings.image != blank -%}
        {{
          block.settings.image
          | image_url: width: 1200
          | image_tag:
            widths: '400, 600, 900, 1200',
            sizes: '(min-width: 750px) 30vw, 80vw',
            loading: 'lazy',
            class: 'story-slide__image'
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'story-slide__image' }}
      {%- endif -%}
    </div>
    <div class="story-slide__content">
      {%- if block.settings.heading != blank -%}
        <h3 class="story-slide__heading">{{ block.settings.heading }}</h3>
      {%- endif -%}
      {%- if block.settings.body != blank -%}
        <div class="story-slide__body rte">{{ block.settings.body }}</div>
      {%- endif -%}
    </div>
  </div>
{% endcapture %}

{% render 'slideshow-slide',
  index: block_index,
  children: children,
  attributes: block.shopify_attributes,
  navigate_to_slide: false
%}

{% stylesheet %}
  .story-slide {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    height: 100%;
    padding-inline: var(--story-slider-content-padding-inline-mobile, 0);
  }

  .story-slide__media {
    flex-shrink: 0;
    width: 100%;
    max-width: var(--story-slider-media-size-mobile, 260px);
    aspect-ratio: 1 / 1;
    border-radius: 1rem;
    overflow: hidden;
    background: rgb(255 255 255 / 0.06);
  }

  .story-slide__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .story-slide__content {
    min-width: 0;
    text-align: center;
  }

  .story-slide__heading {
    margin: 0 0 1rem;
    color: var(--story-slider-heading-color, #a3835f);
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: var(--story-slider-heading-size-mobile, 24px);
    line-height: 1.3;
    letter-spacing: 0.02em;
  }

  .story-slide__body {
    color: var(--story-slider-body-color, #b0b0b0);
    font-size: var(--story-slider-body-size-mobile, 14px);
    line-height: 1.6;
  }

  .story-slide__body :is(p) {
    margin: 0 0 1rem;
  }

  .story-slide__body :is(p):last-child {
    margin-bottom: 0;
  }

  @media screen and (min-width: 750px) {
    .story-slide {
      flex-direction: row;
      align-items: center;
      text-align: left;
      gap: var(--story-slider-gap, 4rem);
      padding-inline: var(--story-slider-content-padding-inline, 0);
    }

    .story-slider--media-right .story-slide {
      flex-direction: row-reverse;
    }

    .story-slide__media {
      max-width: var(--story-slider-media-size, 420px);
    }

    .story-slide__content {
      text-align: left;
    }

    .story-slide__heading {
      font-size: var(--story-slider-heading-size, 48px);
    }

    .story-slide__body {
      max-width: 34rem;
      font-size: var(--story-slider-body-size, 16px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.story_slide",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:content.media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "header",
      "content": "t:content.heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.story_slide_heading"
    },
    {
      "type": "header",
      "content": "t:content.paragraph"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:settings.text",
      "default": "t:html_defaults.story_slide_body"
    }
  ],
  "presets": [
    {
      "name": "t:names.story_slide",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}



<li
  class="trust-badge-item"
  {{ block.shopify_attributes }}
>
  <span class="trust-badge-item__icon" aria-hidden="true">
    {% render 'icon-or-image',
      icon: block.settings.icon,
      image_upload: block.settings.image,
      width: 16,
      class_name: 'trust-badge-item__icon-media'
    %}
  </span>
  {%- if block.settings.label != blank -%}
    <span class="trust-badge-item__label">{{ block.settings.label }}</span>
  {%- endif -%}
</li>

{% stylesheet %}
  .trust-badge-item {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs, 5px);
    white-space: nowrap;
  }

  .trust-badges__list:not(.trust-badges__list--no-separator) .trust-badge-item:not(:last-child)::after {
    content: '\00B7';
    margin-inline-start: var(--trust-badges-gap, 16px);
    color: var(--trust-badges-separator-color, rgb(var(--color-foreground-rgb) / var(--opacity-muted-text)));
  }

  .trust-badge-item__icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: var(--trust-badges-icon-size, 16px);
    height: var(--trust-badges-icon-size, 16px);
    color: var(--trust-badges-icon-color, rgb(var(--color-foreground-rgb) / var(--opacity-muted-text)));
  }

  .trust-badge-item__icon-media {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .trust-badge-item__label {
    font-family: var(--font-body--family);
    font-size: var(--font-paragraph-small--size);
    line-height: var(--font-paragraph--line-height);
    color: var(--trust-badges-text-color, rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text)));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.trust_badge_item",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "t:settings.icon",
      "options": [
        { "value": "none", "label": "t:options.none" },
        { "value": "truck", "label": "t:options.truck" },
        { "value": "return", "label": "t:options.return" },
        { "value": "lock", "label": "t:options.lock" },
        { "value": "stopwatch", "label": "t:options.stopwatch" },
        { "value": "check_box", "label": "t:options.check_box" },
        { "value": "star", "label": "t:options.star" },
        { "value": "heart", "label": "t:options.heart" },
        { "value": "price_tag", "label": "t:options.price_tag" }
      ],
      "default": "truck"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image_icon"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "t:text_defaults.trust_badge_shipping"
    }
  ],
  "presets": [
    {
      "name": "t:names.trust_badge_item",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}

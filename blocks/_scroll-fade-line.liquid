

<p
  ref="lines[]"
  class="scroll-text-fade__line{% if block.settings.hide_on_desktop %} scroll-text-fade__line--hide-desktop{% endif %}{% if block.settings.hide_on_mobile %} scroll-text-fade__line--hide-mobile{% endif %}"
  style="
    --scroll-text-fade-line-size: {{ block.settings.font_size }}px;
    --scroll-text-fade-line-size-mobile: {{ block.settings.font_size_mobile }}px;
    --scroll-text-fade-line-opacity: {{ block.settings.opacity | divided_by: 100.0 }};
    {% if block.settings.text_color != blank %}--scroll-text-fade-line-color: {{ block.settings.text_color }};{% endif %}
  "
  {{ block.shopify_attributes }}
>
  {{- block.settings.text -}}
</p>

{% schema %}
{
  "name": "t:names.scroll_fade_line",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:text_defaults.scroll_fade_line_text"
    },
    {
      "type": "header",
      "content": "t:content.typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "t:settings.size",
      "min": 16,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "t:settings.size_mobile",
      "min": 12,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "opacity",
      "label": "t:settings.opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "t:settings.hide_on_desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "t:settings.hide_on_mobile",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:names.scroll_fade_line",
      "category": "t:categories.text"
    }
  ]
}
{% endschema %}

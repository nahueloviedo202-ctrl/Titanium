

{%- liquid
  assign block_index = section.blocks | find_index: 'id', block.id
  assign show_arrows = true
  if section.settings.icons_style == 'none'
    assign show_arrows = false
  endif
-%}

<button
  ref="tabs[]"
  type="button"
  role="tab"
  id="MaterialsTab-{{ block.id }}"
  aria-controls="MaterialsPanel-{{ block.id }}"
  aria-selected="{% if block_index == 0 %}true{% else %}false{% endif %}"
  class="materials-comparison__tab{% if block_index == 0 %} materials-comparison__tab--active{% endif %}"
  on:click="/selectCategory/{{ block_index }}"
  {{ block.shopify_attributes }}
>
  {{- block.settings.label -}}
</button>

{% capture cards %}
  {% content_for 'blocks' %}
{% endcapture %}

<div
  ref="panels[]"
  class="materials-comparison__panel"
  id="MaterialsPanel-{{ block.id }}"
  role="tabpanel"
  aria-labelledby="MaterialsTab-{{ block.id }}"
  {% if block_index > 0 %}
    hidden
  {% endif %}
>
  {%- if block.blocks.size > 0 -%}
    <div class="materials-comparison__carousel-wrapper">
      {% render 'slideshow',
        class: 'materials-comparison__slideshow',
        slides: cards,
        show_arrows: show_arrows,
        icon_style: section.settings.icons_style,
        icon_shape: section.settings.icons_shape,
        infinite: false,
        slide_count: block.blocks.size,
        style: '--slideshow-gap: var(--materials-comparison-gap);'
      %}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:names.material_category",
  "tag": null,
  "blocks": [
    {
      "type": "_material-card"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "t:text_defaults.material_category_label"
    }
  ],
  "presets": [
    {
      "name": "t:names.material_category",
      "category": "t:categories.layout"
    }
  ]
}
{% endschema %}

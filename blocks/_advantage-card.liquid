

<article
  class="adv-card"
  {{ block.shopify_attributes }}
>
  <div class="adv-card__icon" aria-hidden="true">
    {% render 'icon-or-image',
      icon: block.settings.icon,
      image_upload: block.settings.image,
      width: 150,
      class_name: 'adv-card__icon-media'
    %}
  </div>
  {%- if block.settings.title != blank -%}
    <h3 class="adv-card__title">{{ block.settings.title }}</h3>
  {%- endif -%}
  {%- if block.settings.text != blank -%}
    <p class="adv-card__text">{{ block.settings.text }}</p>
  {%- endif -%}
</article>

{% stylesheet %}
  .adv-card {
    display: grid;
    align-self: start;
  }

  .adv-card__icon {
    display: block;
    width: 150px;
    height: 150px;
    margin: 0 0 24px;
  }

  .adv-card__icon-media {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .adv-card__title {
    margin: 0 0 12px;
    font-family: var(--font-body--family);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: var(--letter-spacing--display-normal);
    text-transform: capitalize;
    font-size: 20px;
  }

  .adv-card__text {
    margin: 0;
    font-family: var(--font-body--family);
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: var(--letter-spacing--body-loose);
    font-size: 16px;
  }

  @media screen and (max-width: 749px) {
    .adv-card__icon {
      width: 100px;
      height: 100px;
      margin-bottom: 16px;
    }

    .adv-card__title {
      font-size: 16px;
    }

    .adv-card__text {
      font-size: 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.advantage_card",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "t:settings.icon",
      "options": [
        { "value": "none", "label": "t:options.none" },
        { "value": "lightning_bolt", "label": "t:options.lightning_bolt" },
        { "value": "recycle", "label": "t:options.recycle" },
        { "value": "lock", "label": "t:options.lock" },
        { "value": "box", "label": "t:options.box" },
        { "value": "star", "label": "t:options.star" },
        { "value": "check_box", "label": "t:options.check_box" }
      ],
      "default": "star"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image_icon"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.title",
      "default": "t:text_defaults.advantage_card_title"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:text_defaults.advantage_card_text"
    }
  ],
  "presets": [
    {
      "name": "t:names.advantage_card",
      "category": "t:categories.text"
    }
  ]
}
{% endschema %}

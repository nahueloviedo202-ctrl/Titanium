{%- doc -%}
  Renders a single best-sellers slide sourced from a real product.
  Used by sections/best-sellers-slider.liquid, looping over an eligible
  collection's products (never manually configured per-card content).

  @param {object} [product] - The product to render. Blank renders an onboarding placeholder.
  @param {object} section - The parent section, used for style settings.
  @param {number} index - The 0-based index of this slide within the carousel.

  @example
  {% render 'best-sellers-card', product: product, section: section, index: forloop.index0 %}
{%- enddoc -%}

{%- liquid
  assign onboarding = false
  if product == blank
    assign onboarding = true
  endif

  assign card_title = product.title | default: 'placeholders.product_title' | t

  assign product_on_sale = false
  if product != blank and product.compare_at_price > product.price
    assign product_on_sale = true
  endif

  assign card_subtitle = product.metafields.custom.subtitle.value | default: product.type

  assign card_link = product.url
  assign has_link = false
  if card_link != blank
    assign has_link = true
  endif

  assign desktop_sizes_vw = 100.0 | divided_by: section.settings.slides_per_view
  assign card_sizes = '(max-width: 749px) ' | append: section.settings.mobile_card_width | append: 'px, ' | append: desktop_sizes_vw | append: 'vw'
-%}

<slideshow-slide
  ref="slides[]"
  aria-hidden="{% if index == 0 %}false{% else %}true{% endif %}"
  style="--slideshow-timeline: --slide-{{ index }};"
  class="best-sellers-slider__slide"
>
  <article
    class="best-sellers-slider__card{% if section.settings.card_shadow %} best-sellers-slider__card--shadow{% endif %}"
    style="
      --best-sellers-card-border-color: {{ section.settings.card_border_color }};
      --best-sellers-card-border-width: {{ section.settings.card_border_width }}px;
      --best-sellers-card-radius: {{ section.settings.card_corner_radius }}px;
      --best-sellers-title-color: {{ section.settings.title_color }};
      --best-sellers-subtitle-color: {{ section.settings.subtitle_color }};
      --best-sellers-price-color: {{ section.settings.price_color }};
      --best-sellers-compare-price-color: {{ section.settings.compare_price_color }};
      --best-sellers-badge-bg: {{ section.settings.badge_background_color }};
      --best-sellers-badge-color: {{ section.settings.badge_text_color }};
      --best-sellers-title-size: {{ section.settings.title_font_size }}px;
      --best-sellers-subtitle-size: {{ section.settings.subtitle_font_size }}px;
      --best-sellers-price-size: {{ section.settings.price_font_size }}px;
    "
  >
    {%- if product_on_sale -%}
      <div class="best-sellers-slider__badge">{{ 'content.product_badge_sale' | t }}</div>
    {%- endif -%}

    {%- if has_link -%}
      <a
        href="{{ card_link }}"
        class="best-sellers-slider__media best-sellers-slider__media--{{ section.settings.image_ratio }}"
        aria-hidden="true"
        tabindex="-1"
      >
    {%- else -%}
      <div class="best-sellers-slider__media best-sellers-slider__media--{{ section.settings.image_ratio }}">
    {%- endif -%}

      {%- if product.featured_image != blank -%}
        {{
          product.featured_image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            sizes: card_sizes,
            widths: '352, 832, 1200',
            alt: '',
            class: 'best-sellers-slider__image'
        }}
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'best-sellers-slider__image' }}
      {%- endif -%}

    {%- if has_link -%}
      </a>
    {%- else -%}
      </div>
    {%- endif -%}

    <div class="best-sellers-slider__content">
      {%- if has_link -%}
        <a href="{{ card_link }}" class="best-sellers-slider__title">
          {{- card_title -}}
        </a>
      {%- else -%}
        <span class="best-sellers-slider__title">{{ card_title }}</span>
      {%- endif -%}

      {%- if card_subtitle != blank -%}
        <p class="best-sellers-slider__subtitle">{{ card_subtitle }}</p>
      {%- endif -%}

      {%- unless onboarding -%}
        <div class="best-sellers-slider__price">
          {%- if product_on_sale -%}
            <span class="best-sellers-slider__price-compare">
              {%- render 'format-price', price: product.compare_at_price -%}
            </span>
          {%- endif -%}
          <span class="best-sellers-slider__price-current">
            {%- render 'format-price', price: product.price -%}
          </span>
        </div>
      {%- endunless -%}
    </div>
  </article>
</slideshow-slide>

{% stylesheet %}
  .best-sellers-slider__slide {
    /* Native slideshow-slide sets overflow: hidden and a snap-align of 'center';
       this card needs its shadow to remain visible and to snap to its leading edge. */
    overflow: visible;
    scroll-snap-align: start;
  }

  .best-sellers-slider__card {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--best-sellers-card-radius, 0);
    border: var(--best-sellers-card-border-width, 0) solid var(--best-sellers-card-border-color, transparent);
  }

  .best-sellers-slider__card--shadow {
    box-shadow: 0 4px 4px 0 rgba(0, 0, 0, 0.25);
  }

  .best-sellers-slider__badge {
    position: absolute;
    top: var(--padding-xs, 8px);
    left: var(--padding-xs, 8px);
    z-index: 1;
    margin: 0;
    padding: 0.375rem 0.625rem;
    border-radius: 0.375rem;
    background: var(--best-sellers-badge-bg);
    color: var(--best-sellers-badge-color);
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    line-height: 1;
    letter-spacing: 0.02em;
    pointer-events: none;
  }

  .best-sellers-slider__media {
    display: block;
    width: 100%;
  }

  .best-sellers-slider__media--square {
    aspect-ratio: 1 / 1;
  }

  .best-sellers-slider__media--portrait {
    aspect-ratio: 2 / 3;
  }

  .best-sellers-slider__media--landscape {
    aspect-ratio: 16 / 9;
  }

  .best-sellers-slider__image {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .best-sellers-slider__media--square .best-sellers-slider__image,
  .best-sellers-slider__media--portrait .best-sellers-slider__image,
  .best-sellers-slider__media--landscape .best-sellers-slider__image {
    height: 100%;
  }

  .best-sellers-slider__content {
    padding: 1rem;
    border-top: var(--best-sellers-card-border-width, 0) solid var(--best-sellers-card-border-color, transparent);
  }

  .best-sellers-slider__title {
    display: block;
    margin: 0 0 0.5rem;
    color: var(--best-sellers-title-color);
    font-family: var(--font-heading--family, var(--font-body--family));
    font-size: var(--best-sellers-title-size, 1rem);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.02em;
    text-transform: capitalize;
    text-decoration: none;
  }

  a.best-sellers-slider__title:hover {
    text-decoration: underline;
  }

  .best-sellers-slider__subtitle {
    margin: 0 0 1rem;
    color: var(--best-sellers-subtitle-color);
    font-family: var(--font-body--family);
    font-size: var(--best-sellers-subtitle-size, 0.875rem);
    line-height: 1.5;
    letter-spacing: 0.04em;
  }

  .best-sellers-slider__price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .best-sellers-slider__price-compare,
  .best-sellers-slider__price-current {
    font-family: var(--font-body--family);
    font-size: var(--best-sellers-price-size, 1.25rem);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: capitalize;
  }

  .best-sellers-slider__price-compare {
    color: var(--best-sellers-compare-price-color);
    text-decoration-line: line-through;
  }

  .best-sellers-slider__price-current {
    color: var(--best-sellers-price-color);
  }
{% endstylesheet %}

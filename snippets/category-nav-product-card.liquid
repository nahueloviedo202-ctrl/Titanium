{%- doc -%}
  Renders one product preview card for the header quick-categories nav
  (`_header-category-nav-tab`). Shared by manually configured
  `_header-category-nav-product` blocks and by the tab's automatic
  collection preview, so the markup/styling only lives in one place.

  @param {product} [product] - Real product to auto-fill image/title/link/price/rating from.
    Any other param passed explicitly takes priority over the value derived from this product.
  @param {image} [image] - Product image
  @param {string} [title] - Product title
  @param {string} [link] - Product url
  @param {boolean} [open_in_new_tab] - Opens the link in a new tab
  @param {string} [sale_badge_text] - Small badge shown on the image, e.g. "Low stock"
  @param {boolean} [show_rating] - Whether to render the star rating row
  @param {number} [rating_value] - Rating out of 5
  @param {string} [review_count] - Review count text, e.g. "(1,234)"
  @param {image} [bullet_1_icon]
  @param {string} [bullet_1_label]
  @param {image} [bullet_2_icon]
  @param {string} [bullet_2_label]
  @param {string} [compare_price] - Formatted compare-at price
  @param {string} [price] - Formatted price
  @param {string} [save_badge_text] - Small badge shown next to the price, e.g. "Save 50%"
  @param {object} [block] - Pass the enclosing block to output shopify_attributes on the card

  @example
  {% render 'category-nav-product-card', title: product.title, link: product.url, price: price %}
  {% render 'category-nav-product-card', product: product %}
{%- enddoc -%}

{%- liquid
  assign image = image | default: product.featured_image
  assign title = title | default: product.title
  assign link = link | default: product.url

  assign product_on_sale = false
  if product.compare_at_price > product.price
    assign product_on_sale = true
  endif

  if compare_price == blank and product_on_sale
    capture compare_price
      render 'format-price', price: product.compare_at_price
    endcapture
  endif

  if price == blank and product != blank
    capture price
      render 'format-price', price: product.price
    endcapture
  endif

  if save_badge_text == blank and product_on_sale
    assign discount_percentage = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
    assign save_badge_text = 'products.product.save_percentage' | t: percentage: discount_percentage
  endif

  if show_rating == blank and product != blank
    assign rating_value = product.metafields.reviews.rating.value.rating
    assign show_rating = false
    if rating_value != blank
      assign show_rating = true
    endif
    assign review_count = review_count | default: product.metafields.reviews.rating_count
  endif

  assign rating_value = rating_value | at_most: 5 | at_least: 0
-%}

<article
  class="category-nav__product"
  {% if block %}
    {{ block.shopify_attributes }}
  {% endif %}
>
  {%- if link != blank -%}
    <a
      class="category-nav__product-media"
      href="{{ link }}"
      {% if open_in_new_tab %}
        target="_blank" rel="noopener"
      {% endif %}
    >
  {%- else -%}
    <span class="category-nav__product-media">
  {%- endif -%}

    {%- if image != blank -%}
      {{
        image
        | image_url: width: 480
        | image_tag: widths: '240, 352, 480', sizes: '240px', loading: 'lazy', alt: '', class: 'category-nav__product-image'
      }}
    {%- else -%}
      {{ 'product-apparel-1' | placeholder_svg_tag: 'category-nav__product-image' }}
    {%- endif -%}

    {%- if sale_badge_text != blank -%}
      <span class="category-nav__product-badge">{{ sale_badge_text }}</span>
    {%- endif -%}

  {%- if link != blank -%}
    </a>
  {%- else -%}
    </span>
  {%- endif -%}

  <div class="category-nav__product-body">
    {%- if show_rating -%}
      <div
        class="category-nav__product-rating"
        aria-label="{{ 'accessibility.rating' | t: rating: rating_value }}"
      >
        <div
          class="category-nav__product-stars"
          aria-hidden="true"
        >
          {%- for i in (1..5) -%}
            <span class="category-nav__star{% if i <= rating_value %} category-nav__star--filled{% endif %}">
              <svg
                class="icon-default"
                aria-hidden="true"
                focusable="false"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
              >
                {%- render 'icon', icon: 'star' -%}
              </svg>
            </span>
          {%- endfor -%}
        </div>
        {%- if review_count != blank -%}
          <span class="category-nav__product-review-count">{{ review_count }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if link != blank -%}
      <a
        class="category-nav__product-title"
        href="{{ link }}"
        {% if open_in_new_tab %}
          target="_blank" rel="noopener"
        {% endif %}
      >
        {{- title -}}
      </a>
    {%- else -%}
      <span class="category-nav__product-title">{{ title }}</span>
    {%- endif -%}

    {%- if bullet_1_label != blank or bullet_2_label != blank -%}
      <ul class="category-nav__product-bullets">
        {%- if bullet_1_label != blank -%}
          <li class="category-nav__product-bullet">
            {%- if bullet_1_icon != blank -%}
              {{
                bullet_1_icon
                | image_url: width: 28
                | image_tag: widths: '14, 28', loading: 'lazy', alt: '', class: 'category-nav__product-bullet-icon'
              }}
            {%- endif -%}
            {{- bullet_1_label -}}
          </li>
        {%- endif -%}
        {%- if bullet_2_label != blank -%}
          <li class="category-nav__product-bullet">
            {%- if bullet_2_icon != blank -%}
              {{
                bullet_2_icon
                | image_url: width: 28
                | image_tag: widths: '14, 28', loading: 'lazy', alt: '', class: 'category-nav__product-bullet-icon'
              }}
            {%- endif -%}
            {{- bullet_2_label -}}
          </li>
        {%- endif -%}
      </ul>
    {%- endif -%}

    {%- if compare_price != blank or price != blank -%}
      <div class="category-nav__product-price">
        {%- if compare_price != blank -%}
          <span class="category-nav__product-compare-price">{{ compare_price }}</span>
        {%- endif -%}
        {%- if price != blank -%}
          <span class="category-nav__product-current-price">{{ price }}</span>
        {%- endif -%}
        {%- if save_badge_text != blank -%}
          <span class="category-nav__product-save-badge">{{ save_badge_text }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</article>
